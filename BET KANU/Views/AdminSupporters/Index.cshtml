@model SupporterAdminIndexViewModel
@using BET_KANU.Models
<link rel="stylesheet" href="~/css/dashboard.css">

@{
    ViewBag.Title = "Manage Supporters";
    var publishedCount = Model.Items.Count(x => x.IsPublished);
    var hiddenCount = Model.Items.Count - publishedCount;
}

<div id="wrapper">
    <section class="bg-success promo">
        <div class="container">
            <h1 style="color:white">&nbsp;Supporters Management</h1>
        </div>
    </section>

    <section>
        <div class="container py-4">
            @if (TempData["SupporterSuccess"] is string success)
            {
                <div class="alert alert-success alert-dismissible fade show" role="status">
                    <i class="fa-solid fa-circle-check me-2" aria-hidden="true"></i>
                    @success
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
                <p class="mb-0 text-muted">
                    Manage public supporter recognition by type and year. Publishing a name makes it visible on BET KANU's website.
                </p>
                <a href="@Url.Action("Create", "AdminSupporters")" class="btn btn-Create">
                    <i class="fa-solid fa-plus me-1" aria-hidden="true"></i>
                    Add Supporter
                </a>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <div class="card sup-stat-card h-100">
                        <div class="card-body d-flex align-items-center gap-3">
                            <div class="sup-stat-icon sup-stat-blue"><i class="fa-solid fa-users" aria-hidden="true"></i></div>
                            <div>
                                <div class="sup-stat-value">@Model.Items.Count</div>
                                <div class="sup-stat-label">Results</div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card sup-stat-card h-100">
                        <div class="card-body d-flex align-items-center gap-3">
                            <div class="sup-stat-icon sup-stat-green"><i class="fa-solid fa-eye" aria-hidden="true"></i></div>
                            <div>
                                <div class="sup-stat-value">@publishedCount</div>
                                <div class="sup-stat-label">Published</div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card sup-stat-card h-100">
                        <div class="card-body d-flex align-items-center gap-3">
                            <div class="sup-stat-icon sup-stat-grey"><i class="fa-solid fa-eye-slash" aria-hidden="true"></i></div>
                            <div>
                                <div class="sup-stat-value">@hiddenCount</div>
                                <div class="sup-stat-label">Hidden</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header">
                    <h3 class="card-title mb-0"><i class="fa-solid fa-filter me-2" aria-hidden="true"></i>Filter Supporters</h3>
                </div>
                <div class="card-body">
                    <form method="get" action="@Url.Action("Index", "AdminSupporters")" class="row g-3 align-items-end">
                        <div class="col-lg-3 col-md-6">
                            <label for="q" class="form-label">Search name</label>
                            <input id="q" name="q" value="@Model.Query" placeholder="Supporter name" class="form-control" />
                        </div>
                        <div class="col-lg-2 col-md-6">
                            <label for="type" class="form-label">Support type</label>
                            <select id="type" name="type" class="form-control form-select">
                                <option value="">All types</option>
                                @foreach (var type in Enum.GetValues<SupporterType>())
                                {
                                    <option value="@((int)type)" selected="@(Model.Type == type)">@(type == SupporterType.OneTime ? "One-Time" : type.ToString())</option>
                                }
                            </select>
                        </div>
                        <div class="col-lg-2 col-md-6">
                            <label for="period" class="form-label">Period</label>
                            <select id="period" name="period" class="form-control form-select">
                                <option value="">All periods</option>
                                <option value="@((int)SupporterPeriod.Current)" selected="@(Model.Period == (int)SupporterPeriod.Current)">Current Supporters</option>
                                <option value="@((int)SupporterPeriod.Previous)" selected="@(Model.Period == (int)SupporterPeriod.Previous)">Previous Supporters</option>
                            </select>
                        </div>
                        <div class="col-lg-2 col-md-6">
                            <label for="year" class="form-label">Recognition Year</label>
                            <input id="year" name="year" value="@Model.Year" type="number" min="1900" max="2100" placeholder="All years" class="form-control" />
                        </div>
                        <div class="col-lg-1 col-md-6">
                            <label for="published" class="form-label">Published</label>
                            <select id="published" name="published" class="form-control form-select">
                                <option value="">All</option>
                                <option value="true" selected="@(Model.Published == true)">Published</option>
                                <option value="false" selected="@(Model.Published == false)">Hidden</option>
                            </select>
                        </div>
                        <div class="col-lg-2 col-md-6 d-flex gap-2">
                            <button class="btn btn-Create flex-fill" type="submit">
                                <i class="fa-solid fa-magnifying-glass me-1" aria-hidden="true"></i>
                                Filter
                            </button>
                            <a href="@Url.Action("Index", "AdminSupporters")" class="btn btn-secondary" title="Reset filters" aria-label="Reset filters">
                                <i class="fa-solid fa-rotate-left" aria-hidden="true"></i>
                            </a>
                        </div>
                    </form>
                    <p class="text-muted small mt-3 mb-0">
                        <i class="fa-solid fa-circle-info me-1" aria-hidden="true"></i>
                        @Model.Items.Count result(s). Names are public only when marked Published.
                    </p>
                </div>
            </div>

            <div class="card">
                <div class="card-body">
                    @if (Model.Items.Count == 0)
                    {
                        <div class="text-center py-5">
                            <i class="fa-solid fa-hand-holding-heart fa-3x text-muted mb-3" aria-hidden="true"></i>
                            <h2 class="h5 mb-2">No supporters found</h2>
                            <p class="text-muted mb-4">Try adjusting the filters or add a supporter.</p>
                            <a href="@Url.Action("Create", "AdminSupporters")" class="btn btn-Create">
                                <i class="fa-solid fa-plus me-1" aria-hidden="true"></i>
                                Add Supporter
                            </a>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-bordered align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th scope="col" style="color:white">Supporter Name</th>
                                        <th scope="col" style="color:white">Supporter Type</th>
                                        <th scope="col" style="color:white">Period</th>
                                        <th scope="col" style="color:white">Recognition Year</th>
                                        <th scope="col" style="color:white">Display Order</th>
                                        <th scope="col" style="color:white">Status</th>
                                        <th scope="col" style="color:white">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.Items)
                                    {
                                        var periodLabel = item.Period == (int)SupporterPeriod.Previous
                                            ? "Previous Supporters"
                                            : item.Period == (int)SupporterPeriod.Current
                                                ? "Current Supporters"
                                                : $"Period {item.Period}";
                                        var yearLabel = item.RecognitionYear > 0
                                            ? item.RecognitionYear.ToString()
                                            : "Historical (unknown)";
                                        var typeBadge = item.Type switch
                                        {
                                            SupporterType.Monthly => "bg-info",
                                            SupporterType.Yearly => "bg-primary",
                                            _ => "bg-warning text-dark"
                                        };
                                        var typeIcon = item.Type switch
                                        {
                                            SupporterType.Monthly => "fa-arrows-rotate",
                                            SupporterType.Yearly => "fa-calendar-check",
                                            _ => "fa-heart"
                                        };
                                        <tr>
                                            <td>
                                                <div class="d-flex align-items-center gap-2">
                                                    <div class="sup-avatar">@GetInitials(item.Name)</div>
                                                    <div>
                                                        <div class="fw-semibold">@item.Name</div>
                                                        @if (!string.IsNullOrWhiteSpace(item.DisplayLabel))
                                                        {
                                                            <small class="text-muted">@item.DisplayLabel</small>
                                                        }
                                                    </div>
                                                </div>
                                            </td>
                                            <td>
                                                <span class="badge @typeBadge">
                                                    <i class="fa-solid @typeIcon me-1" aria-hidden="true"></i>
                                                    @(item.Type == SupporterType.OneTime ? "One-Time" : item.Type.ToString())
                                                </span>
                                            </td>
                                            <td>@periodLabel</td>
                                            <td>@yearLabel</td>
                                            <td>@item.DisplayOrder</td>
                                            <td>
                                                @if (item.IsPublished)
                                                {
                                                    <span class="badge bg-success">Published</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">Hidden</span>
                                                }
                                            </td>
                                            <td>
                                                <div class="d-flex flex-wrap gap-1">
                                                    <a href="@Url.Action("Edit", "AdminSupporters", new { id = item.Id })" class="btn btn-sm btn-primary">
                                                        <i class="fa-solid fa-pen-to-square me-1" aria-hidden="true"></i>
                                                        Edit
                                                    </a>
                                                    <form method="post" action="@Url.Action("SetPublished", "AdminSupporters", new { id = item.Id })" class="d-inline m-0">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="published" value="@(item.IsPublished ? "false" : "true")" />
                                                        <button class="btn btn-sm @(item.IsPublished ? "btn-secondary" : "btn-success")" type="submit">
                                                            <i class="fa-solid @(item.IsPublished ? "fa-eye-slash" : "fa-eye") me-1" aria-hidden="true"></i>
                                                            @(item.IsPublished ? "Unpublish" : "Publish")
                                                        </button>
                                                    </form>
                                                    <button type="button"
                                                            class="btn btn-sm btn-danger"
                                                            data-bs-toggle="modal"
                                                            data-bs-target="#deleteSupporterModal"
                                                            data-supporter-url="@Url.Action("Delete", "AdminSupporters", new { id = item.Id })"
                                                            data-supporter-name="@item.Name"
                                                            aria-label="Delete @item.Name">
                                                        <i class="fa-solid fa-trash-can me-1" aria-hidden="true"></i>
                                                        Delete
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </section>
</div>

<div class="modal fade"
     id="deleteSupporterModal"
     tabindex="-1"
     aria-labelledby="deleteSupporterModalLabel"
     aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title fs-5" id="deleteSupporterModalLabel">Delete Supporter</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="mb-2">
                    Are you sure you want to delete
                    <strong id="deleteSupporterName"></strong>?
                </p>
                <p class="mb-0 small">
                    <i class="fa-solid fa-triangle-exclamation me-1" aria-hidden="true"></i>
                    This cannot be undone. To remove a name from the public page temporarily, use Unpublish instead.
                </p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <form id="deleteSupporterForm" method="post" action="" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">
                        <i class="fa-solid fa-trash-can me-1" aria-hidden="true"></i>
                        Delete
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@functions {
    private static string GetInitials(string value)
    {
        var words = (value ?? string.Empty).Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        if (words.Length == 0) return "?";
        return words.Length == 1
            ? char.ToUpperInvariant(words[0][0]).ToString()
            : $"{char.ToUpperInvariant(words[0][0])}{char.ToUpperInvariant(words[^1][0])}";
    }
}

<style>
    .table td {
        vertical-align: middle !important;
    }

    .sup-stat-card .card-body {
        padding: 1.1rem 1.25rem;
    }

    .sup-stat-icon {
        width: 46px;
        height: 46px;
        min-width: 46px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.15rem;
    }

    .sup-stat-blue {
        background: rgba(2, 132, 199, 0.18);
        color: #52baff;
    }

    .sup-stat-green {
        background: rgba(34, 197, 94, 0.18);
        color: #4ade80;
    }

    .sup-stat-grey {
        background: rgba(143, 152, 193, 0.18);
        color: #8f98c1;
    }

    .sup-stat-value {
        font-size: 1.5rem;
        font-weight: 700;
        line-height: 1.1;
        color: #fff;
    }

    .sup-stat-label {
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: #8f98c1;
    }

    .sup-avatar {
        width: 36px;
        height: 36px;
        min-width: 36px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.5px;
        background: #424b65;
        color: #52baff;
        border: 1px solid rgba(255, 255, 255, 0.08);
    }

    /* Modal styling for dark theme */
    #deleteSupporterModal .modal-content {
        background-color: #3e4966 !important;
        border: 1px solid rgba(255, 255, 255, 0.05) !important;
        color: #fff !important;
    }

    #deleteSupporterModal .modal-header,
    #deleteSupporterModal .modal-footer {
        border-color: rgba(255, 255, 255, 0.05) !important;
    }

    #deleteSupporterModal .modal-title,
    #deleteSupporterModal p {
        color: #fff !important;
    }

    #deleteSupporterModal .btn-close {
        filter: invert(1) !important;
    }
</style>

@section Scripts {
    <script>
        (function () {
            var modal = document.getElementById('deleteSupporterModal');
            if (!modal) {
                return;
            }

            modal.addEventListener('show.bs.modal', function (event) {
                var button = event.relatedTarget;
                if (!button) {
                    return;
                }

                document.getElementById('deleteSupporterForm').action = button.getAttribute('data-supporter-url') || '';
                document.getElementById('deleteSupporterName').textContent = button.getAttribute('data-supporter-name') || '';
            });
        })();
    </script>
}
