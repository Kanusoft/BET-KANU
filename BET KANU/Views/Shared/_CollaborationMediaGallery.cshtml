@model CollaborationMediaGalleryViewModel
@using BetKanu.Models.Common
@{
    string IconFor(CollaborationMediaType type) => type switch
    {
        CollaborationMediaType.Image => "fa-image",
        CollaborationMediaType.Video => "fa-video",
        CollaborationMediaType.Pdf => "fa-file-pdf",
        CollaborationMediaType.Document => "fa-file-word",
        _ => "fa-file"
    };

    string SizeLabel(long bytes) =>
        bytes < 1024 ? $"{bytes} B" :
        bytes < 1048576 ? $"{bytes / 1024.0:0.0} KB" :
        $"{bytes / 1048576.0:0.0} MB";

    var items = (Model.FilterType.HasValue
        ? Model.Items.Where(x => x.MediaType == Model.FilterType.Value)
        : Model.Items)
        .OrderBy(x => x.DisplayOrder)
        .ThenBy(x => x.Id)
        .ToList();
}

<div class="card mb-4">
    <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
        <h3 class="card-title mb-0">
            <i class="fa-solid fa-photo-film me-2" aria-hidden="true"></i>Photos &amp; Media
        </h3>
        @{
            string BuildFilter(int? type)
            {
                if (Model.PartnerContributorId.HasValue)
                    return Url.Action("Edit", "PartnerContributors", new { id = Model.PartnerContributorId, tab = "media", mediaType = type })!;
                if (Model.CollaborationProjectId.HasValue)
                    return Url.Action("Edit", "CollaborationProjects", new { id = Model.CollaborationProjectId, tab = "media", mediaType = type })!;
                return Model.ReturnUrl;
            }
        }
        <div class="collab-media-filters" role="group" aria-label="Media filters">
            <a class="btn @(Model.FilterType == null ? "active" : null)" href="@BuildFilter(null)">All</a>
            <a class="btn @(Model.FilterType == CollaborationMediaType.Image ? "active" : null)" href="@BuildFilter(1)">Images</a>
            <a class="btn @(Model.FilterType == CollaborationMediaType.Video ? "active" : null)" href="@BuildFilter(2)">Videos</a>
            <a class="btn @(Model.FilterType == CollaborationMediaType.Pdf ? "active" : null)" href="@BuildFilter(3)">PDFs</a>
            <a class="btn @(Model.FilterType == CollaborationMediaType.Document ? "active" : null)" href="@BuildFilter(4)">Documents</a>
            <a class="btn @(Model.FilterType == CollaborationMediaType.OtherFile ? "active" : null)" href="@BuildFilter(5)">Other</a>
        </div>
    </div>
    <div class="card-body">
        <partial name="_CollaborationMediaUpload" model="new CollaborationMediaUploadFormViewModel {
            PartnerContributorId = Model.PartnerContributorId,
            CollaborationProjectId = Model.CollaborationProjectId,
            ReturnUrl = Model.ReturnUrl,
            IsActive = true
        }" />

        @if (items.Count == 0)
        {
            <div class="collab-empty">
                <i class="fa-solid fa-folder-open fa-3x mb-3" aria-hidden="true"></i>
                <h4 class="h5 mb-2">No media files yet</h4>
                <p class="mb-0">No media files yet for @Model.ParentName.</p>
            </div>
        }
        else
        {
            <div class="collab-media-grid mt-3">
                @foreach (var item in items)
                {
                    var displayTitle = string.IsNullOrWhiteSpace(item.Title) ? item.FileName : item.Title;
                    <div class="collab-media-card">
                        <div class="collab-media-preview">
                            @if (item.MediaType == CollaborationMediaType.Image)
                            {
                                <a href="@item.FileUrl" target="_blank" rel="noopener" class="w-100 h-100 d-block">
                                    <img src="@item.FileUrl" alt="@displayTitle" />
                                </a>
                            }
                            else if (item.MediaType == CollaborationMediaType.Video)
                            {
                                <video controls preload="metadata" src="@item.FileUrl"></video>
                            }
                            else
                            {
                                <div class="collab-file-icon" style="width:72px;height:72px;font-size:28px">
                                    <i class="fa-solid @IconFor(item.MediaType)" aria-hidden="true"></i>
                                </div>
                            }
                        </div>
                        <div class="collab-media-body">
                            <div class="fw-semibold text-truncate text-white" title="@displayTitle">@displayTitle</div>
                            <div class="collab-media-meta">@item.MediaType · @SizeLabel(item.FileSizeBytes)</div>
                            @if (!string.IsNullOrWhiteSpace(item.Caption))
                            {
                                <div class="small text-muted mt-1">@item.Caption</div>
                            }
                            <div class="d-flex flex-wrap gap-1 mt-2">
                                @if (item.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactive</span>
                                }
                                <span class="badge collab-badge-order">Order @item.DisplayOrder</span>
                            </div>
                            <div class="collab-actions">
                                <a class="btn btn-sm btn-Create" href="@item.FileUrl" target="_blank" rel="noopener">
                                    <i class="fa-solid fa-arrow-up-right-from-square me-1" aria-hidden="true"></i>Open
                                </a>
                                <button type="button" class="btn btn-sm btn-primary"
                                        data-bs-toggle="modal" data-bs-target="#mediaEditModal-@item.Id">
                                    <i class="fa-solid fa-pen-to-square me-1" aria-hidden="true"></i>Edit
                                </button>
                                <form method="post" asp-controller="CollaborationMedia" asp-action="SetActive" asp-route-id="@item.Id">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="isActive" value="@(item.IsActive ? "false" : "true")" />
                                    <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                                    <button type="submit" class="btn btn-sm @(item.IsActive ? "btn-secondary" : "btn-success")">
                                        <i class="fa-solid @(item.IsActive ? "fa-eye-slash" : "fa-eye") me-1" aria-hidden="true"></i>@(item.IsActive ? "Deactivate" : "Activate")
                                    </button>
                                </form>
                                <button type="button"
                                        class="btn btn-sm btn-danger"
                                        data-bs-toggle="modal"
                                        data-bs-target="#deleteMediaModal"
                                        data-delete-url="@Url.Action("Delete", "CollaborationMedia", new { id = item.Id })"
                                        data-delete-name="@displayTitle"
                                        data-delete-return-url="@Model.ReturnUrl"
                                        aria-label="Delete @displayTitle">
                                    <i class="fa-solid fa-trash-can me-1" aria-hidden="true"></i>Delete
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>

            @foreach (var item in items)
            {
                <div class="modal fade collab-modal" id="mediaEditModal-@item.Id" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-scrollable">
                        <div class="modal-content">
                            <form method="post" asp-controller="CollaborationMedia" asp-action="Update" asp-route-id="@item.Id">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="Id" value="@item.Id" />
                                <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />
                                <div class="modal-header">
                                    <h5 class="modal-title">Edit Media</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                <div class="modal-body">
                                    <p class="small text-muted mb-3">@item.FileName</p>
                                    <div class="mb-3">
                                        <label class="form-label">Title</label>
                                        <input name="Title" class="form-control" value="@item.Title" maxlength="250" />
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label">Caption</label>
                                        <input name="Caption" class="form-control" value="@item.Caption" maxlength="1000" />
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label">Description</label>
                                        <textarea name="Description" class="form-control" rows="2">@item.Description</textarea>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label">Display Order</label>
                                        <input name="DisplayOrder" type="number" min="0" class="form-control" value="@item.DisplayOrder" />
                                    </div>
                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" role="switch" name="IsActive" value="true" id="mediaActive-@item.Id" @(item.IsActive ? "checked" : null) />
                                        <label class="form-check-label" for="mediaActive-@item.Id">Active</label>
                                        <input type="hidden" name="IsActive" value="false" />
                                    </div>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                    <button type="submit" class="btn btn-Create">
                                        <i class="fa-solid fa-floppy-disk me-1" aria-hidden="true"></i>Save Changes
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            }

            <div class="modal fade collab-modal collab-delete-modal"
                 id="deleteMediaModal"
                 tabindex="-1"
                 aria-labelledby="deleteMediaModalLabel"
                 aria-hidden="true">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h2 class="modal-title fs-5" id="deleteMediaModalLabel">Delete Media File</h2>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <p class="mb-2">
                                Are you sure you want to delete
                                <strong class="collab-delete-name"></strong>?
                            </p>
                            <p class="mb-0 small text-muted">
                                <i class="fa-solid fa-triangle-exclamation me-1" aria-hidden="true"></i>
                                This action cannot be undone.
                            </p>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                            <form method="post" action="" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                                <button type="submit" class="btn btn-danger">
                                    <i class="fa-solid fa-trash-can me-1" aria-hidden="true"></i>Delete
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
