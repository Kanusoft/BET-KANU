        const email = $('#Email').val();
        $.ajax({
            url: 'https://www.dargushti.com/api/v6/subscribe',
            type: 'post',
            data: {
                email,
            },
            headers: {
                'x-api-key': 'API_KEY_SECRET',
            },
            dataType: 'json',
            success(data) {
                if (data.result) {
                    $('#messageResult2').html('<a>Success</a>');
                } else {
                    $('#messageResult2').html('<a> </a>');
                }
            },
        });
    </script>
    <script>
        (function ($) {
            "use strict";
            var owl = $(".owl-carousel");

            owl.owlCarousel({
                items: 4, //4 items above 1000px browser width
                itemsDesktop: [1000, 3], //3 items between 1000px and 0
                itemsTablet: [600, 1], //1 items between 600 and 0
                itemsMobile: false // itemsMobile disabled - inherit from itemsTablet option
            });

            $(".next").click(function () {
                owl.trigger('owl.next');
                return false;
            })
            $(".prev").click(function () {
                owl.trigger('owl.prev');
                return false;
            })
        })(jQuery);
    </script>
    <script src="~/js/show.js"></script>

    <script>
        document.addEventListener('click', function (event) {
            var isClickInside = document.querySelector('.modal-content').contains(event.target);
            var modalElement = document.getElementById('exampleModalhi');
            var modalInstance = bootstrap.Modal.getInstance(modalElement);

            if (!isClickInside && modalInstance && modalElement.classList.contains('show')) {
                modalInstance.hide();
            }
        });
    </script>


    @RenderSection("scripts", required: false)
</body>
