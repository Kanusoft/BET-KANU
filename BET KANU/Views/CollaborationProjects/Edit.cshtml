@model CollaborationProjectFormViewModel
@using BetKanu.Models.Common
@using BetKanu.Models.ViewModels.Collaboration
<link href="~/plugins/fileuploads/css/dropify.css" rel="stylesheet" type="text/css" />
<link rel="stylesheet" href="~/css/dashboard.css">
<link rel="stylesheet" href="~/css/collaboration-admin.css" asp-append-version="true">

@{
    var isEdit = Model.Id.HasValue;
    ViewBag.Title = isEdit ? "Edit Project" : "Add Project";
    var mediaType = ViewBag.MediaType as CollaborationMediaType?;
    var returnMediaUrl = isEdit
        ? Url.Action("Edit", new { id = Model.Id, tab = "media", mediaType })
        : string.Empty;
}

<div id="wrapper" class="collab-admin">
    <section class="bg-grey-500 promo">
        <div class="container">
            <h1 style="color:white">&nbsp;@ViewBag.Title</h1>
        </div>
    </section>

    <section>
        <div class="container py-4">
            <partial name="_CollaborationMessages" />

            <nav aria-label="breadcrumb" class="collab-breadcrumb-nav mb-3">
                <ol class="breadcrumb collab-breadcrumb">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Manger")">Dashboard</a></li>
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "PartnerContributors")">Partners &amp; Contributors</a></li>
                    <li class="breadcrumb-item"><a href="@Url.Action("Edit", "PartnerContributors", new { id = Model.PartnerContributorId, tab = "projects" })">@Model.PartnerContributorName</a></li>
                    <li class="breadcrumb-item active" aria-current="page">@(isEdit ? Model.Title : "New Project")</li>
                </ol>
            </nav>

            @if (isEdit)
            {
                <ul class="nav nav-tabs collab-tab-nav mb-4" role="tablist">
                    <li class="nav-item">
                        <a class="nav-link @(Model.ActiveTab == "information" ? "active" : null)" href="@Url.Action("Edit", new { id = Model.Id, tab = "information" })">
                            <i class="fa-solid fa-circle-info" aria-hidden="true"></i>
                            <span>Information</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(Model.ActiveTab == "media" ? "active" : null)" href="@Url.Action("Edit", new { id = Model.Id, tab = "media" })">
                            <i class="fa-solid fa-photo-film" aria-hidden="true"></i>
                            <span>Photos &amp; Media</span>
                            <span class="collab-tab-count">@Model.Media.Count</span>
                        </a>
                    </li>
                </ul>
            }

            @if (!isEdit || Model.ActiveTab == "information")
            {
                <form method="post" enctype="multipart/form-data"
                      action="@(isEdit ? Url.Action("Edit", new { id = Model.Id }) : Url.Action("Create"))">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="PartnerContributorId" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row g-4">
                        <div class="col-lg-8">
                            <div class="card mb-0">
                                <div class="card-header">
                                    <h3 class="card-title mb-0">
                                        <i class="fa-solid fa-folder-open me-2" aria-hidden="true"></i>Project Details
                                    </h3>
                                </div>
                                <div class="card-body">
                                    <p class="mb-3">
                                        <span class="text-muted">Organization:</span>
                                        <strong class="text-white">@Model.PartnerContributorName</strong>
                                    </p>
                                    <div class="mb-3">
                                        <label asp-for="Title" class="form-label">Project Title *</label>
                                        <input asp-for="Title" class="form-control" maxlength="250" required />
                                        <span asp-validation-for="Title" class="text-danger"></span>
                                    </div>
                                    <div class="mb-3">
                                        <label asp-for="ShortDescription" class="form-label">Short Description</label>
                                        <textarea asp-for="ShortDescription" class="form-control" rows="3" maxlength="1000"></textarea>
                                    </div>
                                    <div class="mb-3">
                                        <label asp-for="LongDescription" class="form-label">Long Description</label>
                                        <textarea asp-for="LongDescription" class="form-control" rows="8"></textarea>
                                    </div>
                                    <div class="row g-3">
                                        <div class="col-md-6">
                                            <label asp-for="ProjectLink" class="form-label">Project Link</label>
                                            <input asp-for="ProjectLink" class="form-control" placeholder="https://..." />
                                            <span asp-validation-for="ProjectLink" class="text-danger"></span>
                                        </div>
                                        <div class="col-md-6">
                                            <label asp-for="ProjectType" class="form-label">Project Type</label>
                                            <input asp-for="ProjectType" class="form-control" maxlength="150" placeholder="e.g. App, Book, Video" />
                                        </div>
                                        <div class="col-md-6">
                                            <label asp-for="ContentSelection" class="form-label">Associated BET KANU Content</label>
                                            <select asp-for="ContentSelection" class="form-control form-select">
                                                @{
                                                    string? currentGroup = null;
                                                }
                                                @foreach (var option in Model.ContentOptions)
                                                {
                                                    if (string.IsNullOrEmpty(option.Group))
                                                    {
                                                        <option value="@option.Value" selected="@(Model.ContentSelection == option.Value)">@option.Text</option>
                                                    }
                                                    else
                                                    {
                                                        if (currentGroup != option.Group)
                                                        {
                                                            if (currentGroup != null)
                                                            {
                                                                @:</optgroup>
                                                            }
                                                            currentGroup = option.Group;
                                                            @:<optgroup label="@option.Group">
                                                        }
                                                        <option value="@option.Value" selected="@(Model.ContentSelection == option.Value)">@option.Text</option>
                                                    }
                                                }
                                                @if (currentGroup != null)
                                                {
                                                    @:</optgroup>
                                                }
                                            </select>
                                            <span asp-validation-for="ContentSelection" class="text-danger"></span>
                                        </div>
                                        <div class="col-md-3">
                                            <label asp-for="Year" class="form-label">Year</label>
                                            <input asp-for="Year" type="number" min="1900" max="2100" class="form-control" placeholder="e.g. 2026" />
                                        </div>
                                        <div class="col-md-3">
                                            <label asp-for="ContentPageId" class="form-label">Content Page Id</label>
                                            <input asp-for="ContentPageId" type="number" min="1" class="form-control" />
                                            <div class="form-text">Optional advanced association. No verified page catalog yet.</div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-4">
                            <div class="card mb-4">
                                <div class="card-header">
                                    <h3 class="card-title mb-0">
                                        <i class="fa-solid fa-image me-2" aria-hidden="true"></i>Project Logo
                                    </h3>
                                </div>
                                <div class="card-body">
                                    <input asp-for="LogoFile"
                                           id="ProjectLogoFile"
                                           type="file"
                                           class="dropify"
                                           accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
                                           data-height="190"
                                           data-show-remove="false"
                                           data-allowed-file-extensions="jpg jpeg png webp"
                                           data-default-file="@(isEdit && !string.IsNullOrWhiteSpace(Model.ExistingLogoUrl) ? Model.ExistingLogoUrl : "")" />
                                    <div class="form-text mt-2 mb-0">JPG, PNG, or WebP. Max size follows CollaborationUpload settings.</div>
                                </div>
                            </div>

                            <div class="card mb-0">
                                <div class="card-header">
                                    <h3 class="card-title mb-0">
                                        <i class="fa-solid fa-sliders me-2" aria-hidden="true"></i>Display Settings
                                    </h3>
                                </div>
                                <div class="card-body">
                                    <div class="mb-3">
                                        <label asp-for="DisplayOrder" class="form-label">Display Order</label>
                                        <input asp-for="DisplayOrder" type="number" min="0" class="form-control" />
                                        <div class="form-text">Lower values appear first.</div>
                                    </div>
                                    <div class="form-check form-switch">
                                        <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" />
                                        <label asp-for="IsActive" class="form-check-label">Active</label>
                                    </div>
                                    <div class="form-text">Controls whether this project is visible publicly.</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row g-3 justify-content-end mt-3">
                        <div class="col-sm-6 col-md-3">
                            <a class="btn btn-secondary w-100" href="@Url.Action("Edit", "PartnerContributors", new { id = Model.PartnerContributorId, tab = "projects" })">
                                Back
                            </a>
                        </div>
                        <div class="col-sm-6 col-md-3">
                            <button type="submit" class="btn btn-Create w-100">
                                <i class="fa-solid @(isEdit ? "fa-floppy-disk" : "fa-plus") me-1" aria-hidden="true"></i>
                                @(isEdit ? "Save Project" : "Create Project")
                            </button>
                        </div>
                    </div>
                </form>
            }

            @if (isEdit && Model.ActiveTab == "media")
            {
                <partial name="_CollaborationMediaGallery" model="new CollaborationMediaGalleryViewModel {
                    PartnerContributorId = null,
                    CollaborationProjectId = Model.Id,
                    ParentName = Model.Title,
                    FilterType = mediaType,
                    Items = Model.Media,
                    ReturnUrl = returnMediaUrl ?? string.Empty
                }" />
            }
        </div>
    </section>
</div>

@section Scripts {
    <script src="~/plugins/fileuploads/js/dropify.js"></script>
    <script src="~/js/collaboration-admin.js" asp-append-version="true"></script>
}
