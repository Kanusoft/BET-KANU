@model BetKanu.Models.ViewModels.PartnerDetailViewModel

@{
    ViewBag.Title = Model.Name + " - Details";
}

<div id="wrapper">
    <section class="padding-top-30 padding-bottom-30 border-bottom-1 border-grey-300 bg-grey-50">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-3 col-md-4 text-center margin-bottom-20">
                    <div class="p-3 shadow-sm" style="background: #fff; border-radius: 8px;">
                        <div class="card-img" style="max-height: 180px; display: flex; align-items: center; justify-content: center; overflow: hidden;">
                            <img src="@Model.LogoUrl" alt="@Model.Name" style="max-height: 160px; max-width: 100%; object-fit: contain;">
                        </div>
                    </div>
                </div>
                <div class="col-lg-9 col-md-8">
                    <span class="badge bg-warning text-dark padding-5 padding-x-10 mb-2" style="font-size: 13px; text-transform: uppercase;">
                        <i class="fa fa-handshake-o"></i> @Model.Category
                    </span>
                    <h2 class="margin-top-5 margin-bottom-5" style="font-weight: 700; color: #333;">@Model.Name</h2>
                    
                    @if (!string.IsNullOrWhiteSpace(Model.WebsiteUrl) && Model.WebsiteUrl != "#")
                    {
                        <div class="margin-top-15">
                            <a href="@Model.WebsiteUrl" target="_blank" rel="noopener noreferrer" class="btn btn-warning" style="font-weight: 600;">
                                <i class="fa fa-external-link"></i> Visit Official Website
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </section>

    <!-- Overview Section -->
    <section class="padding-top-40 padding-bottom-40">
        <div class="container">
            <div class="row">
                <div class="col-lg-12">
                    <div class="headline margin-bottom-20">
                        <h4><i class="fa fa-info-circle"></i> Overview</h4>
                    </div>
                    <div class="card p-4 shadow-sm" style="background: #fff; border-radius: 8px; border-left: 4px solid #ff8e2b;">
                        <p style="font-size: 16px; line-height: 1.8; color: #444; margin-bottom: 0;">@Model.Description</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Joint Works & Projects Section -->
    @if (Model.JointWorks != null && Model.JointWorks.Count > 0)
    {
        <section class="padding-top-30 padding-bottom-40 bg-grey-50">
            <div class="container">
                <div class="headline margin-bottom-30">
                    <h4><i class="fa fa-cubes"></i> Joint Works & Collaborations</h4>
                </div>
                <div class="row">
                    @foreach (var work in Model.JointWorks)
                    {
                        <div class="col-lg-6 col-md-6 margin-bottom-30">
                            <div class="card card-video h-100 shadow-sm" style="background: #fff; border-radius: 8px; overflow: hidden;">
                                <div class="card-img" style="height: 180px; overflow: hidden; background: #f9f9f9; display: flex; align-items: center; justify-content: center;">
                                    <img src="@work.ImageUrl" alt="@work.Title" style="max-height: 100%; max-width: 100%; object-fit: contain;">
                                </div>
                                <div class="caption p-4">
                                    <span class="badge bg-secondary mb-2">@work.Category</span>
                                    <h4 class="card-title" style="font-weight: 700; color: #222;">@work.Title</h4>
                                    <p style="font-size: 14px; color: #666;" class="mt-2">@work.Description</p>
                                    @if (!string.IsNullOrWhiteSpace(work.TargetUrl))
                                    {
                                        <a href="@work.TargetUrl" class="btn btn-sm btn-outline-warning mt-3">
                                            View Project <i class="fa fa-arrow-right"></i>
                                        </a>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </section>
    }

    <!-- Photos & Gallery Section -->
    @if (Model.Photos != null && Model.Photos.Count > 0)
    {
        <section class="padding-top-40 padding-bottom-40">
            <div class="container">
                <div class="headline margin-bottom-20">
                    <h4><i class="fa fa-camera"></i> Photos & Media</h4>
                </div>
                <div class="row">
                    @foreach (var photo in Model.Photos)
                    {
                        <div class="col-lg-4 col-md-6 col-sm-6 margin-bottom-20">
                            <div class="card shadow-sm p-2" style="border-radius: 8px; background: #fff;">
                                <div class="card-img" style="height: 200px; display: flex; align-items: center; justify-content: center; overflow: hidden;">
                                    <img src="@photo" alt="Gallery Photo" style="max-height: 100%; max-width: 100%; object-fit: contain; border-radius: 6px;">
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </section>
    }

    <!-- Navigation Action Footer -->
    <section class="padding-top-20 padding-bottom-40">
        <div class="container text-center">
            <a href="/about/partners" class="btn btn-warning margin-right-10 margin-bottom-10" style="font-weight: 600;">
                <i class="fa fa-users"></i> Back to Partners
            </a>
            <a href="/about/contributors" class="btn btn-outline-secondary margin-bottom-10" style="font-weight: 600;">
                <i class="fa fa-heart"></i> Back to Contributors
            </a>
        </div>
    </section>
</div>
