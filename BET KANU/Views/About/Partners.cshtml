@{
    ViewBag.Title = "Our Partners";
}

<div id="wrapper" class="partners-page" style="background-color: #f8fafc; min-height: 85vh; padding: 40px 0 60px 0;">
    <div class="container">
        <!-- Page Title Header -->
        <div class="text-center" style="margin-bottom: 30px;">
            <h2 style="font-weight: 800; color: #0b4570; font-size: 32px; letter-spacing: -0.3px; margin-bottom: 0;">
                <i class="fa fa-users" style="margin-right: 8px;"></i> OUR PARTNERS
            </h2>
        </div>

        <!-- Partners Cards Grid (3 columns on desktop) -->
        <div class="partners-modern-grid">
            <!-- 1. AJM -->
            <a href="/about/partnerdetails?id=ajm" class="partner-modern-card">
                <div class="partner-logo-box">
                    <img src="/img/partners/ajm.jpg" alt="AJM" loading="lazy" />
                </div>
                <span class="partner-card-name">AJM</span>
            </a>

            <!-- 2. CAPNI -->
            <a href="/about/partnerdetails?id=capni" class="partner-modern-card">
                <div class="partner-logo-box">
                    <img src="/img/partners/capni.jpg" alt="CAPNI" loading="lazy" />
                </div>
                <span class="partner-card-name">CAPNI</span>
            </a>

            <!-- 3. Etuti Institute -->
            <a href="/about/partnerdetails?id=etuti" class="partner-modern-card">
                <div class="partner-logo-box">
                    <img src="/img/partners/Etuti.jpg" alt="Etuti Institute" loading="lazy" />
                </div>
                <span class="partner-card-name">Etuti Institute</span>
            </a>

            <!-- 4. Naby Frye Assyrian Fund for Culture -->
            <a href="/about/partnerdetails?id=naby" class="partner-modern-card">
                <div class="partner-logo-box">
                    <img src="/img/partners/Naby.jpg" alt="Naby Frye Assyrian Fund for Culture" loading="lazy" />
                </div>
                <span class="partner-card-name">Naby Frye Assyrian Fund for Culture</span>
            </a>

            <!-- 5. SOS 1915 -->
            <a href="/about/partnerdetails?id=sos" class="partner-modern-card">
                <div class="partner-logo-box">
                    <img src="/img/partners/sos.jpg" alt="SOS 1915" loading="lazy" />
                </div>
                <span class="partner-card-name">SOS 1915</span>
            </a>

            <!-- 6. General Directorate of Syriac Culture and Arts -->
            <a href="/about/partnerdetails?id=syriac-culture" class="partner-modern-card">
                <div class="partner-logo-box">
                    <img src="/img/partners/Syriac-heritage-museum_logo-.png" alt="General Directorate of Syriac Culture and Arts" loading="lazy" />
                </div>
                <span class="partner-card-name">General Directorate of Syriac Culture and Arts</span>
            </a>

            <!-- 7. Shlama Foundation -->
            <a href="/about/partnerdetails?id=shlama" class="partner-modern-card">
                <div class="partner-logo-box">
                    <img src="/img/partners/Shlama Foundation.jpg" alt="Shlama Foundation" loading="lazy" />
                </div>
                <span class="partner-card-name">Shlama Foundation</span>
            </a>

            <!-- 8. Assyrian Foundation of America -->
            <a href="/about/partnerdetails?id=afa" class="partner-modern-card">
                <div class="partner-logo-box">
                    <img src="/img/partners/Assyrian Foundation of America.jpg" alt="Assyrian Foundation of America" loading="lazy" />
                </div>
                <span class="partner-card-name">Assyrian Foundation of America</span>
            </a>
        </div>

        <!-- Bottom CTA Section -->
        <div class="partner-cta-card-box">
            <h3 class="partner-cta-title">Help us create more in Syriac.</h3>
            <p class="partner-cta-subtitle">Join the organizations helping preserve our language and culture.</p>
            <button type="button" class="btn btn-partner-cta" data-bs-toggle="modal" data-bs-target="#partnerModal" data-toggle="modal" data-target="#partnerModal">
                Become a Partner &rarr;
            </button>
        </div>
    </div>
</div>

<partial name="_PartnerModal" />