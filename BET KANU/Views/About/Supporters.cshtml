<head>
    @{
        ViewBag.Title = "Supporters";
    }
</head>
<div id="wrapper">
    <!-- Donation Hero Banner -->
    <section class="padding-top-30 padding-bottom-20">
        <div class="container">
            <div id="donate" class="support-betkanu-block p-4 margin-bottom-10" style="background: #ffffff; border-radius: 10px; box-shadow: 0 4px 15px rgba(0,0,0,0.06); border: 1px solid #e2e8f0;">
                <div class="text-center margin-bottom-20">
                    <h3 style="font-weight: 700; color: #1e293b; margin-bottom: 5px;"><i class="fa fa-heart text-danger"></i> Support BET KANU</h3>
                    <p style="color: #64748b; font-size: 15px;">Choose your region to support our digital tools and media for the Syriac language.</p>
                </div>
                <div class="row justify-content-center">
                    <!-- United States / USD -->
                    <div class="col-md-6 col-sm-12 margin-bottom-15">
                        <div class="card p-4 h-100 text-center shadow-sm" style="border-top: 4px solid #ff8e2b; background: #f8fafc; border-radius: 8px;">
                            <h4 style="font-weight: 700; color: #0f172a;" class="mb-2">United States / USD</h4>
                            <p style="font-size: 14px; color: #475569;" class="mb-3">Donate once or become a monthly supporter.</p>
                            <a href="https://givebutter.com/fund-digital-tools-for-the-syriac-language-tgqbld" target="_blank" rel="noopener noreferrer" class="btn btn-warning btn-block btn-lg" style="font-weight: 600;">
                                Donate with Givebutter <i class="fa fa-external-link"></i>
                            </a>
                        </div>
                    </div>
                    <!-- Europe & International -->
                    <div class="col-md-6 col-sm-12 margin-bottom-15">
                        <div class="card p-4 h-100 text-center shadow-sm" style="border-top: 4px solid #52BAFF; background: #f8fafc; border-radius: 8px;">
                            <h4 style="font-weight: 700; color: #0f172a;" class="mb-2">Europe & International</h4>
                            <p style="font-size: 14px; color: #475569;" class="mb-3">Donate in EUR, SEK and other supported currencies.</p>
                            <a href="https://donorbox.org/bet-kanu-monthly-support" target="_blank" rel="noopener noreferrer" class="btn btn-info btn-block btn-lg text-white" style="font-weight: 600; color: #fff !important;">
                                Donate with Donorbox <i class="fa fa-external-link"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

