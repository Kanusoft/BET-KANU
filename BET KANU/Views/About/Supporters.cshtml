@section scripts{
    <script>
        // Tab switching logic
        function switchSupporterTab(tabName) {
            var tab2026 = document.getElementById('tabPane2026');
            var tabPrevious = document.getElementById('tabPanePrevious');
            var btn2026 = document.getElementById('tabBtn2026');
            var btnPrevious = document.getElementById('tabBtnPrevious');

            if (tabName === '2026') {
                tab2026.classList.add('active');
                tabPrevious.classList.remove('active');
                btn2026.classList.add('active');
                btnPrevious.classList.remove('active');
            } else {
                tabPrevious.classList.add('active');
                tab2026.classList.remove('active');
                btnPrevious.classList.add('active');
                btn2026.classList.remove('active');
            }

            // Re-apply current search filter to newly visible tab
            var searchInput = document.getElementById('supporterSearchInput');
            if (searchInput && searchInput.value) {
                filterSupporters(searchInput.value);
            }
        }

        // Live supporter search filter
        function filterSupporters(query) {
            var term = (query || '').toLowerCase().trim();
            var clearBtn = document.getElementById('clearSearchBtn');
            var noResultsState = document.getElementById('noResultsState');

            if (clearBtn) {
                clearBtn.style.display = term.length > 0 ? 'block' : 'none';
            }

            // Find current active pane
            var activePane = document.querySelector('.tab-pane-content.active');
            if (!activePane) return;

            var cards = activePane.querySelectorAll('.donor-item-card');
            var matchCount = 0;

            cards.forEach(function(card) {
                var name = card.getAttribute('data-name') || card.textContent.toLowerCase();
                if (term === '' || name.indexOf(term) !== -1) {
                    card.style.display = 'flex';
                    matchCount++;
                } else {
                    card.style.display = 'none';
                }
            });

            // Handle empty search feedback
            if (noResultsState) {
                if (term.length > 0 && matchCount === 0) {
                    noResultsState.style.display = 'block';
                } else {
                    noResultsState.style.display = 'none';
                }
            }
        }

        function clearSearch() {
            var searchInput = document.getElementById('supporterSearchInput');
            if (searchInput) {
                searchInput.value = '';
                filterSupporters('');
                searchInput.focus();
            }
        }
    </script>
}
