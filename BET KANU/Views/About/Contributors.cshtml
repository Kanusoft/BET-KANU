@section scripts{
    <script>
        function EnableDisableYear(year) {
            var years = ["2026", "2025", "2024", "2023", "2022", "2021", "2020", "2019", "2018", "2017"];

            years.forEach(y => {
                var element = document.getElementById(y);
                var container = document.getElementById(y + "c");

                if (y === year) {
                    element.disabled = true;
                    container.style.display = "block";
                } else {
                    element.disabled = false;
                    container.style.display = "none";
                }
            });
        }
    </script>
}