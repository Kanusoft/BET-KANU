        <!-- Page Title & Header -->
        <div class="text-center" style="margin-bottom: 25px;">
            <h2 style="font-weight: 800; color: #0b4570; font-size: 32px; letter-spacing: -0.3px; margin-bottom: 8px;">
                <i class="fa fa-users" style="margin-right: 8px;"></i> OUR CONTRIBUTORS
            </h2>
            <p style="font-size: 16px; color: #2c6e9c; font-weight: 500; margin-bottom: 0;">
                Celebrating the organizations that help bring Syriac language and culture to life.
            </p>
        </div>

        <!-- Year Tabs Filter -->
        <div class="contributor-year-nav">
            <button type="button" class="contributor-year-btn active" id="2026" onclick="EnableDisableYear('2026')" disabled>2026</button>
            <button type="button" class="contributor-year-btn" id="2025" onclick="EnableDisableYear('2025')">2025</button>
            <button type="button" class="contributor-year-btn" id="2024" onclick="EnableDisableYear('2024')">2024</button>
            <button type="button" class="contributor-year-btn" id="2023" onclick="EnableDisableYear('2023')">2023</button>
            <button type="button" class="contributor-year-btn" id="2022" onclick="EnableDisableYear('2022')">2022</button>
            <button type="button" class="contributor-year-btn" id="2021" onclick="EnableDisableYear('2021')">2021</button>
            <button type="button" class="contributor-year-btn" id="2020" onclick="EnableDisableYear('2020')">2020</button>
            <button type="button" class="contributor-year-btn" id="2019" onclick="EnableDisableYear('2019')">2019</button>
            <button type="button" class="contributor-year-btn" id="2018" onclick="EnableDisableYear('2018')">2018</button>
            <button type="button" class="contributor-year-btn" id="2017" onclick="EnableDisableYear('2017')">2017</button>
