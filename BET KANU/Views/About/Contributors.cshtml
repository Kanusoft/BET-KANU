@section scripts{
    <script>
        function EnableDisableYear(year) {
            var years = ["2026", "2025", "2024", "2023", "2022", "2021", "2020", "2019", "2018", "2017"];

            years.forEach(function(y) {
                var btn = document.getElementById(y);
                var container = document.getElementById(y + "c");

                if (y === year) {
                    if (btn) {
                        btn.classList.add("active");
                        btn.disabled = true;
                    }
                    if (container) container.style.display = "block";
                } else {
                    if (btn) {
                        btn.classList.remove("active");
                        btn.disabled = false;
                    }
                    if (container) container.style.display = "none";
                }
            });

            var titleEl = document.getElementById("activeYearTitle");
            var subtitleEl = document.getElementById("activeYearSubtitle");
            if (titleEl) titleEl.innerText = "Our " + year + " Contributors";
            if (subtitleEl) subtitleEl.innerText = "Thank you to the organizations that supported our work in " + year + ".";
        }
    </script>
}