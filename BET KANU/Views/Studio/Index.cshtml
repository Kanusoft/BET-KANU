<head>
    @{
        ViewBag.Title = "Studio";
    }


</head>
<div id="wrapper">
    <section class="bg-success promo">
        <div class="container">
            <h1 style="color:white"><i class="fa fa-microphone"></i> &nbsp;Studio</h1>
        </div>
    </section>
    <section class=" ">
        <div class="container">
            <div class="row">
                <div class="container">

                    <div class="post post-md  ">
                        <div class="row">

                            <div class="col-md-6">
                                <div class="post-header">
                                    <div class="post-title">
                                        <h4> In-house Studio For All Recordings</h4>

                                    </div>
                                </div>
                                <h4>
                                    All BET KANU audio projects (Songs, tales, and cartoons) are produced in-house with full-time staff, and countless volunteers. The Studio is equipped with professional recording equipment, sound-proof room, and musical instruments.
                                </h4>
                                <div>
                                    <a style="font-size:12px" href="https://www.youtube.com/c/betkanu" class="btn btn-danger">Our YouTube channel</a>
                                    <a style="font-size:12px" href="https://www.youtube.com/c/betkanu" class="btn btn-warning"> Cartoon Series</a>
                                    <a style="font-size:12px" href="https://www.youtube.com/c/betkanu" class="btn btn-success"> Songs</a>

                                </div>&nbsp;
                                @*<h4> See More our studio works </h4>


                                    <a href="~/studio/songs" class="btn btn-success btn-block">Songs</a>
                                    <a href="~/studio/cartoonseries" class="btn btn-danger btn-block">Cartoon Series</a>*@


                            </div>
                            <div class="col-md-6">
                                <div class="post-thumbnail">
                                    <a href="#"><img src="/img/ourcenter/4.jpg" alt=""></a>
                                    @*<div class="category"><span class="label label-info">Creative Room</span></div>*@
                                </div>
                            </div>
                        </div>
                    </div>


                </div>
            </div>
        </div>
        <div class="container">
            <div class="row">
                <div class="col-md-8 padding-right-20">
                    <!-- New Iraq Studio Announcement Panel -->
                    <div class="panel panel-default panel-post">
                        <div class="panel-body">
                            <div class="post">
                                <div class="post-header post-author">
                                    <h2 class="author" data-toggle="tooltip" style="background-color: #5cb85c; color: white;"><i class="fa fa-microphone"></i></h2>
                                    <div class="post-title">
                                        <h3>BET KANU Opens Its First Recording Studio & Office in Iraq</h3>
                                    </div>
                                </div>

                                <!-- One Big Image -->
                                <div class="embed-responsive embed-responsive-16by9 post-thumbnail" style="margin-bottom: 20px;">
                                    <img src="/img/Studio/new_studio_1.jpg" alt="BET KANU Iraq Studio Workspace" style="width: 100%; border-radius: 4px;">
                                </div>

                                <!-- Text Description -->
                                <div style="font-size: 15px; line-height: 1.7; color: #555; margin-bottom: 0;">
                                    <p style="font-size: 16px; font-weight: 500; color: #2c3e50; text-align: justify;">
                                        We’re proud to announce a major milestone for BET KANU with the opening of our very first recording studio and office in Nuhadra (Duhok), Iraq.
                                    </p>
                                    <p style="text-align: justify;">
                                        This exciting achievement was made possible through the generous support of the <strong>Assyrian Foundation of America (AFA)</strong> and <strong>Assyrians Without Borders (AWB)</strong>. Our new space enables us to work even more closely with local educators, native speakers, and the community to expand our Eastern Syriac educational content and create high-quality resources for children and families.
                                    </p>
                                    <p style="text-align: justify;">
                                        This investment marks an important step in BET KANU’s continued growth and long-term sustainability, strengthening our mission to preserve, promote, and celebrate the Syriac language for future generations.
                                    </p>
                                    <p style="font-style: italic; border-left: 3px solid #5cb85c; padding-left: 15px; margin-top: 15px; margin-bottom: 0; color: #333; text-align: justify;">
                                        We extend our sincere gratitude to AFA and AWB for believing in our vision and making this milestone possible.
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Custom CSS Hover Animation -->
                    <style>
                        .hover-zoom:hover {
                            transform: scale(1.05);
                        }
                    </style>

                    <div class="panel panel-default panel-post">
                        <div class="panel-body">
                            <div class="post">
                                <div class="post-header post-author">
                                    <h2 class="author" data-toggle="tooltip"><i class="fa fa-music"></i></h2>
                                    <div class="post-title">
                                        <h3>Choir - Qamishli</h3>

                                    </div>
                                </div>

                                <div class="embed-responsive embed-responsive-16by9 post-thumbnail">
                                    <img src="/img/Studio/2.jpg" alt="">
                                </div>
                                <h4>
                                    Children and volunteers record songs in Eastern and Western Syriac dialects
                                </h4>
                            </div>
                        </div>

                    </div>
                    <div class="panel panel-default panel-post">
                        <div class="panel-body">
                            <div class="post">
                                <div class="post-header post-author">
                                    <h2 class="author" data-toggle="tooltip"><i class="fa fa-music"></i></h2>
                                    <div class="post-title">
                                        <h3>Suboro TV team</h3>

                                    </div>
                                </div>

                                <div class="embed-responsive embed-responsive-16by9 post-thumbnail">
                                    <img src="/img/Studio/3.jpg" alt="">
                                </div>
                                <h4>
                                    We give back to the community by offering our studio services to all local initiatives concerned with our language and culture
                                </h4>
                            </div>
                        </div>

                    </div>
                    <div class="panel panel-default panel-post">
                        <div class="panel-body">
                            <div class="post">
                                <div class="post-header post-author">
                                    <h2 class="author" data-toggle="tooltip"><i class="fa fa-music"></i></h2>
                                    <div class="post-title">
                                        <h3>The college family of Mar Afram the Syrian</h3>

                                    </div>
                                </div>

                                <div class="embed-responsive embed-responsive-16by9 post-thumbnail">
                                    <img src="/img/Studio/5.jpg" alt="">
                                </div>
                                <h4>
                                    We build strong bridges with local talented youth groups whenever possible.
                                </h4>
                            </div>
                        </div>

                    </div>





                    @*<div class="text-center"><a href="#" class="btn btn-primary btn-lg btn-shadow btn-rounded btn-icon-right">Load Posts</a></div>*@
                </div>

                <div class="col-md-4 padding-left-20">


                    <div class="widget widget-card">
                        <div class="title">Studio Gallery</div>
                        <div class="card" style="margin-bottom: 20px; border: none; box-shadow: none;">
                            <div class="card-img" style="overflow: hidden; border-radius: 4px; box-shadow: 0 2px 8px rgba(0,0,0,0.15);">
                                <img src="/img/Studio/new_studio_2.jpg" alt="Recording Studio Equipment" class="img-responsive hover-zoom" style="transition: transform 0.3s ease; width: 100%;">
                            </div>
                        </div>
                        <div class="card" style="margin-bottom: 20px; border: none; box-shadow: none;">
                            <div class="card-img" style="overflow: hidden; border-radius: 4px; box-shadow: 0 2px 8px rgba(0,0,0,0.15);">
                                <img src="/img/Studio/new_studio_3.jpg" alt="Audio & Headphones" class="img-responsive hover-zoom" style="transition: transform 0.3s ease; width: 100%;">
                            </div>
                        </div>
                        <div class="card" style="margin-bottom: 20px; border: none; box-shadow: none;">
                            <div class="card-img" style="overflow: hidden; border-radius: 4px; box-shadow: 0 2px 8px rgba(0,0,0,0.15);">
                                <img src="/img/Studio/new_studio_4.jpg" alt="BET KANU Studio Setup" class="img-responsive hover-zoom" style="transition: transform 0.3s ease; width: 100%;">
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </section>
</div>
