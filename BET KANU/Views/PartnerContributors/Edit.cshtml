@model PartnerContributorFormViewModel
@using BetKanu.Models.Common
@using BetKanu.Models.ViewModels.Collaboration
<link href="~/plugins/fileuploads/css/dropify.css" rel="stylesheet" type="text/css" />
<link rel="stylesheet" href="~/css/dashboard.css">
<link rel="stylesheet" href="~/css/collaboration-admin.css" asp-append-version="true">

@{
    var isEdit = Model.Id.HasValue;
    ViewBag.Title = isEdit ? "Edit Organization" : "Add Organization";
    var mediaType = ViewBag.MediaType as CollaborationMediaType?;
    var returnMediaUrl = isEdit
        ? Url.Action("Edit", new { id = Model.Id, tab = "media", mediaType })
        : string.Empty;
}

<div id="wrapper" class="collab-admin">
    <section class="bg-grey-500 promo">
        <div class="container">
            <h1 style="color:white">&nbsp;@ViewBag.Title</h1>
        </div>
    </section>
     
    <section>
        <div class="container py-4">
            <partial name="_CollaborationMessages" />

            <nav aria-label="breadcrumb" class="collab-breadcrumb-nav mb-3">
                <ol class="breadcrumb collab-breadcrumb">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Manger")">Dashboard</a></li>
                    <li class="breadcrumb-item"><a href="@Url.Action("Index")">Partners &amp; Contributors</a></li>
                    <li class="breadcrumb-item active" aria-current="page">@(isEdit ? Model.Name : "Create")</li>
                </ol>
            </nav>

            @if (isEdit)
            {
                <div class="collab-tab-header">
                    <ul class="nav nav-tabs collab-tab-nav" role="tablist">
                        <li class="nav-item">
                            <a class="nav-link @(Model.ActiveTab == "information" ? "active" : null)" href="@Url.Action("Edit", new { id = Model.Id, tab = "information" })">
                                <i class="fa-solid fa-circle-info" aria-hidden="true"></i>
                                <span>Information</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(Model.ActiveTab == "projects" ? "active" : null)" href="@Url.Action("Edit", new { id = Model.Id, tab = "projects" })">
                                <i class="fa-solid fa-folder-open" aria-hidden="true"></i>
                                <span>Collaboration Projects</span>
                                <span class="collab-tab-count">@Model.Projects.Count</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(Model.ActiveTab == "media" ? "active" : null)" href="@Url.Action("Edit", new { id = Model.Id, tab = "media" })">
                                <i class="fa-solid fa-photo-film" aria-hidden="true"></i>
                                <span>Photos &amp; Media</span>
                                <span class="collab-tab-count">@Model.Media.Count</span>
                            </a>
                        </li>
                    </ul>
                    <a class="btn btn-sm btn-info collab-tab-preview-btn" href="@Url.Action("Details", new { id = Model.Id })">
                        <i class="fa-solid fa-eye me-1" aria-hidden="true"></i>Preview
                    </a>
                </div>
            }

            @if (!isEdit || Model.ActiveTab == "information")
            {
                <form method="post" enctype="multipart/form-data"
                      action="@(isEdit ? Url.Action("Edit", new { id = Model.Id }) : Url.Action("Create"))">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row g-4">
                        <div class="col-lg-8">
                            <div class="card mb-4">
                                <div class="card-header">
                                    <h3 class="card-title mb-0">
                                        <i class="fa-solid fa-building me-2" aria-hidden="true"></i>Basic Information
                                    </h3>
                                </div>
                                <div class="card-body">
                                    <div class="mb-3">
                                        <label asp-for="Name" class="form-label">Organization Name *</label>
                                        <input asp-for="Name" class="form-control" maxlength="200" required />
                                        <span asp-validation-for="Name" class="text-danger"></span>
                                    </div>
                                    <div class="mb-3">
                                        <label asp-for="ShortDescription" class="form-label">Short Description</label>
                                        <textarea asp-for="ShortDescription" class="form-control" rows="3" maxlength="1000"></textarea>
                                    </div>
                                    <div class="mb-3">
                                        <label asp-for="LongDescription" class="form-label">Long Description</label>
                                        <textarea asp-for="LongDescription" class="form-control" rows="8"></textarea>
                                    </div>
                                    <div class="mb-0">
                                        <label asp-for="WebsiteUrl" class="form-label">Website URL</label>
                                        <input asp-for="WebsiteUrl" class="form-control" placeholder="https://..." />
                                        <span asp-validation-for="WebsiteUrl" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>

                            <div class="card mb-4 mb-lg-0">
                                <div class="card-header">
                                    <h3 class="card-title mb-0">
                                        <i class="fa-solid fa-tags me-2" aria-hidden="true"></i>Classification
                                    </h3>
                                </div>
                                <div class="card-body">
                                    <div class="row g-3">
                                        <div class="col-md-4">
                                            <label asp-for="Category" class="form-label">Category *</label>
                                            <select asp-for="Category" class="form-control form-select" id="Category">
                                                <option value="1">Partner</option>
                                                <option value="2">Contributor</option>
                                                <option value="3">Both</option>
                                            </select>
                                        </div>
                                        <div class="col-md-4">
                                            <label asp-for="PartnerType" class="form-label">Partner Type</label>
                                            <input asp-for="PartnerType" class="form-control" maxlength="150" placeholder="e.g. Foundation, Museum" />
                                        </div>
                                        <div class="col-md-4">
                                            <label asp-for="Year" class="form-label">Year</label>
                                            <input asp-for="Year" type="number" min="1900" max="2100" class="form-control" placeholder="e.g. 2026" />
                                            <span asp-validation-for="Year" class="text-danger"></span>
                                            <div id="yearHelp" class="form-text">Especially relevant for Contributors.</div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-4">
                            <div class="card mb-4">
                                <div class="card-header">
                                    <h3 class="card-title mb-0">
                                        <i class="fa-solid fa-image me-2" aria-hidden="true"></i>Logo
                                    </h3>
                                </div>
                                <div class="card-body">
                                    <input asp-for="LogoFile"
                                           id="LogoFile"
                                           type="file"
                                           class="dropify"
                                           accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
                                           data-height="190"
                                           data-show-remove="false"
                                           data-allowed-file-extensions="jpg jpeg png webp"
                                           data-default-file="@(isEdit && !string.IsNullOrWhiteSpace(Model.ExistingLogoUrl) ? Model.ExistingLogoUrl : "")" />
                                    <div class="form-text mt-2 mb-0">JPG, PNG, or WebP. Max size follows CollaborationUpload settings.</div>
                                </div>
                            </div>

                            <div class="card mb-0">
                                <div class="card-header">
                                    <h3 class="card-title mb-0">
                                        <i class="fa-solid fa-sliders me-2" aria-hidden="true"></i>Display Settings
                                    </h3>
                                </div>
                                <div class="card-body">
                                    <div class="mb-3">
                                        <label asp-for="DisplayOrder" class="form-label">Display Order</label>
                                        <input asp-for="DisplayOrder" type="number" min="0" class="form-control" />
                                        <div class="form-text">Lower values appear first.</div>
                                    </div>
                                    <div class="form-check form-switch">
                                        <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" />
                                        <label asp-for="IsActive" class="form-check-label">Active</label>
                                    </div>
                                    <div class="form-text">Controls whether this organization is visible on public pages.</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row g-3 justify-content-end mt-3">
                        <div class="col-sm-6 col-md-3">
                            <a class="btn btn-secondary w-100" href="@Url.Action("Index")">
                                Cancel
                            </a>
                        </div>
                        <div class="col-sm-6 col-md-3">
                            <button type="submit" class="btn btn-Create w-100">
                                <i class="fa-solid @(isEdit ? "fa-floppy-disk" : "fa-plus") me-1" aria-hidden="true"></i>
                                @(isEdit ? "Save Changes" : "Create Organization")
                            </button>
                        </div>
                    </div>
                </form>
            }

            @if (isEdit && Model.ActiveTab == "projects")
            {
                <div class="card mb-4">
                    <div class="card-header d-flex justify-content-between align-items-center gap-2">
                        <h3 class="card-title mb-0">
                            <i class="fa-solid fa-folder-open me-2" aria-hidden="true"></i>Collaboration Projects
                        </h3>
                        <a class="btn btn-Create btn-sm" href="@Url.Action("Create", "CollaborationProjects", new { partnerId = Model.Id })">
                            <i class="fa-solid fa-plus me-1" aria-hidden="true"></i>Add Project
                        </a>
                    </div>
                    <div class="card-body">
                        @if (Model.Projects.Count == 0)
                        {
                            <div class="collab-empty">
                                <i class="fa-solid fa-folder-open fa-3x mb-3" aria-hidden="true"></i>
                                <h4 class="h5 mb-2">No projects yet</h4>
                                <p class="mb-4">No projects yet for this organization.</p>
                                <a class="btn btn-Create" href="@Url.Action("Create", "CollaborationProjects", new { partnerId = Model.Id })">
                                    <i class="fa-solid fa-plus me-1" aria-hidden="true"></i>Add Project
                                </a>
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-striped table-bordered align-middle mb-0">
                                    <thead>
                                        <tr>
                                            <th scope="col" style="color:white">Logo</th>
                                            <th scope="col" style="color:white">Title</th>
                                            <th scope="col" style="color:white">Type</th>
                                            <th scope="col" style="color:white">Year</th>
                                            <th scope="col" style="color:white">Status</th>
                                            <th scope="col" style="color:white">Order</th>
                                            <th scope="col" style="color:white">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var project in Model.Projects)
                                        {
                                            <tr>
                                                <td>
                                                    @if (!string.IsNullOrWhiteSpace(project.LogoUrl))
                                                    {
                                                        <img src="@project.LogoUrl" alt="@project.Title" class="collab-thumb" />
                                                    }
                                                    else
                                                    {
                                                        <div class="collab-logo-placeholder" aria-hidden="true">
                                                            <i class="fa-solid fa-folder"></i>
                                                        </div>
                                                    }
                                                </td>
                                                <td><div class="fw-semibold">@project.Title</div></td>
                                                <td>@(project.ProjectType ?? "—")</td>
                                                <td>@(project.Year?.ToString() ?? "—")</td>
                                                <td>
                                                    @if (project.IsActive)
                                                    {
                                                        <span class="badge bg-success">Active</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-secondary">Inactive</span>
                                                    }
                                                </td>
                                                <td>@project.DisplayOrder</td>
                                                <td>
                                                    <div class="collab-actions">
                                                        <a class="btn btn-sm btn-primary" href="@Url.Action("Edit", "CollaborationProjects", new { id = project.Id })">
                                                            <i class="fa-solid fa-pen-to-square me-1" aria-hidden="true"></i>Edit
                                                        </a>
                                                        <a class="btn btn-sm btn-info" href="@Url.Action("Edit", "CollaborationProjects", new { id = project.Id, tab = "media" })">
                                                            <i class="fa-solid fa-photo-film me-1" aria-hidden="true"></i>Media (@project.MediaCount)
                                                        </a>
                                                        <form method="post" asp-controller="CollaborationProjects" asp-action="SetActive" asp-route-id="@project.Id">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="isActive" value="@(project.IsActive ? "false" : "true")" />
                                                            <input type="hidden" name="returnUrl" value="@Url.Action("Edit", new { id = Model.Id, tab = "projects" })" />
                                                            <button type="submit" class="btn btn-sm @(project.IsActive ? "btn-secondary" : "btn-success")">
                                                                <i class="fa-solid @(project.IsActive ? "fa-eye-slash" : "fa-eye") me-1" aria-hidden="true"></i>@(project.IsActive ? "Deactivate" : "Activate")
                                                            </button>
                                                        </form>
                                                        <button type="button"
                                                                class="btn btn-sm btn-danger"
                                                                data-bs-toggle="modal"
                                                                data-bs-target="#deleteProjectModal"
                                                                data-delete-url="@Url.Action("Delete", "CollaborationProjects", new { id = project.Id })"
                                                                data-delete-name="@project.Title"
                                                                aria-label="Delete @project.Title">
                                                            <i class="fa-solid fa-trash-can me-1" aria-hidden="true"></i>Delete
                                                        </button>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>

                <div class="modal fade collab-modal collab-delete-modal"
                     id="deleteProjectModal"
                     tabindex="-1"
                     aria-labelledby="deleteProjectModalLabel"
                     aria-hidden="true">
                    <div class="modal-dialog">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h2 class="modal-title fs-5" id="deleteProjectModalLabel">Delete Project</h2>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body">
                                <p class="mb-2">
                                    Are you sure you want to delete
                                    <strong class="collab-delete-name"></strong>?
                                </p>
                                <p class="mb-0 small text-muted">
                                    <i class="fa-solid fa-triangle-exclamation me-1" aria-hidden="true"></i>
                                    Deletion is blocked if media files still exist for this project.
                                </p>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                <form method="post" action="" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="returnUrl" value="@Url.Action("Edit", new { id = Model.Id, tab = "projects" })" />
                                    <button type="submit" class="btn btn-danger">
                                        <i class="fa-solid fa-trash-can me-1" aria-hidden="true"></i>Delete
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }

            @if (isEdit && Model.ActiveTab == "media")
            {
                <partial name="_CollaborationMediaGallery" model="new CollaborationMediaGalleryViewModel {
                    PartnerContributorId = Model.Id,
                    CollaborationProjectId = null,
                    ParentName = Model.Name,
                    FilterType = mediaType,
                    Items = Model.Media,
                    ReturnUrl = returnMediaUrl ?? string.Empty
                }" />
            }
        </div>
    </section>
</div>

@section Scripts {
    <script src="~/plugins/fileuploads/js/dropify.js"></script>
    <script src="~/js/collaboration-admin.js" asp-append-version="true"></script>
}
