@model PartnerContributorFormViewModel
@using BetKanu.Models.Common
@using BetKanu.Models.ViewModels.Collaboration
<link rel="stylesheet" href="~/css/dashboard.css">
<link rel="stylesheet" href="~/css/collaboration-admin.css">

@{
    var isEdit = Model.Id.HasValue;
    ViewBag.Title = isEdit ? "Edit Organization" : "Add Organization";
    var mediaType = ViewBag.MediaType as CollaborationMediaType?;
    var returnMediaUrl = isEdit
        ? Url.Action("Edit", new { id = Model.Id, tab = "media", mediaType })
        : string.Empty;
}

<div id="wrapper">
    <section class="bg-grey-500 promo">
        <div class="container">
            <h1 style="color:white">&nbsp;@ViewBag.Title</h1>
        </div>
    </section>

    <section>
        <div class="container py-4">
            <partial name="_CollaborationMessages" />

            <nav aria-label="breadcrumb" class="mb-3">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Manger")">Dashboard</a></li>
                    <li class="breadcrumb-item"><a href="@Url.Action("Index")">Partners &amp; Contributors</a></li>
                    <li class="breadcrumb-item active" aria-current="page">@(isEdit ? Model.Name : "Create")</li>
                </ol>
            </nav>

            @if (isEdit)
            {
                <ul class="nav nav-tabs collab-tab-nav mb-4">
                    <li class="nav-item">
                        <a class="nav-link @(Model.ActiveTab == "information" ? "active" : null)" href="@Url.Action("Edit", new { id = Model.Id, tab = "information" })">Information</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(Model.ActiveTab == "projects" ? "active" : null)" href="@Url.Action("Edit", new { id = Model.Id, tab = "projects" })">Collaboration Projects</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(Model.ActiveTab == "media" ? "active" : null)" href="@Url.Action("Edit", new { id = Model.Id, tab = "media" })">Photos &amp; Media</a>
                    </li>
                </ul>
            }

            @if (!isEdit || Model.ActiveTab == "information")
            {
                <form method="post" enctype="multipart/form-data"
                      action="@(isEdit ? Url.Action("Edit", new { id = Model.Id }) : Url.Action("Create"))">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row g-4">
                        <div class="col-lg-8">
                            <div class="card mb-4">
                                <div class="card-header"><h3 class="card-title mb-0">Basic Information</h3></div>
                                <div class="card-body">
                                    <div class="mb-3">
                                        <label asp-for="Name" class="form-label">Organization Name *</label>
                                        <input asp-for="Name" class="form-control" maxlength="200" required />
                                        <span asp-validation-for="Name" class="text-danger"></span>
                                    </div>
                                    <div class="mb-3">
                                        <label asp-for="ShortDescription" class="form-label">Short Description</label>
                                        <textarea asp-for="ShortDescription" class="form-control" rows="3" maxlength="1000"></textarea>
                                    </div>
                                    <div class="mb-3">
                                        <label asp-for="LongDescription" class="form-label">Long Description</label>
                                        <textarea asp-for="LongDescription" class="form-control" rows="8"></textarea>
                                    </div>
                                    <div class="mb-0">
                                        <label asp-for="WebsiteUrl" class="form-label">Website URL</label>
                                        <input asp-for="WebsiteUrl" class="form-control" placeholder="https://..." />
                                        <span asp-validation-for="WebsiteUrl" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>

                            <div class="card mb-4">
                                <div class="card-header"><h3 class="card-title mb-0">Classification</h3></div>
                                <div class="card-body row g-3">
                                    <div class="col-md-4">
                                        <label asp-for="Category" class="form-label">Category *</label>
                                        <select asp-for="Category" class="form-select" id="Category">
                                            <option value="1">Partner</option>
                                            <option value="2">Contributor</option>
                                            <option value="3">Both</option>
                                        </select>
                                    </div>
                                    <div class="col-md-4">
                                        <label asp-for="PartnerType" class="form-label">Partner Type</label>
                                        <input asp-for="PartnerType" class="form-control" maxlength="150" placeholder="e.g. Foundation, Museum" />
                                    </div>
                                    <div class="col-md-4">
                                        <label asp-for="Year" class="form-label">Year</label>
                                        <input asp-for="Year" type="number" min="1900" max="2100" class="form-control" />
                                        <span asp-validation-for="Year" class="text-danger"></span>
                                        <small id="yearHelp" class="text-muted">Especially relevant for Contributors.</small>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-4">
                            <div class="card mb-4">
                                <div class="card-header"><h3 class="card-title mb-0">Logo</h3></div>
                                <div class="card-body text-center">
                                    @if (!string.IsNullOrWhiteSpace(Model.ExistingLogoUrl))
                                    {
                                        <img id="logoPreview" src="@Model.ExistingLogoUrl" alt="Current logo" class="collab-thumb-lg mb-3" />
                                    }
                                    else
                                    {
                                        <img id="logoPreview" src="" alt="" class="collab-thumb-lg mb-3 d-none" />
                                        <div class="collab-logo-placeholder mx-auto mb-3" style="width:120px;height:120px"><i class="fa-solid fa-image fa-2x"></i></div>
                                    }
                                    <input asp-for="LogoFile" id="LogoFile" type="file" class="form-control" accept=".jpg,.jpeg,.png,.webp" />
                                    <p class="small text-muted mt-2 mb-0">JPG, PNG, or WebP. Max size follows CollaborationUpload settings.</p>
                                </div>
                            </div>

                            <div class="card mb-4">
                                <div class="card-header"><h3 class="card-title mb-0">Display Settings</h3></div>
                                <div class="card-body">
                                    <div class="mb-3">
                                        <label asp-for="DisplayOrder" class="form-label">Display Order</label>
                                        <input asp-for="DisplayOrder" type="number" min="0" class="form-control" />
                                    </div>
                                    <div class="form-check">
                                        <input asp-for="IsActive" class="form-check-input" />
                                        <label asp-for="IsActive" class="form-check-label">Active</label>
                                    </div>
                                </div>
                            </div>

                            <div class="d-flex gap-2">
                                <button type="submit" class="btn btn-Create">@(isEdit ? "Save Changes" : "Create Organization")</button>
                                <a class="btn btn-outline-secondary" href="@Url.Action("Index")">Cancel</a>
                            </div>
                        </div>
                    </div>
                </form>
            }

            @if (isEdit && Model.ActiveTab == "projects")
            {
                <div class="card mb-4">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h3 class="card-title mb-0">Collaboration Projects</h3>
                        <a class="btn btn-Create btn-sm" href="@Url.Action("Create", "CollaborationProjects", new { partnerId = Model.Id })">
                            <i class="fa-solid fa-plus me-1"></i>Add Project
                        </a>
                    </div>
                    <div class="card-body">
                        @if (Model.Projects.Count == 0)
                        {
                            <div class="collab-empty">
                                <p class="mb-3">No projects yet for this organization.</p>
                                <a class="btn btn-Create" href="@Url.Action("Create", "CollaborationProjects", new { partnerId = Model.Id })">Add Project</a>
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-striped table-bordered align-middle mb-0">
                                    <thead>
                                        <tr>
                                            <th style="color:white">Logo</th>
                                            <th style="color:white">Title</th>
                                            <th style="color:white">Type</th>
                                            <th style="color:white">Year</th>
                                            <th style="color:white">Status</th>
                                            <th style="color:white">Order</th>
                                            <th style="color:white">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var project in Model.Projects)
                                        {
                                            <tr>
                                                <td>
                                                    @if (!string.IsNullOrWhiteSpace(project.LogoUrl))
                                                    {
                                                        <img src="@project.LogoUrl" alt="" class="collab-thumb" />
                                                    }
                                                    else
                                                    {
                                                        <div class="collab-logo-placeholder"><i class="fa-solid fa-folder"></i></div>
                                                    }
                                                </td>
                                                <td>@project.Title</td>
                                                <td>@(project.ProjectType ?? "—")</td>
                                                <td>@(project.Year?.ToString() ?? "—")</td>
                                                <td>
                                                    @if (project.IsActive)
                                                    {
                                                        <span class="badge bg-success">Active</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-secondary">Inactive</span>
                                                    }
                                                </td>
                                                <td>@project.DisplayOrder</td>
                                                <td>
                                                    <div class="collab-actions">
                                                        <a class="btn btn-sm btn-outline-primary" href="@Url.Action("Edit", "CollaborationProjects", new { id = project.Id })">Edit</a>
                                                        <form method="post" asp-controller="CollaborationProjects" asp-action="SetActive" asp-route-id="@project.Id">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="isActive" value="@(project.IsActive ? "false" : "true")" />
                                                            <input type="hidden" name="returnUrl" value="@Url.Action("Edit", new { id = Model.Id, tab = "projects" })" />
                                                            <button type="submit" class="btn btn-sm btn-outline-secondary">@(project.IsActive ? "Deactivate" : "Activate")</button>
                                                        </form>
                                                        <form method="post" asp-controller="CollaborationProjects" asp-action="Delete" asp-route-id="@project.Id"
                                                              onsubmit="return confirm('Delete this project? Blocked if media still exists.');">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="returnUrl" value="@Url.Action("Edit", new { id = Model.Id, tab = "projects" })" />
                                                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                                        </form>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            }

            @if (isEdit && Model.ActiveTab == "media")
            {
                <partial name="_CollaborationMediaGallery" model="new CollaborationMediaGalleryViewModel {
                    PartnerContributorId = Model.Id,
                    CollaborationProjectId = null,
                    ParentName = Model.Name,
                    FilterType = mediaType,
                    Items = Model.Media,
                    ReturnUrl = returnMediaUrl ?? string.Empty
                }" />
            }
        </div>
    </section>
</div>

<script src="~/js/collaboration-admin.js" asp-append-version="true"></script>
