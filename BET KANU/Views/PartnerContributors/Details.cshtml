@model PartnerContributorDetailsViewModel
@using BetKanu.Models.Common
@using BetKanu.Models.DTOs.Collaboration
<link rel="stylesheet" href="~/css/collaboration-admin.css" asp-append-version="true">

@{
    var item = Model.Item;
    ViewBag.Title = $"Preview — {item.Name}";

    var categoryLabel = item.Category switch
    {
        CollaborationCategory.Partner => "Partner",
        CollaborationCategory.Contributor => "Contributor",
        CollaborationCategory.Both => "Partner & Contributor",
        _ => item.Category.ToString()
    };

    var overviewText = !string.IsNullOrWhiteSpace(item.LongDescription)
        ? item.LongDescription
        : item.ShortDescription;

    var activeProjects = (item.Projects ?? Array.Empty<CollaborationProjectListDto>())
        .Where(p => p.IsActive)
        .ToList();

    var activeOrgMedia = (item.Media ?? Array.Empty<CollaborationMediaDto>())
        .Where(m => m.IsActive)
        .ToList();

    var orgMediaColClass = "col-lg-3 col-md-6 col-sm-6";
}

<div id="wrapper" class="collab-preview">
    <!-- Admin Preview Header Bar (matches MagazineManager/PreviewArticle.cshtml) -->
    <section class="bg-grey-500 promo collab-preview-bar">
        <div class="container d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <h1 style="color:white" class="mb-1">
                    Organization Preview
                </h1>
                <div style="color:white; font-size: 1.02rem;">
                    @item.Name
                </div>
                <div class="mt-2 d-flex flex-wrap align-items-center gap-2">
                    @if (item.IsActive)
                    {
                        <span class="badge bg-success">Active (Visible on Public Site)</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Inactive (Hidden from Public Site)</span>
                    }
                </div>
            </div>

            <div class="d-flex flex-wrap align-items-center gap-2">
                <a href="@Url.Action("Index")" class="btn btn-light">
                    <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
                    Back to List
                </a>
                <a href="@Url.Action("Edit", new { id = item.Id })" class="btn btn-primary">
                    <i class="fa-solid fa-pen-to-square" aria-hidden="true"></i>
                    Edit Organization
                </a>
                <form method="post" asp-action="SetActive" asp-route-id="@item.Id" class="d-inline m-0">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="isActive" value="@(item.IsActive ? "false" : "true")" />
                    <input type="hidden" name="returnUrl" value="@Url.Action("Details", new { id = item.Id })" />
                    <button type="submit" class="btn @(item.IsActive ? "btn-warning text-dark" : "btn-success")">
                        <i class="fa-solid @(item.IsActive ? "fa-eye-slash" : "fa-check")" aria-hidden="true"></i>
                        @(item.IsActive ? "Deactivate" : "Publish / Activate")
                    </button>
                </form>
            </div>
        </div>
    </section>

    <!-- Frontend Preview Body (mirrors BET KANU Partners, Contributors & PartnerDetails frontend) -->
    <div class="collab-preview-body">
        <div class="container">
            <partial name="_CollaborationMessages" />

            <!-- Organization Hero Card -->
            <div class="collab-preview-hero">
                <div class="row align-items-start g-4">
                    <div class="col-lg-3 col-md-4">
                        <div class="collab-preview-logo-frame">
                            @if (!string.IsNullOrWhiteSpace(item.LogoUrl))
                            {
                                <img src="@item.LogoUrl" alt="@item.Name" />
                            }
                            else
                            {
                                <div class="collab-preview-logo-placeholder">
                                    <i class="fa-solid fa-building fa-3x mb-2" aria-hidden="true"></i>
                                    <div style="font-size: 13px;">No logo uploaded</div>
                                </div>
                            }
                        </div>
                    </div>
                    <div class="col-lg-9 col-md-8">
                        <div class="collab-preview-hero-topbar">
                            <div class="collab-preview-pills mb-0">
                                <span class="collab-preview-pill collab-preview-pill-category">
                                    <i class="fa fa-handshake-o" aria-hidden="true"></i> @categoryLabel
                                </span>
                                @if (!string.IsNullOrWhiteSpace(item.PartnerType))
                                {
                                    <span class="collab-preview-pill collab-preview-pill-type">
                                        @item.PartnerType
                                    </span>
                                }
                                @if (item.Year.HasValue)
                                {
                                    <span class="collab-preview-pill collab-preview-pill-year">
                                        <i class="fa-regular fa-calendar" aria-hidden="true"></i> @item.Year
                                    </span>
                                }
                            </div>

                            @if (!string.IsNullOrWhiteSpace(item.WebsiteUrl) && item.WebsiteUrl != "#")
                            {
                                <a href="@item.WebsiteUrl" target="_blank" rel="noopener noreferrer" class="btn collab-preview-website-btn">
                                    <i class="fa fa-external-link" aria-hidden="true"></i> Visit Official Website
                                </a>
                            }
                        </div>

                        <h2 class="collab-preview-org-name">@item.Name</h2>

                        @if (!string.IsNullOrWhiteSpace(item.ShortDescription) && !string.IsNullOrWhiteSpace(item.LongDescription))
                        {
                            <p class="collab-preview-short-desc">@item.ShortDescription</p>
                        }
                    </div>
                </div>
            </div>

            <!-- Overview Section -->
            @if (!string.IsNullOrWhiteSpace(overviewText))
            {
                <div class="collab-preview-section">
                    <div class="collab-preview-section-header">
                        <h3 class="collab-preview-section-title">
                            <i class="fa-solid fa-circle-info" aria-hidden="true"></i> Overview
                        </h3>
                    </div>
                    <div class="collab-preview-overview-card">
                        <p>@overviewText</p>
                    </div>
                </div>
            }
            
            <!-- Photos & Media Gallery Section (Organization Media) -->
            @if (activeOrgMedia.Count > 0)
            {
                <div class="collab-preview-section">
                    <div class="collab-preview-section-header">
                        <h3 class="collab-preview-section-title">
                            <i class="fa-solid fa-camera" aria-hidden="true"></i> Photos &amp; Media
                        </h3>
                    </div>

                    <div class="collab-preview-org-media-block">
                        <div class="collab-preview-media-subhead">
                            <h4 class="collab-preview-media-subhead-title">
                                <i class="fa-solid fa-building" aria-hidden="true"></i>
                                @item.Name Gallery
                                <span class="collab-preview-media-count">@activeOrgMedia.Count</span>
                            </h4>
                        </div>

                        <div class="row g-4">
                            @foreach (var media in activeOrgMedia)
                            {
                                var mediaTitle = string.IsNullOrWhiteSpace(media.Title) ? media.FileName : media.Title;
                                <div class="@orgMediaColClass">
                                    <div class="collab-preview-media-card collab-preview-media-card-org">
                                        <div class="collab-preview-media-frame">
                                            @if (media.MediaType == CollaborationMediaType.Image)
                                            {
                                                <button type="button"
                                                        class="collab-preview-media-trigger"
                                                        data-lightbox-src="@media.FileUrl"
                                                        data-lightbox-title="@(media.Title ?? string.Empty)"
                                                        data-lightbox-caption="@(media.Caption ?? string.Empty)"
                                                        data-lightbox-description="@(media.Description ?? string.Empty)"
                                                        data-lightbox-source="@item.Name"
                                                        aria-label="View @mediaTitle">
                                                    <img src="@media.FileUrl" alt="@mediaTitle" loading="lazy" />
                                                </button>
                                            }
                                            else if (media.MediaType == CollaborationMediaType.Video)
                                            {
                                                <div class="collab-preview-media-video">
                                                    <video controls preload="metadata" src="@media.FileUrl"></video>
                                                </div>
                                            }
                                            else
                                            {
                                                var iconClass = media.MediaType switch
                                                {
                                                    CollaborationMediaType.Pdf => "fa-file-pdf",
                                                    CollaborationMediaType.Document => "fa-file-word",
                                                    _ => "fa-file"
                                                };
                                                <a href="@media.FileUrl" target="_blank" rel="noopener noreferrer" class="collab-preview-media-doc">
                                                    <i class="fa-solid @iconClass fa-3x" aria-hidden="true"></i>
                                                    <span class="fw-semibold text-truncate w-100">@mediaTitle</span>
                                                    <span class="btn btn-sm btn-outline-primary">Open File</span>
                                                </a>
                                            }
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(media.Title) || !string.IsNullOrWhiteSpace(media.Caption) || !string.IsNullOrWhiteSpace(media.Description))
                                        {
                                            <div class="collab-preview-media-meta">
                                                @if (!string.IsNullOrWhiteSpace(media.Title))
                                                {
                                                    <div class="collab-preview-media-title text-truncate" title="@media.Title">@media.Title</div>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(media.Caption))
                                                {
                                                    <div class="collab-preview-media-caption">@media.Caption</div>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(media.Description))
                                                {
                                                    <div class="collab-preview-media-desc">@media.Description</div>
                                                }
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
            <!-- Joint Works & Collaborations Section -->
            @if (activeProjects.Count > 0)
            {
                <div class="collab-preview-section">
                    <div class="collab-preview-section-header">
                        <h3 class="collab-preview-section-title">
                            <i class="fa-solid fa-cubes" aria-hidden="true"></i> Joint Works &amp; Collaborations
                            <span class="collab-preview-media-count">@activeProjects.Count</span>
                        </h3>
                    </div>

                    <div class="collab-preview-projects-stack">
                        @foreach (var work in activeProjects)
                        {
                            var activeWorkMedia = (work.Media ?? Array.Empty<CollaborationMediaDto>())
                                .Where(m => m.IsActive)
                                .ToList();
                            var projectMediaGridClass = activeWorkMedia.Count switch
                            {
                                1 => "is-single",
                                2 => "is-double",
                                3 => "is-triple",
                                _ => string.Empty
                            };
                            <article class="collab-preview-project-card">
                                <div class="collab-preview-project-header">
                                    <div class="collab-preview-project-img">
                                        @if (!string.IsNullOrWhiteSpace(work.LogoUrl))
                                        {
                                            <img src="@work.LogoUrl" alt="@work.Title" loading="lazy" />
                                        }
                                        else
                                        {
                                            <i class="fa-solid fa-folder-open fa-2x" style="color: #cbd5e1;" aria-hidden="true"></i>
                                        }
                                    </div>

                                    <div class="collab-preview-project-main">
                                        <div class="collab-preview-project-topbar">
                                            <div class="collab-preview-pills mb-0">
                                                <span class="collab-preview-pill collab-preview-pill-type">
                                                    @(string.IsNullOrWhiteSpace(work.ProjectType) ? "Collaboration" : work.ProjectType)
                                                </span>
                                                @if (work.Year.HasValue)
                                                {
                                                    <span class="collab-preview-pill collab-preview-pill-year">
                                                        <i class="fa-regular fa-calendar" aria-hidden="true"></i> @work.Year
                                                    </span>
                                                }
                                            </div>

                                            @if (!string.IsNullOrWhiteSpace(work.ProjectLink))
                                            {
                                                <a href="@work.ProjectLink" target="_blank" rel="noopener noreferrer" class="collab-preview-project-cta">
                                                    View Project <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
                                                </a>
                                            }
                                        </div>

                                        <h4 class="collab-preview-project-title">@work.Title</h4>

                                        @if (!string.IsNullOrWhiteSpace(work.ShortDescription))
                                        {
                                            <p class="collab-preview-project-desc">@work.ShortDescription</p>
                                        }

                                        @if (!string.IsNullOrWhiteSpace(work.LongDescription))
                                        {
                                            <div class="collab-preview-project-long-desc">@work.LongDescription</div>
                                        }
                                    </div>

                                    @if (work.BookId.HasValue)
                                    {
                                        var bookTitle = string.IsNullOrWhiteSpace(work.BookName) ? $"Book #{work.BookId.Value}" : work.BookName;
                                        var hasBookUrl = !string.IsNullOrWhiteSpace(work.BookProjectUrl) && work.BookProjectUrl != "#";
                                        <div class="collab-preview-project-book-col">
                                            @if (hasBookUrl)
                                            {
                                                <a href="@work.BookProjectUrl" target="_blank" rel="noopener noreferrer" class="collab-preview-linked-book is-link">
                                                    <div class="collab-preview-linked-book-cover">
                                                        @if (!string.IsNullOrWhiteSpace(work.BookImageUrl))
                                                        {
                                                            <img src="@work.BookImageUrl" alt="@bookTitle" loading="lazy" />
                                                        }
                                                        else
                                                        {
                                                            <i class="fa-solid fa-book-open" aria-hidden="true"></i>
                                                        }
                                                    </div>
                                                    <div class="collab-preview-linked-book-info">
                                                        <div class="collab-preview-linked-book-eyebrow">
                                                            <span><i class="fa-solid fa-book" aria-hidden="true"></i> Linked Book</span>
                                                            @if (!string.IsNullOrWhiteSpace(work.BookDialect))
                                                            {
                                                                <span class="collab-preview-linked-book-dialect">@work.BookDialect</span>
                                                            }
                                                        </div>
                                                        <div class="collab-preview-linked-book-title" title="@bookTitle">@bookTitle</div>
                                                    </div>
                                                    <span class="collab-preview-linked-book-arrow" aria-hidden="true">
                                                        <i class="fa-solid fa-arrow-up-right-from-square"></i>
                                                    </span>
                                                </a>
                                            }
                                            else
                                            {
                                                <div class="collab-preview-linked-book">
                                                    <div class="collab-preview-linked-book-cover">
                                                        @if (!string.IsNullOrWhiteSpace(work.BookImageUrl))
                                                        {
                                                            <img src="@work.BookImageUrl" alt="@bookTitle" loading="lazy" />
                                                        }
                                                        else
                                                        {
                                                            <i class="fa-solid fa-book-open" aria-hidden="true"></i>
                                                        }
                                                    </div>
                                                    <div class="collab-preview-linked-book-info">
                                                        <div class="collab-preview-linked-book-eyebrow">
                                                            <span><i class="fa-solid fa-book" aria-hidden="true"></i> Linked Book</span>
                                                            @if (!string.IsNullOrWhiteSpace(work.BookDialect))
                                                            {
                                                                <span class="collab-preview-linked-book-dialect">@work.BookDialect</span>
                                                            }
                                                        </div>
                                                        <div class="collab-preview-linked-book-title" title="@bookTitle">@bookTitle</div>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>

                                @if (activeWorkMedia.Count > 0)
                                {
                                    <div class="collab-preview-project-media">
                                        <div class="collab-preview-project-media-head">
                                            <span class="collab-preview-project-media-label">
                                                <i class="fa-regular fa-images" aria-hidden="true"></i>
                                                Media
                                            </span>
                                            <span class="collab-preview-media-count">@activeWorkMedia.Count</span>
                                        </div>
                                        <div class="collab-preview-project-media-grid @projectMediaGridClass">
                                            @foreach (var media in activeWorkMedia)
                                            {
                                                var mediaTitle = string.IsNullOrWhiteSpace(media.Title) ? media.FileName : media.Title;
                                                <div class="collab-preview-project-media-item">
                                                    <div class="collab-preview-project-media-thumb">
                                                        @if (media.MediaType == CollaborationMediaType.Image)
                                                        {
                                                            <button type="button"
                                                                    class="collab-preview-media-trigger collab-preview-project-media-trigger"
                                                                    data-lightbox-src="@media.FileUrl"
                                                                    data-lightbox-title="@(media.Title ?? string.Empty)"
                                                                    data-lightbox-caption="@(media.Caption ?? string.Empty)"
                                                                    data-lightbox-description="@(media.Description ?? string.Empty)"
                                                                    data-lightbox-source="@work.Title"
                                                                    aria-label="View @mediaTitle">
                                                                <img src="@media.FileUrl" alt="@mediaTitle" loading="lazy" />
                                                            </button>
                                                        }
                                                        else if (media.MediaType == CollaborationMediaType.Video)
                                                        {
                                                            <div class="collab-preview-media-video">
                                                                <video controls preload="metadata" src="@media.FileUrl"></video>
                                                            </div>
                                                        }
                                                        else
                                                        {
                                                            var iconClass = media.MediaType switch
                                                            {
                                                                CollaborationMediaType.Pdf => "fa-file-pdf",
                                                                CollaborationMediaType.Document => "fa-file-word",
                                                                _ => "fa-file"
                                                            };
                                                            <a href="@media.FileUrl" target="_blank" rel="noopener noreferrer" class="collab-preview-project-media-doc" title="@mediaTitle">
                                                                <i class="fa-solid @iconClass fa-2x" aria-hidden="true"></i>
                                                                <span class="fw-semibold text-truncate w-100">@mediaTitle</span>
                                                            </a>
                                                        }
                                                    </div>
                                                    @if (!string.IsNullOrWhiteSpace(media.Title) || !string.IsNullOrWhiteSpace(media.Caption) || !string.IsNullOrWhiteSpace(media.Description))
                                                    {
                                                        <div class="collab-preview-project-media-meta">
                                                            @if (!string.IsNullOrWhiteSpace(media.Title))
                                                            {
                                                                <div class="collab-preview-project-media-title text-truncate" title="@media.Title">@media.Title</div>
                                                            }
                                                            @if (!string.IsNullOrWhiteSpace(media.Caption))
                                                            {
                                                                <div class="collab-preview-project-media-caption text-truncate" title="@media.Caption">@media.Caption</div>
                                                            }
                                                            @if (!string.IsNullOrWhiteSpace(media.Description))
                                                            {
                                                                <div class="collab-preview-project-media-desc" title="@media.Description">@media.Description</div>
                                                            }
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                            </article>
                        }
                    </div>
                </div>
            }


            <!-- Public Frontend Footer Navigation (mirrors About/PartnerDetails.cshtml) -->
            <div class="collab-preview-footer">
                <a href="/about/partners" class="btn collab-preview-nav-btn-primary">
                    <i class="fa fa-users" aria-hidden="true"></i> Back to Partners
                </a>
                <a href="/about/contributors" class="btn collab-preview-nav-btn-outline">
                    <i class="fa fa-heart" aria-hidden="true"></i> Back to Contributors
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Image Lightbox Modal -->
<div class="modal fade collab-preview-lightbox" id="collabPreviewLightbox" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header border-0 pb-1">
                <div>
                    <span id="collabLightboxSource" class="badge bg-primary mb-1" style="background-color: #0b4570 !important;"></span>
                    <h5 class="modal-title fw-bold" id="collabLightboxTitle" style="color: #0b4570;"></h5>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center pt-2">
                <img id="collabLightboxImage" src="" alt="" class="collab-preview-lightbox-img rounded" />
                <p id="collabLightboxCaption" class="text-muted small mt-3 mb-0"></p>
                <p id="collabLightboxDescription" class="collab-preview-lightbox-desc mb-0"></p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var modalEl = document.getElementById('collabPreviewLightbox');
            var imgEl = document.getElementById('collabLightboxImage');
            var titleEl = document.getElementById('collabLightboxTitle');
            var captionEl = document.getElementById('collabLightboxCaption');
            var descEl = document.getElementById('collabLightboxDescription');
            var sourceEl = document.getElementById('collabLightboxSource');

            if (modalEl && imgEl) {
                if (modalEl.parentElement !== document.body) {
                    document.body.appendChild(modalEl);
                }

                modalEl.addEventListener('show.bs.modal', function () {
                    document.documentElement.classList.add('collab-lightbox-open');
                    document.body.classList.add('collab-lightbox-open');
                });

                modalEl.addEventListener('hidden.bs.modal', function () {
                    document.documentElement.classList.remove('collab-lightbox-open');
                    document.body.classList.remove('collab-lightbox-open');
                });

                document.querySelectorAll('.collab-preview-media-trigger').forEach(function (trigger) {
                    trigger.addEventListener('click', function () {
                        var src = trigger.getAttribute('data-lightbox-src') || '';
                        var title = trigger.getAttribute('data-lightbox-title') || '';
                        var caption = trigger.getAttribute('data-lightbox-caption') || '';
                        var description = trigger.getAttribute('data-lightbox-description') || '';
                        var source = trigger.getAttribute('data-lightbox-source') || '';

                        imgEl.src = src;
                        imgEl.alt = title || source || 'Media preview';
                        sourceEl.textContent = source;
                        sourceEl.style.display = source ? 'inline-block' : 'none';
                        titleEl.textContent = title;
                        titleEl.style.display = title ? '' : 'none';
                        captionEl.textContent = caption;
                        captionEl.style.display = caption ? '' : 'none';
                        if (descEl) {
                            descEl.textContent = description;
                            descEl.style.display = description ? '' : 'none';
                        }

                        if (window.bootstrap && window.bootstrap.Modal) {
                            window.bootstrap.Modal.getOrCreateInstance(modalEl, { backdrop: false }).show();
                        } else if (src) {
                            window.open(src, '_blank', 'noopener,noreferrer');
                        }
                    });
                });

                modalEl.addEventListener('click', function (e) {
                    if (e.target === modalEl && window.bootstrap && window.bootstrap.Modal) {
                        window.bootstrap.Modal.getOrCreateInstance(modalEl).hide();
                    }
                });
            }
        })();
    </script>
}
