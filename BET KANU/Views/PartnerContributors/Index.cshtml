@model PartnerContributorIndexViewModel
@using BetKanu.Models.Common
<link rel="stylesheet" href="~/css/dashboard.css">
<link rel="stylesheet" href="~/css/collaboration-admin.css">

@{
    ViewBag.Title = "Partners & Contributors";
    var results = Model.Results;
    string CategoryBadge(CollaborationCategory c) => c switch
    {
        CollaborationCategory.Partner => "collab-badge-partner",
        CollaborationCategory.Contributor => "collab-badge-contributor",
        _ => "collab-badge-both"
    };
}

<div id="wrapper">
    <section class="bg-success promo">
        <div class="container">
            <h1 style="color:white">&nbsp;Partners &amp; Contributors</h1>
        </div>
    </section>

    <section>
        <div class="container py-4">
            <partial name="_CollaborationMessages" />

            <nav aria-label="breadcrumb" class="mb-3">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Manger")">Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Partners &amp; Contributors</li>
                </ol>
            </nav>

            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
                <p class="mb-0 text-muted">
                    Manage partner and contributor organizations, their collaboration projects, and media.
                </p>
                <a href="@Url.Action("Create")" class="btn btn-Create">
                    <i class="fa-solid fa-plus me-1"></i>Add Organization
                </a>
            </div>

            <div class="card mb-4">
                <div class="card-header">
                    <h3 class="card-title mb-0"><i class="fa-solid fa-filter me-2"></i>Filters</h3>
                </div>
                <div class="card-body">
                    <form method="get" class="row g-3 align-items-end">
                        <div class="col-lg-3 col-md-6">
                            <label class="form-label" for="search">Search name</label>
                            <input id="search" name="search" value="@Model.Search" class="form-control" placeholder="Organization name" />
                        </div>
                        <div class="col-lg-2 col-md-6">
                            <label class="form-label" for="category">Category</label>
                            <select id="category" name="category" class="form-select">
                                <option value="">All</option>
                                <option value="1" selected="@(Model.Category == CollaborationCategory.Partner)">Partners</option>
                                <option value="2" selected="@(Model.Category == CollaborationCategory.Contributor)">Contributors</option>
                                <option value="3" selected="@(Model.Category == CollaborationCategory.Both)">Both</option>
                            </select>
                        </div>
                        <div class="col-lg-2 col-md-6">
                            <label class="form-label" for="isActive">Status</label>
                            <select id="isActive" name="isActive" class="form-select">
                                <option value="">All</option>
                                <option value="true" selected="@(Model.IsActive == true)">Active</option>
                                <option value="false" selected="@(Model.IsActive == false)">Inactive</option>
                            </select>
                        </div>
                        <div class="col-lg-2 col-md-6">
                            <label class="form-label" for="year">Year</label>
                            <input id="year" name="year" type="number" min="1900" max="2100" value="@Model.Year" class="form-control" placeholder="All years" />
                        </div>
                        <div class="col-lg-3 col-md-6">
                            <button type="submit" class="btn btn-Create me-2">Apply</button>
                            <a class="btn btn-outline-secondary" href="@Url.Action("Index")">Reset</a>
                        </div>
                    </form>
                </div>
            </div>

            <div class="card">
                <div class="card-body">
                    <p class="text-muted">@results.TotalCount organization(s)</p>
                    @if (results.Items.Count == 0)
                    {
                        <div class="collab-empty">
                            <i class="fa-solid fa-handshake fa-3x mb-3"></i>
                            <h2 class="h5">No organizations found</h2>
                            <p>Try adjusting filters or add a new partner/contributor.</p>
                            <a class="btn btn-Create" href="@Url.Action("Create")">Add Organization</a>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-bordered align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th style="color:white">Logo</th>
                                        <th style="color:white">Organization</th>
                                        <th style="color:white">Category</th>
                                        <th style="color:white">Type</th>
                                        <th style="color:white">Year</th>
                                        <th style="color:white">Projects</th>
                                        <th style="color:white">Status</th>
                                        <th style="color:white">Order</th>
                                        <th style="color:white">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in results.Items)
                                    {
                                        <tr>
                                            <td>
                                                @if (!string.IsNullOrWhiteSpace(item.LogoUrl))
                                                {
                                                    <img src="@item.LogoUrl" alt="" class="collab-thumb" />
                                                }
                                                else
                                                {
                                                    <div class="collab-logo-placeholder"><i class="fa-solid fa-building"></i></div>
                                                }
                                            </td>
                                            <td>
                                                <div class="fw-semibold">@item.Name</div>
                                                @if (!string.IsNullOrWhiteSpace(item.ShortDescription))
                                                {
                                                    <small class="text-muted">@(item.ShortDescription.Length > 80 ? item.ShortDescription[..80] + "…" : item.ShortDescription)</small>
                                                }
                                            </td>
                                            <td><span class="badge @CategoryBadge(item.Category)">@item.Category</span></td>
                                            <td>@(item.PartnerType ?? "—")</td>
                                            <td>@(item.Year?.ToString() ?? "—")</td>
                                            <td>@item.ProjectCount</td>
                                            <td>
                                                @if (item.IsActive)
                                                {
                                                    <span class="badge bg-success">Active</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">Inactive</span>
                                                }
                                            </td>
                                            <td>@item.DisplayOrder</td>
                                            <td>
                                                <div class="collab-actions">
                                                    <a class="btn btn-sm btn-outline-secondary" href="@Url.Action("Details", new { id = item.Id })">View</a>
                                                    <a class="btn btn-sm btn-outline-primary" href="@Url.Action("Edit", new { id = item.Id })">Edit</a>
                                                    <a class="btn btn-sm btn-outline-primary" href="@Url.Action("Edit", new { id = item.Id, tab = "projects" })">Projects</a>
                                                    <a class="btn btn-sm btn-outline-primary" href="@Url.Action("Edit", new { id = item.Id, tab = "media" })">Media</a>
                                                    <form method="post" asp-action="SetActive" asp-route-id="@item.Id">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="isActive" value="@(item.IsActive ? "false" : "true")" />
                                                        <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                                        <button type="submit" class="btn btn-sm btn-outline-secondary">@(item.IsActive ? "Deactivate" : "Activate")</button>
                                                    </form>
                                                    <form method="post" asp-action="Delete" asp-route-id="@item.Id"
                                                          onsubmit="return confirm('Delete this organization? This is only allowed when it has no projects or media.');">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        @if (results.TotalPages > 1)
                        {
                            <nav class="mt-3" aria-label="Organization pagination">
                                <ul class="pagination mb-0">
                                    <li class="page-item @(results.Page <= 1 ? "disabled" : null)">
                                        <a class="page-link" href="@Url.Action("Index", new { search = Model.Search, category = Model.Category, isActive = Model.IsActive, year = Model.Year, page = results.Page - 1, pageSize = results.PageSize })">Previous</a>
                                    </li>
                                    <li class="page-item disabled"><span class="page-link">Page @results.Page of @results.TotalPages</span></li>
                                    <li class="page-item @(results.Page >= results.TotalPages ? "disabled" : null)">
                                        <a class="page-link" href="@Url.Action("Index", new { search = Model.Search, category = Model.Category, isActive = Model.IsActive, year = Model.Year, page = results.Page + 1, pageSize = results.PageSize })">Next</a>
                                    </li>
                                </ul>
                            </nav>
                        }
                    }
                </div>
            </div>
        </div>
    </section>
</div>
