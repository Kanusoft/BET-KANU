
<head>
    @{
        ViewBag.Title = "Contact";
    }
</head>
<div id="wrapper">
    <section class="overflow-hidden">
        <div class="container">
            <div class="row">
                <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12" style="color:#6d6e71; text-align:center">
                    <br> <h3 style="color:#6d6e71">We would like to hear from you! </h3>
                    <p>
                        You can send us a message or an email to
                        <a href="https://mail.google.com/mail/?view=cm&fs=1&tf=1&to=mailto:info@betkanu.com&su=Shlomo BET KANU&shva=1" style="color:#2ca8e0" target="_blank">info@betkanu.com</a>
                        @*<a href="mailto:info@betkanu.com" target="_blank">info@betkanu.com</a>*@
                    </p>
                </div>

                <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
                    <form id="myEmailForm" method="post">
                        <input type="hidden" name="toEmail" value="Bet Kanu <info@betkanu.com>" />
                        <div class="form-group">
                            <input class=" form-control" style="max-width:100%" type="text" name="name" id="name" value="" placeholder="Your Name" required />
                        </div>
                        <div class="form-group">
                            <input class=" form-control" style="max-width:100%" type="email" name="email" id="Email" value="" placeholder="Your Email" required />
                        </div>
                        <div class="form-group">
                            <input class=" form-control" style="max-width:100%" type="text" name="subject" id="subject" value="" placeholder="Subject" required />
                        </div>

                        <div class="form-group">
                            <textarea name="message" id="message" rows="5" class=" form-control" style="max-width:100%" placeholder="Message" required></textarea>
                            <div class="clear"></div>
                        </div>
                        <div class="text-center">
                            <input type="submit" id="btnSubmit" class="btn btn-success btn-form marg-right5" value="Send Message" />
                            <input type="reset" class="btn btn-danger btn-form" value="Reset" />
                        </div>
                        <div class="clear pad45"></div>
                    </form>
                </div>
                <div name="messageResult" id="messageResult" class="col-xs-12 col-sm-12 col-md-12 col-lg-12 text-center"></div>
            </div>
        </div>
    </section>
</div>
    @section Scripts{
    <script type="text/javascript">
        $("#myEmailForm").submit(function (event) {
            event.preventDefault();

            const fromEmail = $("#Email").val();
            const fromName = $("#name").val();
            const subject = $("#subject").val();
            const body = $("#message").val();

            const btn = $("#btnSubmit");
            btn.prop("disabled", true).val("Sending...");
            $("#messageResult").html("");

            $.ajax({
                url: "/api/EmailService",
                type: "POST",
                contentType: "application/json",
                data: JSON.stringify({
                    name: fromName,
                    email: fromEmail,
                    subject: subject,
                    toEmail: "info@betkanu.com",
                    message: body
                }),
                success: function (data) {
                    btn.prop("disabled", false).val("Send Message");
                    if (data && data.result) {
                        $("#name").val("");
                        $("#Email").val("");
                        $("#subject").val("");
                        $("#message").val("");

                        $("#messageResult").html('<div class="alert alert-success mt-3" style="padding: 15px; background-color: #d4edda; color: #155724; border: 1px solid #c3e6cb; border-radius: 4px;"><i class="fa fa-check-circle"></i> Thank you! Your message has been sent successfully.</div>');
                    } else {
                        $("#messageResult").html('<div class="alert alert-danger mt-3" style="padding: 15px; background-color: #f8d7da; color: #721c24; border: 1px solid #f5c6cb; border-radius: 4px;"><i class="fa fa-exclamation-triangle"></i> ' + (data.message || 'Error sending the message. Please try again later.') + '</div>');
                    }
                },
                error: function (xhr) {
                    btn.prop("disabled", false).val("Send Message");
                    $("#messageResult").html('<div class="alert alert-danger mt-3" style="padding: 15px; background-color: #f8d7da; color: #721c24; border: 1px solid #f5c6cb; border-radius: 4px;"><i class="fa fa-exclamation-triangle"></i> Error sending the message. Please try again or send an email directly to <strong>info@betkanu.com</strong>.</div>');
                }
            });
        });
    </script>
    }
