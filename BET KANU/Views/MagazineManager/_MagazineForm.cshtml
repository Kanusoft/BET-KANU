@model BetKanu.Models.ViewModels.MagazineFormViewModel

<input asp-for="Id" type="hidden" />
<input asp-for="ExistingCoverImage" type="hidden" />
<input asp-for="ExistingCoverImage350" type="hidden" />

<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card mb-4">
            <div class="card-header">
                <h3 class="card-title mb-0">Basic Information</h3>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-8">
                        <div class="form-group mb-3">
                            <label asp-for="Title" class="form-label"></label>
                            <input asp-for="Title" class="form-control" />
                            <span asp-validation-for="Title" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group mb-3">
                            <label asp-for="Year" class="form-label"></label>
                            <input asp-for="Year" class="form-control" type="number" min="1900" max="3000" />
                            <span asp-validation-for="Year" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="form-group mb-3">
                            <label asp-for="ShortDescription" class="form-label"></label>
                            <textarea asp-for="ShortDescription" class="form-control" rows="5"></textarea>
                            <span asp-validation-for="ShortDescription" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="form-group mb-0">
                            <label asp-for="LongDescription" class="form-label"></label>
                            <textarea asp-for="LongDescription" class="form-control" rows="12"></textarea>
                            <span asp-validation-for="LongDescription" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <h3 class="card-title mb-0">Publication</h3>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-4">
                        <div class="form-group mb-3">
                            <label asp-for="DisplayOrder" class="form-label"></label>
                            <input asp-for="DisplayOrder" class="form-control" type="number" min="0" />
                            <span asp-validation-for="DisplayOrder" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-8">
                        <div class="form-check form-switch mt-md-4 pt-md-2">
                            <input asp-for="IsPublished" class="form-check-input" type="checkbox" role="switch" id="IsPublished" />
                            <label asp-for="IsPublished" class="form-check-label"></label>
                            <span asp-validation-for="IsPublished" class="text-danger d-block"></span>
                        </div>
                    </div>
                    <div class="col-md-6" id="publicationDateGroup">
                        <div class="form-group mb-0">
                            <label asp-for="PublishedAtUtc" class="form-label"></label>
                            <input asp-for="PublishedAtUtc"
                                   class="form-control"
                                   type="datetime-local"
                                   id="PublishedAtUtc" />
                            <div class="form-text">
                                Leave empty to use the current UTC date when publishing.
                            </div>
                            <span asp-validation-for="PublishedAtUtc" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title mb-0">Cover Image</h3>
            </div>
            <div class="card-body">
                <div class="form-group mb-4">
                    <label for="CoverImageFile" class="control-label">
                        Desktop Cover Image — 1920 × 700
                    </label>
                    <input asp-for="CoverImageFile"
                           class="dropify"
                           type="file"
                           accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
                           id="CoverImageFile"
                           data-height="220"
                           data-max-file-size="5M"
                           data-allowed-file-extensions="jpg jpeg png webp"
                           data-default-file="@(Model.IsEdit ? Model.ExistingCoverImage : "")"
                           aria-describedby="coverFileHelp coverPreviewError" />
                    <div id="coverFileHelp" class="form-text">
                        JPG, JPEG, PNG, or WEBP. Maximum size: 5 MB. Used on desktop screens.
                    </div>
                    <span asp-validation-for="CoverImageFile" class="text-danger"></span>
                    <div id="coverPreviewError"
                         class="text-danger small mt-1"
                         role="alert"
                         aria-live="polite"></div>
                </div>

                <div class="form-group mb-0">
                    <label for="CoverImage350File" class="control-label">
                        Mobile Cover Image — 1920 × 350
                    </label>
                    <input asp-for="CoverImage350File"
                           class="dropify"
                           type="file"
                           accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
                           id="CoverImage350File"
                           data-height="160"
                           data-max-file-size="5M"
                           data-allowed-file-extensions="jpg jpeg png webp"
                           data-default-file="@(Model.IsEdit ? Model.ExistingCoverImage350 : "")"
                           aria-describedby="cover350FileHelp cover350PreviewError" />
                    <div id="cover350FileHelp" class="form-text">
                        JPG, JPEG, PNG, or WEBP. Maximum size: 5 MB. Used on small screens.
                    </div>
                    <span asp-validation-for="CoverImage350File" class="text-danger"></span>
                    <div id="cover350PreviewError"
                         class="text-danger small mt-1"
                         role="alert"
                         aria-live="polite"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .card {
        background-color: #3e4966 !important;
        border: 1px solid rgba(255, 255, 255, 0.05) !important;
    }
    .card-header {
        border-bottom: 1px solid rgba(255, 255, 255, 0.05) !important;
        background-color: transparent !important;
    }
    .card-title {
        color: #fff !important;
    }
    .card label, .card .control-label, .card .form-label {
        color: #fff !important;
    }
    .card .form-control, .card .form-select {
        color: #8f98c1 !important;
        background-color: #424b65 !important;
        border: 1px solid rgba(255, 255, 255, 0.05) !important;
    }
    .card .form-control:focus, .card .form-select:focus {
        color: #fff !important;
        background-color: #424b65 !important;
        border-color: #4eceb2 !important;
        box-shadow: none !important;
    }
    .card .form-text {
        color: #7984a0 !important;
    }
    .card .text-danger {
        color: #ff5b5b !important;
    }

    #publicationDateGroup.is-disabled {
        opacity: 0.55;
    }

    #publicationDateGroup.is-disabled input {
        pointer-events: none;
        background-color: #2d3448 !important;
        color: #5d667c !important;
    }
</style>

<script>
    (function () {
        var isPublished = document.getElementById('IsPublished');
        var publicationDateGroup = document.getElementById('publicationDateGroup');
        var coverInput = document.getElementById('CoverImageFile');
        var cover350Input = document.getElementById('CoverImage350File');
        var coverPreviewError = document.getElementById('coverPreviewError');
        var cover350PreviewError = document.getElementById('cover350PreviewError');

        var allowedExtensions = ['.jpg', '.jpeg', '.png', '.webp'];
        var allowedMimeTypes = ['image/jpeg', 'image/png', 'image/webp'];
        var maxFileSize = 5 * 1024 * 1024;

        function togglePublicationDate() {
            if (!isPublished || !publicationDateGroup) {
                return;
            }

            if (isPublished.checked) {
                publicationDateGroup.classList.remove('is-disabled');
                publicationDateGroup.setAttribute('aria-hidden', 'false');
            } else {
                publicationDateGroup.classList.add('is-disabled');
                publicationDateGroup.setAttribute('aria-hidden', 'true');
            }
        }

        function clearSelectedFile(input) {
            if (!input) {
                return;
            }

            input.value = '';

            if (window.jQuery && window.jQuery(input).data('dropify')) {
                var dropify = window.jQuery(input).data('dropify');
                dropify.resetPreview();
                dropify.clearElement();
            }
        }

        function validateCoverFile(input, errorElement, displayName) {
            if (errorElement) {
                errorElement.textContent = '';
            }

            var file = input && input.files && input.files.length > 0
                ? input.files[0]
                : null;

            if (!file) {
                return true;
            }

            var extension = file.name.substring(file.name.lastIndexOf('.')).toLowerCase();
            if (allowedExtensions.indexOf(extension) === -1 &&
                allowedMimeTypes.indexOf(file.type) === -1) {
                if (errorElement) {
                    errorElement.textContent =
                        'Only JPG, JPEG, PNG, and WEBP images are allowed.';
                }
                clearSelectedFile(input);
                return false;
            }

            if (file.size > maxFileSize) {
                if (errorElement) {
                    errorElement.textContent =
                        'The ' + displayName + ' cannot exceed 5 MB.';
                }
                clearSelectedFile(input);
                return false;
            }

            return true;
        }

        if (isPublished) {
            isPublished.addEventListener('change', togglePublicationDate);
            togglePublicationDate();
        }

        if (coverInput) {
            coverInput.addEventListener('change', function () {
                validateCoverFile(coverInput, coverPreviewError, 'desktop cover image');
            });
        }

        if (cover350Input) {
            cover350Input.addEventListener('change', function () {
                validateCoverFile(cover350Input, cover350PreviewError, 'mobile cover image');
            });
        }
    })();
</script>
