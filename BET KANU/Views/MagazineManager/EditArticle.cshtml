@model BetKanu.Models.ViewModels.MagazineArticles.MagazineArticleFormViewModel
<link href="~/plugins/fileuploads/css/dropify.css" rel="stylesheet" type="text/css" />
<link rel="stylesheet" href="~/css/dashboard.css">
@{
    ViewBag.Title = "Edit Article";
}

<div id="wrapper">
    <section class="bg-grey-500 promo">
        <div class="container">
            <h1 style="color:white">&nbsp;Edit Article — @Model.Title</h1>
        </div>
    </section>

    <section>
        <div class="container py-4">
            <div class="col-12">
                <form id="articleForm"
                      class="card"
                      asp-action="EditArticle"
                      asp-route-id="@Model.Id"
                      method="post"
                      enctype="multipart/form-data"
                      novalidate>
                    @Html.AntiForgeryToken()

                    <div class="card-body">
                        <partial name="_ArticleForm" model="Model" />
                    </div>

                    <div class="card-footer">
                        <div class="row g-3 justify-content-end">
                            <div class="col-sm-6 col-md-3">
                                <a asp-action="Articles"
                                   asp-route-magazineId="@Model.MagazineId"
                                   class="btn btn-secondary w-100">
                                    Cancel
                                </a>
                            </div>
                            <div class="col-sm-6 col-md-3">
                                <button type="submit"
                                        id="articleSubmitBtn"
                                        class="btn btn-Create w-100">
                                    <span class="btn-text">Save Changes</span>
                                </button>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </section>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <!-- file uploads js -->
    <script src="~/plugins/fileuploads/js/dropify.js"></script>
    <script>
        $(function () {
            $('.dropify').dropify({
                messages: {
                    default: 'Drag and drop a file here or click',
                    replace: 'Drag and drop or click to replace',
                    remove: 'Remove',
                    error: 'The selected file is not valid.'
                },
                error: {
                    fileSize: 'The file is too large.',
                    fileExtension: 'This file type is not allowed.'
                }
            });
        });
    </script>

    <script>
        (function () {
            'use strict';

            const form = document.getElementById('articleForm');
            const submitButton = document.getElementById('articleSubmitBtn');
            const buttonText = submitButton?.querySelector('.btn-text');

            const defaultLabel = 'Save Changes';
            const maxCombinedFileSizeBytes = 25 * 1024 * 1024;

            let isSubmitting = false;

            if (!form || !submitButton || !buttonText) {
                return;
            }

            function formatFileSize(bytes) {
                return (bytes / 1024 / 1024).toFixed(1) + ' MB';
            }

            function getCombinedFileSize() {
                let totalBytes = 0;

                form.querySelectorAll('input[type="file"]')
                    .forEach(function (input) {
                        Array.from(input.files || [])
                            .forEach(function (file) {
                                totalBytes += file.size;
                            });
                    });

                return totalBytes;
            }

            function resetSubmitButton() {
                isSubmitting = false;
                submitButton.disabled = false;
                buttonText.textContent = defaultLabel;
            }

            function showTabContainingElement(element) {
                if (!element || !window.bootstrap) {
                    return;
                }

                const tabPane = element.closest('.tab-pane');

                if (!tabPane?.id) {
                    return;
                }

                const tabButton = document.querySelector(
                    `[data-bs-target="#${tabPane.id}"]`
                );

                if (tabButton) {
                    bootstrap.Tab
                        .getOrCreateInstance(tabButton)
                        .show();
                }
            }

            function focusFirstInvalidField() {
                const firstInvalidField = form.querySelector(
                    ':invalid, .input-validation-error, .is-invalid'
                );

                if (!firstInvalidField) {
                    const firstValidationMessage = form.querySelector(
                        '.field-validation-error:not(:empty), .text-danger:not(:empty)'
                    );

                    if (firstValidationMessage) {
                        showTabContainingElement(firstValidationMessage);
                    }

                    return;
                }

                showTabContainingElement(firstInvalidField);

                window.setTimeout(function () {
                    firstInvalidField.focus({
                        preventScroll: true
                    });

                    firstInvalidField.scrollIntoView({
                        behavior: 'smooth',
                        block: 'center'
                    });
                }, 150);
            }

            form.addEventListener('submit', function (event) {
                if (isSubmitting) {
                    event.preventDefault();
                    return;
                }

                const filesAreValid =
                    !window.articleFileValidation ||
                    window.articleFileValidation.validateAll();

                const totalFileSize = getCombinedFileSize();

                if (totalFileSize > maxCombinedFileSizeBytes) {
                    event.preventDefault();

                    alert(
                        `The selected files total ${formatFileSize(totalFileSize)}. ` +
                        'The combined upload must not exceed 25 MB.'
                    );

                    resetSubmitButton();
                    return;
                }

                const nativeValidationIsValid = form.checkValidity();

                const jqueryValidationIsValid =
                    !window.jQuery ||
                    typeof window.jQuery(form).valid !== 'function' ||
                    window.jQuery(form).valid();

                if (!filesAreValid ||
                    !nativeValidationIsValid ||
                    !jqueryValidationIsValid) {

                    event.preventDefault();
                    resetSubmitButton();
                    focusFirstInvalidField();
                    return;
                }

                isSubmitting = true;
                submitButton.disabled = true;
                buttonText.textContent = 'Saving...';
            });

            form.addEventListener('invalid', function (event) {
                resetSubmitButton();
                showTabContainingElement(event.target);
            }, true);

            if (window.jQuery) {
                window.jQuery(form).on(
                    'invalid-form.validate',
                    function () {
                        resetSubmitButton();
                        focusFirstInvalidField();
                    }
                );
            }

            window.addEventListener('pageshow', function () {
                resetSubmitButton();
            });

            // Activate the tab that contains the first server-side validation error.
            focusFirstInvalidField();
        })();
    </script>
}
