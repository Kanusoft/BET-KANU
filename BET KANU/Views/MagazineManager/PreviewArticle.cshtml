@model MagazineArticlePreviewViewModel
<link rel="stylesheet" href="~/css/dashboard.css">
<link rel="stylesheet" href="~/css/theme.css">

@{
    ViewBag.Title = $"Preview — {Model.Title}";

    bool HasContent(
        string? title,
        string? introduction,
        string? bodyHtml,
        string? creditsHtml,
        string? pdfUrl)
    {
        return !string.IsNullOrWhiteSpace(title)
            || !string.IsNullOrWhiteSpace(introduction)
            || !string.IsNullOrWhiteSpace(bodyHtml)
            || !string.IsNullOrWhiteSpace(creditsHtml)
            || !string.IsNullOrWhiteSpace(pdfUrl);
    }

    var hasEnglish = HasContent(
        Model.EnglishTitle,
        Model.EnglishIntroduction,
        Model.EnglishBodyHtml,
        Model.EnglishCreditsHtml,
        Model.EnglishPdfUrl);

    var hasWestern = HasContent(
        Model.WesternTitle,
        Model.WesternIntroduction,
        Model.WesternBodyHtml,
        Model.WesternCreditsHtml,
        Model.WesternPdfUrl);

    var hasEastern = HasContent(
        Model.EasternTitle,
        Model.EasternIntroduction,
        Model.EasternBodyHtml,
        Model.EasternCreditsHtml,
        Model.EasternPdfUrl);

}

<div id="wrapper">
    <section class="bg-grey-500 promo">
        <div class="container d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div>
                <h1 style="color:white" class="mb-1">
                    Article Preview
                </h1>
                <div style="color:white">
                    @Model.Title
                </div>
                <div class="mt-1">
                    @switch (Model.Status)
                    {
                        case MagazineArticleStatus.Published:
                            <span class="badge bg-success">Published</span>
                            break;
                        case MagazineArticleStatus.Scheduled:
                            <span class="badge bg-warning text-dark">Scheduled</span>
                            break;
                        case MagazineArticleStatus.Archived:
                            <span class="badge bg-dark">Archived</span>
                            break;
                        default:
                            <span class="badge bg-secondary">Draft</span>
                            break;
                    }
                </div>
            </div>

            <div class="d-flex flex-wrap gap-2">
                <a asp-action="Articles"
                   asp-route-magazineId="@Model.MagazineId"
                   class="btn btn-light">
                    <i class="fa-solid fa-arrow-left me-1" aria-hidden="true"></i>
                    Back to Articles
                </a>

                <a asp-action="EditArticle"
                   asp-route-id="@Model.Id"
                   class="btn btn-primary">
                    <i class="fa-solid fa-pen-to-square me-1" aria-hidden="true"></i>
                    Edit Article
                </a>
            </div>
        </div>
    </section>

    @{
        var desktopBanner = !string.IsNullOrWhiteSpace(Model.BannerImage)
            ? Model.BannerImage
            : Model.MobileBannerImage;
    }
    @if (!string.IsNullOrWhiteSpace(desktopBanner))
    {
        <section class="p-0">
            <div class="hero hero-game">
                <picture>
                    @if (!string.IsNullOrWhiteSpace(Model.MobileBannerImage))
                    {
                        <source media="(max-width: 767.98px)"
                                srcset="@Model.MobileBannerImage" />
                    }

                    <img src="@desktopBanner"
                         alt="Banner for @Model.Title" />
                </picture>
            </div>
        </section>
    }

    <section>
        <div class="container">
            <div class="row">
                <div class="col-lg-12">
                    <div class="post post-single">
                        <div class="post-header">
                            <div class="post-title">
                                <h2>@Model.Title</h2>

                                <ul class="post-meta">
                                    <li>
                                        <i class="fa fa-newspaper" aria-hidden="true"></i>
                                        @Model.MagazineTitle
                                    </li>

                                    @if (!string.IsNullOrWhiteSpace(Model.EditionTitle))
                                    {
                                        <li>
                                            <i class="fa fa-file-text" aria-hidden="true"></i>
                                            @Model.EditionTitle
                                        </li>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(Model.ArticleType))
                                    {
                                        <li>
                                            <i class="fa fa-book-open" aria-hidden="true"></i>
                                            @Model.ArticleType
                                        </li>
                                    }
                                </ul>
                            </div>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(Model.Summary))
                        {
                            <p>@Model.Summary</p>
                        }
                    </div>

                    @{
                        int activeLanguageCount = (hasEnglish ? 1 : 0) + (hasWestern ? 1 : 0) + (hasEastern ? 1 : 0);
                        string colClass = activeLanguageCount switch
                        {
                            3 => "col-lg-4 col-md-6 col-sm-12",
                            2 => "col-md-6 col-sm-12",
                            _ => "col-12"
                        };
                    }

                    @if (activeLanguageCount == 0)
                    {
                        <div class="alert alert-info">
                            No language content has been added yet.
                        </div>
                    }
                    else
                    {
                        <div class="row g-4 justify-content-between Articles">
                         
                            @if (hasWestern)
                            {
                                <div class="@colClass">
                                    <div class="well h-100 text-center"
                                         style="direction: rtl"
                                         id="western">
                                        <h3 class="padding-bottom-10"
                                            style="direction:ltr">
                                            Western Syriac
                                        </h3>
                                        <br>

                                        @if (!string.IsNullOrWhiteSpace(Model.WesternTitle))
                                        {
                                            <span class="Surayt bold text-center">
                                                @Model.WesternTitle
                                            </span>
                                        }
                                        <br>

                                        @if (!string.IsNullOrWhiteSpace(Model.WesternIntroduction))
                                        {
                                            <p style="direction:ltr">@Model.WesternIntroduction</p>
                                        }

                                        @if (!string.IsNullOrWhiteSpace(Model.WesternBodyHtml))
                                        {
                                            <div class="Surayt text-right">
                                                @Html.Raw(Model.WesternBodyHtml)
                                            </div>
                                        }
                                        else
                                        {
                                            <p>
                                                Western Syriac content is not currently available.
                                            </p>
                                        }

                                        @if (!string.IsNullOrWhiteSpace(Model.WesternPdfUrl))
                                        {
                                            <a class="btn btn-info mt-3"
                                               href="@Model.WesternPdfUrl"
                                               target="_blank"
                                               rel="noopener">
                                                <i class="fa fa-file-pdf-o"></i>
                                                Download PDF
                                            </a>
                                        }
                                    </div>
                                </div>
                            }

                            @if (hasEastern)
                            {
                                <div class="@colClass">
                                    <div class="well h-100 text-center"
                                         style="direction: rtl"
                                         id="eastern">
                                        <h3 class="padding-bottom-10"
                                            style="direction:ltr">
                                            Eastern Syriac
                                        </h3>
                                        <br>

                                        @if (!string.IsNullOrWhiteSpace(Model.EasternTitle))
                                        {
                                            <span class="Surit bold text-center">
                                                @Model.EasternTitle
                                            </span>
                                        }
                                        <br>

                                        @if (!string.IsNullOrWhiteSpace(Model.EasternIntroduction))
                                        {
                                            <p style="direction:ltr">@Model.EasternIntroduction</p>
                                        }

                                        @if (!string.IsNullOrWhiteSpace(Model.EasternBodyHtml))
                                        {
                                            <div class="Surit text-right">
                                                @Html.Raw(Model.EasternBodyHtml)
                                            </div>
                                        }
                                        else
                                        {
                                            <p>
                                                Eastern Syriac content is not currently available.
                                            </p>
                                        }

                                        @if (!string.IsNullOrWhiteSpace(Model.EasternPdfUrl))
                                        {
                                            <a class="btn btn-info mt-3"
                                               href="@Model.EasternPdfUrl"
                                               target="_blank"
                                               rel="noopener">
                                                <i class="fa fa-file-pdf-o"></i>
                                                Download PDF
                                            </a>
                                        }
                                    </div>
                                </div>
                            }

                            @if (hasEnglish)
                            {
                                <div class="@colClass">
                                    <div class="well h-100 text-center" id="english">
                                        <h3 class="padding-bottom-10" style="direction:ltr">
                                            English
                                        </h3>
                                        <br>
                                        @if (!string.IsNullOrWhiteSpace(Model.EnglishTitle))
                                        {
                                            <h4 class="bold text-center">
                                                @Model.EnglishTitle
                                            </h4>
                                        }
                                        <br>

                                        @if (!string.IsNullOrWhiteSpace(Model.EnglishIntroduction))
                                        {
                                            <p>@Model.EnglishIntroduction</p>
                                        }

                                        @if (!string.IsNullOrWhiteSpace(Model.EnglishBodyHtml))
                                        {
                                            <div class="text-start" style="direction:ltr; text-align:left;">
                                                @Html.Raw(Model.EnglishBodyHtml)
                                            </div>
                                        }
                                        else
                                        {
                                            <p>
                                                English content is not currently available.
                                            </p>
                                        }

                                        @if (!string.IsNullOrWhiteSpace(Model.EnglishPdfUrl))
                                        {
                                            <a class="btn btn-info mt-3"
                                               href="@Model.EnglishPdfUrl"
                                               target="_blank"
                                               rel="noopener">
                                                <i class="fa fa-file-pdf-o"></i>
                                                Download PDF
                                            </a>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(Model.EnglishCreditsHtml) ||
        !string.IsNullOrWhiteSpace(Model.WesternCreditsHtml) ||
        !string.IsNullOrWhiteSpace(Model.EasternCreditsHtml))
    {
        int activeCreditsCount = (!string.IsNullOrWhiteSpace(Model.EnglishCreditsHtml) ? 1 : 0)
            + (!string.IsNullOrWhiteSpace(Model.WesternCreditsHtml) ? 1 : 0)
            + (!string.IsNullOrWhiteSpace(Model.EasternCreditsHtml) ? 1 : 0);

        string creditsColClass = activeCreditsCount switch
        {
            3 => "col-lg-4 col-md-6 col-sm-12",
            2 => "col-md-6 col-sm-12",
            _ => "col-12"
        };

        <section>
            <div class="container">
                <div class="row">
                    <div class="col-md-12">
                        <div class="page-header">
                            <div class="page-title" style="color:black">
                                Credits
                            </div>
                        </div>

                        <div class="row">
                        

                            @if (!string.IsNullOrWhiteSpace(Model.WesternCreditsHtml))
                            {
                                <div class="@creditsColClass">
                                    <div class="well">
                                        <p>
                                            <strong>Western</strong>
                                        </p>
                                        <div>
                                            @Html.Raw(Model.WesternCreditsHtml)
                                        </div>
                                    </div>
                                </div>
                            }

                            @if (!string.IsNullOrWhiteSpace(Model.EasternCreditsHtml))
                            {
                                <div class="@creditsColClass">
                                    <div class="well">
                                        <p>
                                            <strong>Eastern</strong>
                                        </p>
                                        <div>
                                            @Html.Raw(Model.EasternCreditsHtml)
                                        </div>
                                    </div>
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(Model.EnglishCreditsHtml))
                            {
                                <div class="@creditsColClass">
                                    <div class="well">
                                        <p>
                                            <strong>English</strong>
                                        </p>
                                        <div>
                                            @Html.Raw(Model.EnglishCreditsHtml)
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </section>
    }
</div>
