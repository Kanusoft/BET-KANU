@model MagazineArticlePreviewViewModel
<link rel="stylesheet" href="~/css/dashboard.css">
<link rel="stylesheet" href="~/css/theme.css">

@{
    ViewBag.Title = $"Preview — {Model.Title}";

    bool HasContent(
        string? title,
        string? introduction,
        string? bodyHtml,
        string? creditsHtml,
        string? pdfUrl)
    {
        return !string.IsNullOrWhiteSpace(title)
            || !string.IsNullOrWhiteSpace(introduction)
            || !string.IsNullOrWhiteSpace(bodyHtml)
            || !string.IsNullOrWhiteSpace(creditsHtml)
            || !string.IsNullOrWhiteSpace(pdfUrl);
    }

    var hasEnglish = HasContent(
        Model.EnglishTitle,
        Model.EnglishIntroduction,
        Model.EnglishBodyHtml,
        Model.EnglishCreditsHtml,
        Model.EnglishPdfUrl);

    var hasWestern = HasContent(
        Model.WesternTitle,
        Model.WesternIntroduction,
        Model.WesternBodyHtml,
        Model.WesternCreditsHtml,
        Model.WesternPdfUrl);

    var hasEastern = HasContent(
        Model.EasternTitle,
        Model.EasternIntroduction,
        Model.EasternBodyHtml,
        Model.EasternCreditsHtml,
        Model.EasternPdfUrl);

    var activeLanguage = hasEnglish
        ? "english"
        : hasWestern
            ? "western"
            : hasEastern
                ? "eastern"
                : (string?)null;
}

<div id="wrapper">
    <section class="bg-grey-500 promo">
        <div class="container d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div>
                <h1 style="color:white" class="mb-1">
                    Article Preview
                </h1>
                <div style="color:white">
                    @Model.Title
                </div>
                <div class="mt-1">
                    @switch (Model.Status)
                    {
                        case MagazineArticleStatus.Published:
                            <span class="badge bg-success">Published</span>
                            break;
                        case MagazineArticleStatus.Scheduled:
                            <span class="badge bg-warning text-dark">Scheduled</span>
                            break;
                        case MagazineArticleStatus.Archived:
                            <span class="badge bg-dark">Archived</span>
                            break;
                        default:
                            <span class="badge bg-secondary">Draft</span>
                            break;
                    }
                </div>
            </div>

            <div class="d-flex flex-wrap gap-2">
                <a asp-action="Articles"
                   asp-route-magazineId="@Model.MagazineId"
                   class="btn btn-light">
                    <i class="fa-solid fa-arrow-left me-1" aria-hidden="true"></i>
                    Back to Articles
                </a>

                <a asp-action="EditArticle"
                   asp-route-id="@Model.Id"
                   class="btn btn-primary">
                    <i class="fa-solid fa-pen-to-square me-1" aria-hidden="true"></i>
                    Edit Article
                </a>
            </div>
        </div>
    </section>

    @{
        var desktopBanner = !string.IsNullOrWhiteSpace(Model.BannerImage)
            ? Model.BannerImage
            : Model.MobileBannerImage;
    }
    @if (!string.IsNullOrWhiteSpace(desktopBanner))
    {
        <section class="p-0">
            <div class="hero hero-game">
                <picture>
                    @if (!string.IsNullOrWhiteSpace(Model.MobileBannerImage))
                    {
                        <source media="(max-width: 767.98px)"
                                srcset="@Model.MobileBannerImage" />
                    }

                    <img src="@desktopBanner"
                         alt="Banner for @Model.Title" />
                </picture>
            </div>
        </section>
    }

    <section>
        <div class="container">
            <div class="row">
                <div class="col-lg-12">
                    <div class="post post-single">
                        <div class="post-header">
                            <div class="post-title">
                                <h2>@Model.Title</h2>

                                <ul class="post-meta">
                                    <li>
                                        <i class="fa fa-newspaper" aria-hidden="true"></i>
                                        @Model.MagazineTitle
                                    </li>

                                    @if (!string.IsNullOrWhiteSpace(Model.EditionTitle))
                                    {
                                        <li>
                                            <i class="fa fa-file-text" aria-hidden="true"></i>
                                            @Model.EditionTitle
                                        </li>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(Model.ArticleType))
                                    {
                                        <li>
                                            <i class="fa fa-book-open" aria-hidden="true"></i>
                                            @Model.ArticleType
                                        </li>
                                    }
                                </ul>
                            </div>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(Model.Summary))
                        {
                            <p>@Model.Summary</p>
                        }
                    </div>

                    @if (activeLanguage == null)
                    {
                        <div class="alert alert-info">
                            No language content has been added yet.
                        </div>
                    }
                    else
                    {
                        <ul class="nav nav-tabs mb-3" id="previewLanguageTabs" role="tablist">
                            @if (hasEnglish)
                            {
                                <li class="nav-item" role="presentation">
                                    <button class="nav-link @(activeLanguage == "english" ? "active" : null)"
                                            id="preview-english-tab"
                                            data-bs-toggle="tab"
                                            data-bs-target="#preview-english-panel"
                                            type="button"
                                            role="tab"
                                            aria-controls="preview-english-panel"
                                            aria-selected="@(activeLanguage == "english" ? "true" : "false")">
                                        English
                                    </button>
                                </li>
                            }

                            @if (hasWestern)
                            {
                                <li class="nav-item" role="presentation">
                                    <button class="nav-link @(activeLanguage == "western" ? "active" : null)"
                                            id="preview-western-tab"
                                            data-bs-toggle="tab"
                                            data-bs-target="#preview-western-panel"
                                            type="button"
                                            role="tab"
                                            aria-controls="preview-western-panel"
                                            aria-selected="@(activeLanguage == "western" ? "true" : "false")">
                                        Western Syriac
                                    </button>
                                </li>
                            }

                            @if (hasEastern)
                            {
                                <li class="nav-item" role="presentation">
                                    <button class="nav-link @(activeLanguage == "eastern" ? "active" : null)"
                                            id="preview-eastern-tab"
                                            data-bs-toggle="tab"
                                            data-bs-target="#preview-eastern-panel"
                                            type="button"
                                            role="tab"
                                            aria-controls="preview-eastern-panel"
                                            aria-selected="@(activeLanguage == "eastern" ? "true" : "false")">
                                        Eastern Syriac
                                    </button>
                                </li>
                            }
                        </ul>

                        <div class="tab-content" id="previewLanguageTabContent">
                            @if (hasEnglish)
                            {
                                <div class="tab-pane fade @(activeLanguage == "english" ? "show active" : null)"
                                     id="preview-english-panel"
                                     role="tabpanel"
                                     aria-labelledby="preview-english-tab">
                                    <div class="well">
                                        @if (!string.IsNullOrWhiteSpace(Model.EnglishTitle))
                                        {
                                            <h3 class="padding-bottom-10">@Model.EnglishTitle</h3>
                                        }

                                        @if (!string.IsNullOrWhiteSpace(Model.EnglishIntroduction))
                                        {
                                            <p>@Model.EnglishIntroduction</p>
                                        }

                                        @if (!string.IsNullOrWhiteSpace(Model.EnglishBodyHtml))
                                        {
                                            @Html.Raw(Model.EnglishBodyHtml)
                                        }

                                        @if (!string.IsNullOrWhiteSpace(Model.EnglishPdfUrl))
                                        {
                                            <a class="btn btn-info mt-3"
                                               href="@Model.EnglishPdfUrl"
                                               target="_blank"
                                               rel="noopener noreferrer">
                                                <i class="fa fa-file-pdf-o" aria-hidden="true"></i>
                                                View English PDF
                                            </a>
                                        }
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(Model.EnglishCreditsHtml))
                                    {
                                        <div class="well mt-3">
                                            <p><strong>Credits</strong></p>
                                            @Html.Raw(Model.EnglishCreditsHtml)
                                        </div>
                                    }
                                </div>
                            }

                            @if (hasWestern)
                            {
                                <div class="tab-pane fade @(activeLanguage == "western" ? "show active" : null)"
                                     id="preview-western-panel"
                                     role="tabpanel"
                                     aria-labelledby="preview-western-tab">
                                    <div class="well text-center"
                                         style="direction: rtl"
                                         id="western">
                                        <h3 class="padding-bottom-10"
                                            style="direction:ltr">
                                            Western Syriac
                                        </h3>

                                        @if (!string.IsNullOrWhiteSpace(Model.WesternTitle))
                                        {
                                            <span class="Surayt bold text-center">
                                                @Model.WesternTitle
                                            </span>
                                        }

                                        @if (!string.IsNullOrWhiteSpace(Model.WesternIntroduction))
                                        {
                                            <p style="direction:ltr">@Model.WesternIntroduction</p>
                                        }

                                        @if (!string.IsNullOrWhiteSpace(Model.WesternBodyHtml))
                                        {
                                            @Html.Raw(Model.WesternBodyHtml)
                                        }

                                        @if (!string.IsNullOrWhiteSpace(Model.WesternPdfUrl))
                                        {
                                            <a class="btn btn-info mt-3"
                                               href="@Model.WesternPdfUrl"
                                               target="_blank"
                                               rel="noopener noreferrer">
                                                <i class="fa fa-file-pdf-o" aria-hidden="true"></i>
                                                View PDF
                                            </a>
                                        }
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(Model.WesternCreditsHtml))
                                    {
                                        <div class="well mt-3">
                                            <p><strong>Western Credits</strong></p>
                                            @Html.Raw(Model.WesternCreditsHtml)
                                        </div>
                                    }
                                </div>
                            }

                            @if (hasEastern)
                            {
                                <div class="tab-pane fade @(activeLanguage == "eastern" ? "show active" : null)"
                                     id="preview-eastern-panel"
                                     role="tabpanel"
                                     aria-labelledby="preview-eastern-tab">
                                    <div class="well text-center"
                                         style="direction: rtl"
                                         id="eastern">
                                        <h3 class="padding-bottom-10"
                                            style="direction:ltr">
                                            Eastern Syriac
                                        </h3>

                                        @if (!string.IsNullOrWhiteSpace(Model.EasternTitle))
                                        {
                                            <span class="Surit bold text-center">
                                                @Model.EasternTitle
                                            </span>
                                        }

                                        @if (!string.IsNullOrWhiteSpace(Model.EasternIntroduction))
                                        {
                                            <p style="direction:ltr">@Model.EasternIntroduction</p>
                                        }

                                        @if (!string.IsNullOrWhiteSpace(Model.EasternBodyHtml))
                                        {
                                            @Html.Raw(Model.EasternBodyHtml)
                                        }

                                        @if (!string.IsNullOrWhiteSpace(Model.EasternPdfUrl))
                                        {
                                            <a class="btn btn-info mt-3"
                                               href="@Model.EasternPdfUrl"
                                               target="_blank"
                                               rel="noopener noreferrer">
                                                <i class="fa fa-file-pdf-o" aria-hidden="true"></i>
                                                View PDF
                                            </a>
                                        }
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(Model.EasternCreditsHtml))
                                    {
                                        <div class="well mt-3">
                                            <p><strong>Eastern Credits</strong></p>
                                            @Html.Raw(Model.EasternCreditsHtml)
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </section>
</div>
