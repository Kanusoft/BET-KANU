@model BetKanu.Models.ViewModels.MagazineFormViewModel
<link href="~/plugins/fileuploads/css/dropify.css" rel="stylesheet" type="text/css" />
<link rel="stylesheet" href="~/css/dashboard.css">
@{
    ViewBag.Title = "Edit Magazine";
}

<div id="wrapper">
    <section class="bg-grey-500 promo">
        <div class="container">
            <h1 style="color:white">&nbsp;Edit Magazine &mdash; @Model.Title</h1>
        </div>
    </section>

    <section>
        <div class="container py-4">
            <form id="magazineForm"
                  asp-action="Edit"
                  asp-route-id="@Model.Id"
                  method="post"
                  enctype="multipart/form-data"
                  novalidate>
                @Html.AntiForgeryToken()

                <partial name="_MagazineForm" model="Model" />

                <div class="row g-3 justify-content-end mt-3">
                    <div class="col-sm-6 col-md-3">
                        <a asp-action="Index" class="btn btn-secondary w-100">
                            Cancel
                        </a>
                    </div>
                    <div class="col-sm-6 col-md-3">
                        <button type="submit"
                                id="magazineSubmitBtn"
                                class="btn btn-Create w-100">
                            <span class="btn-text">Save Changes</span>
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </section>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <!-- file uploads js -->
    <script src="~/plugins/fileuploads/js/dropify.js"></script>
    <script>
        $(document).ready(function () {
            $('.dropify').dropify({
                messages: {
                    'default': 'Drag and drop a file here or click',
                    'replace': 'Drag and drop or click to replace',
                    'remove': 'Remove',
                    'error': 'Ooops, something wrong happened.'
                },
                error: {
                    'fileSize': 'The file size is too big (5M max).'
                }
            });
        });
    </script>

    <script>
        (function () {
            var form = document.getElementById('magazineForm');
            var submitBtn = document.getElementById('magazineSubmitBtn');
            var btnText = submitBtn ? submitBtn.querySelector('.btn-text') : null;
            var defaultLabel = 'Save Changes';

            if (!form || !submitBtn || !btnText) {
                return;
            }

            form.addEventListener('submit', function () {
                if (!form.checkValidity()) {
                    return;
                }

                if (window.jQuery && typeof window.jQuery(form).valid === 'function' &&
                    !window.jQuery(form).valid()) {
                    return;
                }

                submitBtn.disabled = true;
                btnText.textContent = 'Saving...';
            });

            form.addEventListener('invalid', function () {
                submitBtn.disabled = false;
                btnText.textContent = defaultLabel;
            }, true);

            if (window.jQuery) {
                window.jQuery(form).on('invalid-form.validate', function () {
                    submitBtn.disabled = false;
                    btnText.textContent = defaultLabel;
                });
            }
        })();
    </script>
}
