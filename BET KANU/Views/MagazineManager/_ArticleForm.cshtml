@model BetKanu.Models.ViewModels.MagazineArticles.MagazineArticleFormViewModel

<input asp-for="Id" type="hidden" />
<input asp-for="MagazineId" type="hidden" />
<input asp-for="ExistingBannerImage" type="hidden" />
<input asp-for="ExistingBannerImage350" type="hidden" />
<input asp-for="ExistingEnglishPdfPath" type="hidden" />
<input asp-for="ExistingWesternPdfPath" type="hidden" />
<input asp-for="ExistingEasternPdfPath" type="hidden" />

<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

<ul class="nav nav-tabs mb-3" id="articleFormTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active"
                id="general-tab"
                data-bs-toggle="tab"
                data-bs-target="#general-panel"
                type="button"
                role="tab"
                aria-controls="general-panel"
                aria-selected="true">
            General
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link"
                id="english-tab"
                data-bs-toggle="tab"
                data-bs-target="#english-panel"
                type="button"
                role="tab"
                aria-controls="english-panel"
                aria-selected="false">
            English
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link"
                id="western-tab"
                data-bs-toggle="tab"
                data-bs-target="#western-panel"
                type="button"
                role="tab"
                aria-controls="western-panel"
                aria-selected="false">
            Western
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link"
                id="eastern-tab"
                data-bs-toggle="tab"
                data-bs-target="#eastern-panel"
                type="button"
                role="tab"
                aria-controls="eastern-panel"
                aria-selected="false">
            Eastern
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link"
                id="publication-tab"
                data-bs-toggle="tab"
                data-bs-target="#publication-panel"
                type="button"
                role="tab"
                aria-controls="publication-panel"
                aria-selected="false">
            Publication
        </button>
    </li>
</ul>

<div class="tab-content" id="articleFormTabContent">
    <div class="tab-pane fade show active"
         id="general-panel"
         role="tabpanel"
         aria-labelledby="general-tab">
        <div class="row g-3">
            <div class="col-md-8">
                <div class="form-group mb-3">
                    <label asp-for="Title" class="form-label"></label>
                    <input asp-for="Title" class="form-control" />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-group mb-3">
                    <label asp-for="ArticleNumber" class="form-label"></label>
                    <input asp-for="ArticleNumber" class="form-control" type="number" min="1" />
                    <span asp-validation-for="ArticleNumber" class="text-danger"></span>
                </div>
            </div>
            <div class="col-12">
                <div class="form-group mb-3">
                    <label asp-for="ShortDescription" class="form-label"></label>
                    <textarea asp-for="ShortDescription" class="form-control" rows="6"></textarea>
                    <span asp-validation-for="ShortDescription" class="text-danger"></span>
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-group mb-3">
                    <label asp-for="DisplayOrder" class="form-label"></label>
                    <input asp-for="DisplayOrder" class="form-control" type="number" min="0" />
                    <span asp-validation-for="DisplayOrder" class="text-danger"></span>
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-group mb-3">
                    <label asp-for="ReleaseDate" class="form-label"></label>
                    <input asp-for="ReleaseDate" class="form-control" type="date" />
                    <span asp-validation-for="ReleaseDate" class="text-danger"></span>
                </div>
            </div>
            <div class="col-12">
                <div class="form-group mb-4">
                    <label for="BannerImageFile" class="control-label">
                        Desktop Banner Image — 1920 × 700
                    </label>

                    <input asp-for="BannerImageFile"
                           class="dropify"
                           type="file"
                           accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
                           id="BannerImageFile"
                           data-height="200"
                           data-max-file-size="5M"
                           data-allowed-file-extensions="jpg jpeg png webp"
                           data-default-file="@(Model.IsEdit? Model.ExistingBannerImage: "")"
                           aria-describedby="bannerFileHelp bannerPreviewError" />

                    <div id="bannerFileHelp" class="form-text">
                        JPG, JPEG, PNG, or WEBP. Maximum size: 5 MB. Used on desktop screens.
                    </div>

                    <span asp-validation-for="BannerImageFile"
                          class="text-danger"></span>

                    <div id="bannerPreviewError"
                         class="text-danger small mt-1"
                         role="alert"
                         aria-live="polite"></div>
                </div>

                <div class="form-group">
                    <label for="BannerImage350File" class="control-label">
                        Mobile Banner Image — 1920 × 350
                    </label>

                    <input asp-for="BannerImage350File"
                           class="dropify"
                           type="file"
                           accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
                           id="BannerImage350File"
                           data-height="160"
                           data-max-file-size="5M"
                           data-allowed-file-extensions="jpg jpeg png webp"
                           data-default-file="@(Model.IsEdit? Model.ExistingBannerImage350: "")"
                           aria-describedby="banner350FileHelp banner350PreviewError" />

                    <div id="banner350FileHelp" class="form-text">
                        JPG, JPEG, PNG, or WEBP. Maximum size: 5 MB. Used on small screens.
                    </div>

                    <span asp-validation-for="BannerImage350File"
                          class="text-danger"></span>

                    <div id="banner350PreviewError"
                         class="text-danger small mt-1"
                         role="alert"
                         aria-live="polite"></div>
                </div>
            </div>
        </div>
    </div>

    <div class="tab-pane fade"
         id="english-panel"
         role="tabpanel"
         aria-labelledby="english-tab">
        <div class="row g-3">
            <div class="col-12">
                <div class="form-group mb-3">
                    <label asp-for="EnglishTitle" class="form-label"></label>
                    <input asp-for="EnglishTitle" class="form-control" />
                    <span asp-validation-for="EnglishTitle" class="text-danger"></span>
                </div>
            </div>
            <div class="col-12">
                <div class="form-group mb-3">
                    <label asp-for="EnglishIntroduction" class="form-label"></label>
                    <textarea asp-for="EnglishIntroduction"
                              class="form-control"
                              rows="6"></textarea>
                    <span asp-validation-for="EnglishIntroduction" class="text-danger"></span>
                </div>
            </div>
            <div class="col-12">
                <div class="form-group mb-3">
                    <label asp-for="EnglishBodyHtml" class="form-label"></label>
                    <textarea asp-for="EnglishBodyHtml"
                              class="form-control font-monospace"
                              rows="15"></textarea>
                    <span asp-validation-for="EnglishBodyHtml" class="text-danger"></span>
                </div>
            </div>
            <div class="col-12">
                <div class="form-group mb-3">
                    <label asp-for="EnglishCreditsHtml" class="form-label"></label>
                    <textarea asp-for="EnglishCreditsHtml"
                              class="form-control font-monospace"
                              rows="8"></textarea>
                    <span asp-validation-for="EnglishCreditsHtml" class="text-danger"></span>
                </div>
            </div>
            <div class="col-12">
                @if (Model.IsEdit && !string.IsNullOrWhiteSpace(Model.ExistingEnglishPdfPath))
                {
                    <div class="mb-3">
                        <p class="form-label mb-2">Current English PDF</p>
                        <a href="@Model.ExistingEnglishPdfPath"
                           target="_blank"
                           rel="noopener noreferrer"
                           class="btn btn-sm btn-outline-primary">
                            <i class="fa-solid fa-file-pdf me-1" aria-hidden="true"></i>
                            View current PDF
                        </a>
                        <p class="form-text mb-0 mt-2">
                            Uploading a new PDF will replace the current file.
                        </p>
                    </div>
                }

                <div class="form-group mb-0">
                    <label asp-for="EnglishPdfFile" class="form-label"></label>

                    <input asp-for="EnglishPdfFile"
                           class="form-control article-pdf-input"
                           type="file"
                           accept=".pdf,application/pdf"
                           id="EnglishPdfFile"
                           data-max-file-size-bytes="26214400"
                           aria-describedby="englishPdfHelp englishPdfPreviewError" />

                    <div id="englishPdfHelp" class="form-text">
                        PDF files only. Maximum size: 25 MB.
                    </div>

                    <span asp-validation-for="EnglishPdfFile"
                          class="text-danger"></span>

                    <div id="englishPdfPreviewError"
                         class="text-danger small mt-1"
                         role="alert"
                         aria-live="polite"></div>
                </div>
            </div>
        </div>
    </div>

    <div class="tab-pane fade"
         id="western-panel"
         role="tabpanel"
         aria-labelledby="western-tab">
        <div class="row g-3">
            <div class="col-12">
                <div class="form-group mb-3">
                    <label asp-for="WesternTitle" class="form-label"></label>
                    <input asp-for="WesternTitle" class="form-control" />
                    <span asp-validation-for="WesternTitle" class="text-danger"></span>
                </div>
            </div>
            <div class="col-12">
                <div class="form-group mb-3">
                    <label asp-for="WesternIntroduction" class="form-label"></label>
                    <textarea asp-for="WesternIntroduction" class="form-control" rows="6"></textarea>
                    <span asp-validation-for="WesternIntroduction" class="text-danger"></span>
                </div>
            </div>
            <div class="col-12">
                <div class="form-group mb-3">
                    <label asp-for="WesternBodyHtml" class="form-label"></label>
                    <textarea asp-for="WesternBodyHtml" class="form-control font-monospace" rows="15"></textarea>
                    <span asp-validation-for="WesternBodyHtml" class="text-danger"></span>
                </div>
            </div>
            <div class="col-12">
                <div class="form-group mb-3">
                    <label asp-for="WesternCreditsHtml" class="form-label"></label>
                    <textarea asp-for="WesternCreditsHtml" class="form-control font-monospace" rows="8"></textarea>
                    <span asp-validation-for="WesternCreditsHtml" class="text-danger"></span>
                </div>
            </div>
            <div class="col-12">
                @if (Model.IsEdit && !string.IsNullOrWhiteSpace(Model.ExistingWesternPdfPath))
                {
                    <div class="mb-3">
                        <p class="form-label mb-2">Current Western PDF</p>
                        <a href="@Model.ExistingWesternPdfPath"
                           target="_blank"
                           rel="noopener noreferrer"
                           class="btn btn-sm btn-outline-primary">
                            <i class="fa-solid fa-file-pdf me-1" aria-hidden="true"></i>
                            View current PDF
                        </a>
                        <p class="form-text mb-0 mt-2">
                            Uploading a new PDF will replace the current file.
                        </p>
                    </div>
                }

                <div class="form-group mb-0">
                    <label asp-for="WesternPdfFile" class="form-label"></label>

                    <input asp-for="WesternPdfFile"
                           class="form-control article-pdf-input"
                           type="file"
                           accept=".pdf,application/pdf"
                           id="WesternPdfFile"
                           data-max-file-size-bytes="26214400"
                           aria-describedby="westernPdfHelp westernPdfPreviewError" />

                    <div id="westernPdfHelp" class="form-text">
                        PDF files only. Maximum size: 25 MB.
                    </div>

                    <span asp-validation-for="WesternPdfFile"
                          class="text-danger"></span>

                    <div id="westernPdfPreviewError"
                         class="text-danger small mt-1"
                         role="alert"
                         aria-live="polite"></div>
                </div>
            </div>
        </div>
    </div>

    <div class="tab-pane fade"
         id="eastern-panel"
         role="tabpanel"
         aria-labelledby="eastern-tab">
        <div class="row g-3">
            <div class="col-12">
                <div class="form-group mb-3">
                    <label asp-for="EasternTitle" class="form-label"></label>
                    <input asp-for="EasternTitle" class="form-control" />
                    <span asp-validation-for="EasternTitle" class="text-danger"></span>
                </div>
            </div>
            <div class="col-12">
                <div class="form-group mb-3">
                    <label asp-for="EasternIntroduction" class="form-label"></label>
                    <textarea asp-for="EasternIntroduction" class="form-control" rows="6"></textarea>
                    <span asp-validation-for="EasternIntroduction" class="text-danger"></span>
                </div>
            </div>
            <div class="col-12">
                <div class="form-group mb-3">
                    <label asp-for="EasternBodyHtml" class="form-label"></label>
                    <textarea asp-for="EasternBodyHtml" class="form-control font-monospace" rows="15"></textarea>
                    <span asp-validation-for="EasternBodyHtml" class="text-danger"></span>
                </div>
            </div>
            <div class="col-12">
                <div class="form-group mb-3">
                    <label asp-for="EasternCreditsHtml" class="form-label"></label>
                    <textarea asp-for="EasternCreditsHtml" class="form-control font-monospace" rows="8"></textarea>
                    <span asp-validation-for="EasternCreditsHtml" class="text-danger"></span>
                </div>
            </div>
            <div class="col-12">
                @if (Model.IsEdit && !string.IsNullOrWhiteSpace(Model.ExistingEasternPdfPath))
                {
                    <div class="mb-3">
                        <p class="form-label mb-2">Current Eastern PDF</p>
                        <a href="@Model.ExistingEasternPdfPath"
                           target="_blank"
                           rel="noopener noreferrer"
                           class="btn btn-sm btn-outline-primary">
                            <i class="fa-solid fa-file-pdf me-1" aria-hidden="true"></i>
                            View current PDF
                        </a>
                        <p class="form-text mb-0 mt-2">
                            Uploading a new PDF will replace the current file.
                        </p>
                    </div>
                }

                <div class="form-group mb-0">
                    <label asp-for="EasternPdfFile" class="form-label"></label>

                    <input asp-for="EasternPdfFile"
                           class="form-control article-pdf-input"
                           type="file"
                           accept=".pdf,application/pdf"
                           id="EasternPdfFile"
                           data-max-file-size-bytes="26214400"
                           aria-describedby="easternPdfHelp easternPdfPreviewError" />

                    <div id="easternPdfHelp" class="form-text">
                        PDF files only. Maximum size: 25 MB.
                    </div>

                    <span asp-validation-for="EasternPdfFile"
                          class="text-danger"></span>

                    <div id="easternPdfPreviewError"
                         class="text-danger small mt-1"
                         role="alert"
                         aria-live="polite"></div>
                </div>
            </div>
        </div>
    </div>

    <div class="tab-pane fade"
         id="publication-panel"
         role="tabpanel"
         aria-labelledby="publication-tab">
        <div class="row g-3">
            <div class="col-md-6">
                <div class="form-group mb-3">
                    <label asp-for="Status" class="form-label"></label>
                    <select asp-for="Status"
                            asp-items="Html.GetEnumSelectList<MagazineArticleStatus>()"
                            class="form-select"
                            id="ArticleStatus"></select>
                    <span asp-validation-for="Status" class="text-danger"></span>
                </div>
            </div>
            <div class="col-md-6" id="publishAtGroup">
                <div class="form-group mb-0">
                    <label asp-for="PublishAtUtc" class="form-label"></label>
                    <input asp-for="PublishAtUtc"
                           class="form-control"
                           type="datetime-local"
                           id="PublishAtUtc" />
                    <div class="form-text" id="publishAtHelp">
                        Leave empty when publishing to use the current UTC date.
                    </div>
                    <span asp-validation-for="PublishAtUtc" class="text-danger"></span>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .card {
        background-color: #3e4966 !important;
        border: 1px solid rgba(255, 255, 255, 0.05) !important;
    }
    .card-header {
        border-bottom: 1px solid rgba(255, 255, 255, 0.05) !important;
        background-color: transparent !important;
    }
    .card-title {
        color: #fff !important;
    }
    .card label, .card .control-label, .card .form-label {
        color: #fff !important;
    }
    .card .form-control, .card .form-select {
        color: #8f98c1 !important;
        background-color: #424b65 !important;
        border: 1px solid rgba(255, 255, 255, 0.05) !important;
    }
    .card .form-control:focus, .card .form-select:focus {
        color: #fff !important;
        background-color: #424b65 !important;
        border-color: #4eceb2 !important;
        box-shadow: none !important;
    }
    .card .form-text {
        color: #7984a0 !important;
    }
    .card .text-danger {
        color: #ff5b5b !important;
    }
    
    /* Tabs content styling */
    #articleFormTabContent, .tab-content, .tab-pane {
        background-color: transparent !important;
        background: transparent !important;
        border: none !important;
        box-shadow: none !important;
        padding: 0 !important;
    }
    
    /* Tabs headers styling */
    #articleFormTabs {
        border-bottom: 1px solid rgba(255, 255, 255, 0.05) !important;
        margin-bottom: 1.5rem !important;
    }
    #articleFormTabs .nav-item {
        margin-bottom: -1px !important;
    }
    #articleFormTabs .nav-link {
        color: #8f98c1 !important;
        background-color: #424b65 !important;
        border: 1px solid rgba(255, 255, 255, 0.05) !important;
        border-bottom: none !important;
        margin-right: 5px !important;
        border-radius: 4px 4px 0 0 !important;
        padding: 10px 20px !important;
        font-weight: 500 !important;
        transition: all 0.2s ease-in-out !important;
    }
    #articleFormTabs .nav-link:hover {
        color: #fff !important;
        background-color: #4e5978 !important;
    }
    #articleFormTabs .nav-link.active {
        color: #fff !important;
        background-color: #0d5487 !important;
        border-color: rgba(255, 255, 255, 0.1) !important;
    }
    
    .article-form-banner-preview {
        width: 100%;
        max-width: 320px;
        height: 180px;
        object-fit: cover;
        border-radius: 4px;
        border: 1px solid rgba(255, 255, 255, 0.1) !important;
        display: block;
    }

    #publishAtGroup.is-disabled {
        opacity: 0.55;
    }

    #publishAtGroup.is-disabled input {
        pointer-events: none;
        background-color: #2d3448 !important;
        color: #5d667c !important;
    }
</style>

<script>
    (function () {
        'use strict';

        const bannerInput = document.getElementById('BannerImageFile');
        const banner350Input = document.getElementById('BannerImage350File');
        const englishPdfInput = document.getElementById('EnglishPdfFile');
        const westernPdfInput = document.getElementById('WesternPdfFile');
        const easternPdfInput = document.getElementById('EasternPdfFile');

        const bannerError = document.getElementById('bannerPreviewError');
        const banner350Error = document.getElementById('banner350PreviewError');
        const englishPdfError = document.getElementById('englishPdfPreviewError');
        const westernPdfError = document.getElementById('westernPdfPreviewError');
        const easternPdfError = document.getElementById('easternPdfPreviewError');

        const maxImageSizeBytes = 5 * 1024 * 1024;
        const maxPdfSizeBytes = 25 * 1024 * 1024;

        const allowedImageExtensions = ['jpg', 'jpeg', 'png', 'webp'];
        const allowedImageMimeTypes = [
            'image/jpeg',
            'image/png',
            'image/webp'
        ];

        function getExtension(fileName) {
            const lastDotIndex = fileName.lastIndexOf('.');

            if (lastDotIndex < 0) {
                return '';
            }

            return fileName
                .substring(lastDotIndex + 1)
                .toLowerCase();
        }

        function formatFileSize(bytes) {
            return (bytes / 1024 / 1024).toFixed(1) + ' MB';
        }

        function setFileError(input, errorElement, message) {
            if (errorElement) {
                errorElement.textContent = message || '';
            }

            if (input) {
                input.classList.toggle('is-invalid', Boolean(message));
                input.setCustomValidity(message || '');
            }
        }

        function clearSelectedFile(input) {
            if (!input) {
                return;
            }

            input.value = '';

            // Refresh Dropify when the banner file is rejected.
            if (window.jQuery && window.jQuery(input).data('dropify')) {
                const dropify = window.jQuery(input).data('dropify');
                dropify.resetPreview();
                dropify.clearElement();
            }
        }

        function validateImageInput(input, errorElement) {
            setFileError(input, errorElement, '');

            const file = input?.files?.[0];

            if (!file) {
                return true;
            }

            const extension = getExtension(file.name);
            const validExtension =
                allowedImageExtensions.includes(extension);

            const validMimeType =
                !file.type ||
                allowedImageMimeTypes.includes(file.type);

            if (!validExtension || !validMimeType) {
                const message =
                    'Only JPG, JPEG, PNG, and WEBP images are allowed.';

                setFileError(input, errorElement, message);
                clearSelectedFile(input);
                return false;
            }

            if (file.size > maxImageSizeBytes) {
                const message =
                    `The banner image is ${formatFileSize(file.size)}. ` +
                    'The maximum allowed size is 5 MB.';

                setFileError(input, errorElement, message);
                clearSelectedFile(input);
                return false;
            }

            return true;
        }

        function validatePdfInput(input, errorElement) {
            setFileError(input, errorElement, '');

            const file = input?.files?.[0];

            if (!file) {
                return true;
            }

            const extension = getExtension(file.name);

            // Some browsers may provide an empty MIME type,
            // so extension validation remains necessary.
            const validMimeType =
                !file.type ||
                file.type === 'application/pdf';

            if (extension !== 'pdf' || !validMimeType) {
                const message = 'Only PDF files are allowed.';

                setFileError(input, errorElement, message);
                clearSelectedFile(input);
                return false;
            }

            if (file.size > maxPdfSizeBytes) {
                const message =
                    `The selected PDF is ${formatFileSize(file.size)}. ` +
                    'The maximum allowed size is 25 MB.';

                setFileError(input, errorElement, message);
                clearSelectedFile(input);
                return false;
            }

            return true;
        }

        bannerInput?.addEventListener('change', function () {
            validateImageInput(bannerInput, bannerError);
        });

        banner350Input?.addEventListener('change', function () {
            validateImageInput(banner350Input, banner350Error);
        });

        englishPdfInput?.addEventListener('change', function () {
            validatePdfInput(englishPdfInput, englishPdfError);
        });

        westernPdfInput?.addEventListener('change', function () {
            validatePdfInput(westernPdfInput, westernPdfError);
        });

        easternPdfInput?.addEventListener('change', function () {
            validatePdfInput(easternPdfInput, easternPdfError);
        });

        window.articleFileValidation = {
            validateAll: function () {
                const bannerIsValid =
                    validateImageInput(bannerInput, bannerError);

                const banner350IsValid =
                    validateImageInput(banner350Input, banner350Error);

                const englishPdfIsValid =
                    validatePdfInput(englishPdfInput, englishPdfError);

                const westernPdfIsValid =
                    validatePdfInput(westernPdfInput, westernPdfError);

                const easternPdfIsValid =
                    validatePdfInput(easternPdfInput, easternPdfError);

                return bannerIsValid &&
                    banner350IsValid &&
                    englishPdfIsValid &&
                    westernPdfIsValid &&
                    easternPdfIsValid;
            }
        };
    })();
</script>
