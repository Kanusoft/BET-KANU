@model BetKanu.Models.ViewModels.MagazineArticles.MagazineArticlesIndexViewModel
<link rel="stylesheet" href="~/css/dashboard.css">
<link href="~/plugins/fileuploads/css/dropify.css" rel="stylesheet" type="text/css" />

@{
    ViewBag.Title = $"Articles — {Model.MagazineTitle}";
}

<div id="wrapper">
    <section class="bg-success promo">
        <div class="container">
            <h1 style="color:white">&nbsp;@Model.MagazineTitle — Articles</h1>
        </div>
    </section>

    <section>
        <div class="container py-4">
            <partial name="_DashboardMessages" />

            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-start gap-3 mb-4">
                <div>
                    <p class="mb-1">
                        <span class="text-muted">Magazine status:</span>
                        @if (Model.MagazineIsPublished)
                        {
                            <span class="badge bg-success">Published</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Draft</span>
                        }
                    </p>
                    <p class="mb-0 text-muted">
                        @Model.Articles.Count article@(Model.Articles.Count == 1 ? "" : "s") in this magazine.
                    </p>
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fa-solid fa-arrow-left me-1" aria-hidden="true"></i>
                        Back to Magazines
                    </a>
                    <a asp-action="CreateArticle"
                       asp-route-magazineId="@Model.MagazineId"
                       class="btn btn-Create">
                        <i class="fa-solid fa-plus me-1" aria-hidden="true"></i>
                        Add Article
                    </a>
                </div>
            </div>

            <div class="card">
                <div class="card-body">
                    @if (Model.Articles == null || !Model.Articles.Any())
                    {
                        <div class="text-center py-5">
                            <i class="fa-solid fa-newspaper fa-3x text-muted mb-3" aria-hidden="true"></i>
                            <h2 class="h5 mb-2">No articles yet</h2>
                            <p class="text-muted mb-4">
                                Add the first article to this magazine.
                            </p>
                            <a asp-action="CreateArticle"
                               asp-route-magazineId="@Model.MagazineId"
                               class="btn btn-Create">
                                <i class="fa-solid fa-plus me-1" aria-hidden="true"></i>
                                Add Article
                            </a>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-bordered align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th scope="col" style="color:white">Banner</th>
                                        <th scope="col" style="color:white">Article Number</th>
                                        <th scope="col" style="color:white">Title</th>
                                        <th scope="col" style="color:white">Release Date</th>
                                        <th scope="col" style="color:white">Display Order</th>
                                        <th scope="col" style="color:white">Status</th>
                                        <th scope="col" style="color:white">Publish Date</th>
                                        <th scope="col" style="color:white">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var article in Model.Articles)
                                    {
                                        <tr>
                                            <td>
                                                @if (!string.IsNullOrWhiteSpace(article.BannerImage))
                                                {
                                                    <img src="@article.BannerImage"
                                                         alt="Banner for @article.Title"
                                                         class="article-banner-thumb" />
                                                }
                                                else
                                                {
                                                    <div class="article-banner-placeholder" aria-hidden="true">
                                                        <i class="fa-solid fa-image"></i>
                                                    </div>
                                                }
                                            </td>
                                            <td>@article.ArticleNumber</td>
                                            <td>
                                                <div class="fw-semibold">@article.Title</div>
                                                <small class="text-muted">@article.Slug</small>
                                            </td>
                                            <td>@article.ReleaseDate.ToString("MMM d, yyyy")</td>
                                            <td>@article.DisplayOrder</td>
                                            <td>
                                                @switch (article.Status)
                                                {
                                                    case MagazineArticleStatus.Published:
                                                        <span class="badge bg-success">Published</span>
                                                        break;
                                                    case MagazineArticleStatus.Scheduled:
                                                        <span class="badge bg-warning text-dark">Scheduled</span>
                                                        break;
                                                    case MagazineArticleStatus.Archived:
                                                        <span class="badge bg-dark">Archived</span>
                                                        break;
                                                    default:
                                                        <span class="badge bg-secondary">Draft</span>
                                                        break;
                                                }
                                            </td>
                                            <td>
                                                @if (article.PublishAtUtc.HasValue)
                                                {
                                                    @article.PublishAtUtc.Value.ToString("MMM d, yyyy HH:mm") <text> UTC</text>
                                                }
                                                else
                                                {
                                                    <span aria-label="No publish date">&mdash;</span>
                                                }
                                            </td>
                                            <td>
                                                <div class="d-flex flex-wrap gap-1">
                                                    <button type="button"
                                                            class="btn btn-sm btn-outline-secondary"
                                                            disabled
                                                            title="Public preview coming soon">
                                                        <i class="fa-solid fa-eye me-1" aria-hidden="true"></i>
                                                        Preview
                                                    </button>
                                                    <a asp-action="EditArticle"
                                                       asp-route-id="@article.Id"
                                                       class="btn btn-sm btn-primary">
                                                        <i class="fa-solid fa-pen-to-square me-1" aria-hidden="true"></i>
                                                        Edit
                                                    </a>
                                                    <button type="button"
                                                            class="btn btn-sm btn-danger"
                                                            data-bs-toggle="modal"
                                                            data-bs-target="#deleteArticleModal"
                                                            data-article-id="@article.Id"
                                                            data-article-title="@article.Title"
                                                            aria-label="Delete @article.Title">
                                                        <i class="fa-solid fa-trash-can me-1" aria-hidden="true"></i>
                                                        Delete
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </section>
</div>

<div class="modal fade"
     id="deleteArticleModal"
     tabindex="-1"
     aria-labelledby="deleteArticleModalLabel"
     aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title fs-5" id="deleteArticleModalLabel">Delete Article</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>
                    Are you sure you want to delete
                    <strong id="deleteArticleTitle"></strong>?
                </p>
                <p class="text-muted mb-0">This action cannot be undone.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <form asp-action="DeleteArticle" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="deleteArticleId" value="" />
                    <button type="submit" class="btn btn-danger">
                        <i class="fa-solid fa-trash-can me-1" aria-hidden="true"></i>
                        Delete
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    .table td {
        vertical-align: middle !important;
    }

    .article-banner-thumb {
        height: 120px;
        object-fit: contain;
        border-radius: 6px;
        display: block;
    }

    .article-banner-placeholder {
        width: 120px;
        height: 120px;
        border-radius: 6px;
        background-color: #2d3448 !important;
        color: #6c757d;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2.5rem;
        box-shadow: 0 4px 6px rgba(0,0,0,0.15);
    }

    /* Modal styling for dark theme */
    #deleteArticleModal .modal-content {
        background-color: #3e4966 !important;
        border: 1px solid rgba(255, 255, 255, 0.05) !important;
        color: #fff !important;
    }
    #deleteArticleModal .modal-header,
    #deleteArticleModal .modal-footer {
        border-color: rgba(255, 255, 255, 0.05) !important;
    }
    #deleteArticleModal .modal-title {
        color: #fff !important;
    }
    #deleteArticleModal p {
        color: #fff !important;
    }
    #deleteArticleModal .text-muted {
        color: #8f98c1 !important;
    }
    #deleteArticleModal .btn-close {
        filter: invert(1) !important;
    }
</style>

@section Scripts {
    <script>
        (function () {
            var modal = document.getElementById('deleteArticleModal');
            if (!modal) {
                return;
            }

            modal.addEventListener('show.bs.modal', function (event) {
                var button = event.relatedTarget;
                if (!button) {
                    return;
                }

                document.getElementById('deleteArticleId').value =
                    button.getAttribute('data-article-id') || '';
                document.getElementById('deleteArticleTitle').textContent =
                    button.getAttribute('data-article-title') || '';
            });
        })();
    </script>
}
