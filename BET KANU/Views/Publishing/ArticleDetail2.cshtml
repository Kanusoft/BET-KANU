                        <!-- Eastern -->
                        <div class=" col-md-6 col-sm-12">
                            <div class="well h-100 text-center" style="direction: rtl" id="eastern">
                                <h3 class="padding-bottom-10" style="direction:ltr">Eastern Syriac</h3>
                                <p class="Surit text-right">
                                    <span class="bold">ܩܵܢܘܿܢܹ̈ܐ ܕܲܒܢܹܐ ܠܲܝܗܝ ܠܲܡܕܝܼܢܵܝܘܼܬܵܐ</span><br>
                                    <br>

                                    <span class="bold">ܥܘܼܬܵܕܵܐ:</span><br>
                                    <span>ܡܨܲܠܡܸܢ ܠܥܵܠܡܵܐ ܕܠܵܐ ܩܵܢܘܿܢܹ̈ܐ ܟܬܝܼܒܼܹ̈ܐ، ܐܲܝܟܵܐ ܕܐܵܦ ܚܲܕ݇ ܠܵܐ ܝܵܕܹܥ ܡܵܐ ܝܠܹܗ ܕܝܼܹܗ ܘܡܵܐ ܝܠܹܗ ܥܲܠܹܗ.</span><br>
                                    <span>ܩܵܕ݇ܡ ܙܵܘܕܵܐ ܡ̣ܢ ܬܠܵܬܵܐ ܐܲܠܦܹ̈ܐ ܫܸܢܹ̈ܐ، ܡܫܘܼܪܹܐ ܠܹܗ ܗܵܘ ܢܸܣܝܵܢܵܐ ܩܲܕ݇ܡܵܝܵܐ ܠܡܲܪܝܘܿܙܹܐ ܚܲܝܘܼܬܵܐ ܘܲܡܬܲܚܲܡܬܵܐ ܕܟܹܐܢܘܼܬܵܐ ܘܲܛܠܘܼܡܝܵܐ.</span><br>
                                    <br>

                                    <span class="bold">ܣܸܕܪܵܐ ܕܐܵܢܝ݇ ܩܵܢܘܿܢܹ̈ܐ ܒܘܼܫ ܥܲܬܝܼܩܹ̈ܐ ܒܥܵܠܡܵܐ:</span><br>
                                    <span>ܦܪܝܼܣܬܵܐ ܝܠܵܗ̇ ܓܵܘ ܐ݇ܢܵܫܹ̈ܐ ܕܩܵܢܘܿܢܵܐ ܕܚܲܡܘܼܪܵܒܝܼ ܝܼܠܹܗ ܗܵܘ ܩܵܢܘܿܢܵܐ ܩܲܕ݇ܡܵܝܵܐ ܒܥܵܠܡܵܐ.</span><br>
                                    <span>ܘܐܵܗܵܐ ܡܬܲܚܡܲܢܬܵܐ ܦܪܸܣܠܵܗ̇ ܩܵܕ݇ܡ ܡܲܫ݇ܟ̰ܲܚܬܵܐ ܕܐܵܢܝ݇ ܩܵܢܘܿܢܹ̈ܐ ܒܘܼܫ ܥܲܬܝܼܩܹ̈ܐ ܐܲܝܟܼ:</span><br>
                                    <br>

                                    <span>1. ܩܵܢܘܿܢܵܐ ܕܐܘܿܪܢܲܡܘܿ (2100-2050 ܩ.ܡ)</span><br>
                                    <span>2. ܩܵܢܘܿܢܵܐ ܕܠܸܒܸܬ ܥܲܫܬܵܪ (1930-1920 ܩ.ܡ)</span><br>
                                    <span>3. ܩܵܢܘܿܢܵܐ ܕܡܲܠܟܘܼܬܵܐ ܕܐܸܫܢܘܼܢܵܐ (1900-1800 ܩ.ܡ)</span><br>
                                    <br>

                                    <span class="bold">ܢܵܡܘܿܣܵܐ ܕܚܲܡܘܼܪܵܒܝܼ ((1792-1750 ܩ.ܡ) ܕܠܵܐ ܝܗ݇ܘܵܐ ܫܘܼܪܵܝܵܐ، ܐܝܼܢܵܐ ܝܼܗ݇ܘܵܐ:</span><br>
                                    <span>· ܫܩܝܼܠܵܐ ܡܲܥܒܕܵܢܘܼܬܵܐ ܡ̣ܢ ܡܠܘܿܐܹ̈ܐ ܕܩܵܢܘܿܢܹ̈ܐ ܒܘܼܫ ܥܲܬܝܼܩܹ̈ܐ</span><br>
                                    <span>· ܫܒܼܸܩܠܹܗ ܠܚܲܕ݇ܟܡܵܐ ܡܠܘܿܐܹ̈ܐ ܥܲܬܝܼܩܹ̈ܐ ܐܲܝܟܼ ܕܝܼܗ݇ܘܵܘ</span><br>
                                    <span>· ܡܫܘܼܚܠܸܦܠܹܗ ܘܡܘܼܙܝܸܕܠܹܗ ܡܠܘܿܐܹ̈ܐ ܐ݇ܚܹܖ̈݇ܢܹܐ ܕܠܵܚܹܡ ܥܲܡ ܙܲܒܼܢܹܗ</span><br>
                                    <br>

                                    <span class="bold">ܩܵܢܘܿܢܵܐ ܕܐܘܿܪܢܲܡܘܿ (ܗܵܘ ܢܵܡܘܿܣܵܐ ܟܬܝܼܒܼܵܐ ܒܘܼܫ ܥܲܬܝܼܩܵܐ):</span><br>
                                    <span>· ܕܥܵܪܵܐ ܝܠܹܗ ܠܕܵܪܵܐ ܕ 21 ܩܵܕ݇ܡ ܡܵܘܠܵܕܵܐ (2100-2050 ܩ.ܡ)</span><br>
                                    <span>· ܩܲܡ ܡܲܬܸܒܼܠܹܗ ܡܲܠܟܵܐ ܫܘܿܡܝܼܪܵܝܵܐ ܐܘܿܪܢܲܡܘܿ ܗܵܘ ܕܝܼܠܹܗ ܡܫܲܬܐܸܣܵܢܵܐ ܕܝܘܼܒܵܠܵܐ ܬܠܝܼܬܵܝܵܐ ܕܐܘܿܪ</span><br>
                                    <span>· ܐ݇ܡܝܼܪܵܐ ܝܠܹܗ ܕܚܵܒܼܹܫ 57 ܡܠܘܿܐܹ̈ܐ، ܘܡܸܛܝܹ̈ܐ ܝܠܲܝܗܝ ܐܸܠܲܢ 31</span><br>
                                    <span>· ܦܝܼܫܠܹܗ ܟܬܝܼܒܼܵܐ ܒܣܸܪܛܵܐ ܨܸܨܵܝܵܐ ܘܲܒܠܸܫܵܢܵܐ ܫܘܿܡܝܼܪܵܝܵܐ</span><br>
                                    <span>· ܗܵܘ ܠܘܼܚܵܐ ܛܝܼܢܵܝܵܐ ܩܲܕ݇ܡܵܝܵܐ ܕܚܵܒܼܹܫ ܗ݇ܘܵܐ ܚܲܕ݇ ܣܲܗܡܵܐ ܡܸܢܹܗ ܦܝܼܫܠܹܗ ܡܘܼܫ݇ܟ̰ܚܵܐ ܒܫܲܢ݇ܬܵܐ ܕ 1952</span><br>
                                    <br>

                                    <span class="bold">ܢܝܼܫܹ̈ܐ ܕܩܵܢܘܿܢܵܐ ܐܲܝܟܼ ܕܦܝܼܫܠܲܝܗܝ ܡܘܼܕܟܼܸܖܹ̈ܐ ܓܵܘ ܥܘܼܬܵܕܹܗ:</span><br>
                                    <span>· ܡܲܩܘܲܝܬܵܐ ܕܟܹܐܢܘܼܬܵܐ ܘܚܹܐܪܘܼܬܵܐ</span><br>
                                    <span>· ܡܒܲܛܘܿܠܹܐ ܚܒܼܵܠܵܐ</span><br>
                                    <span>· ܡܒܲܛܘܿܠܹܐ ܣܢܵܝܬܵܐ ܘܲܛܠܘܼܡܝܵܐ</span><br>
                                    <br>

                                    <span class="bold">ܐܵܢܝ݇ ܖܹ̈ܫܘܵܬܵܐ ܐܸܣܵܝܹ̈ܐ:</span><br>
                                    <span>ܐܵܗܵܐ ܩܵܢܘܿܢܵܐ ܚܵܒܼܹܫ ܪܵܒܵܐ ܖܹ̈ܫܘܵܬܵܐ ܕܕܵܡܝܼ ܥܲܠ ܡܵܐ ܕܦܝܼܫܠܹܗ ܩܸܪܝܵܐ ܐ݇ܚܲܪܬܵܐ ܙܸܕܩܹ̈ܐ ܕܒܲܪܢܵܫܵܐ</span><br>
                                    <span>· ܡܲܚܪܘܿܡܹܐ ܩܝܵܬܬܵܐ ܒܦܲܓܼܪܵܐ ܕܒܲܪܢܵܫܵܐ</span><br>
                                    <span>· ܫܲܘܝܘܼܬܵܐ ܒܲܝܢ ܟܠ</span><br>
                                    <span>· ܡܚܲܡܘܿܝܹܐ ܙܸܕܩܹ̈ܐ ܕܲܡܚܝܼܠܹ̈ܐ</span><br>
                                    <br>

                                    <span class="bold">ܬܘܼܖ̈ܵܨܹܐ ܕܦܝܼܫܠܲܝܗܝ ܡܘܼܕܟܼܸܖܹ̈ܐ:</span><br>
                                    <span>· ܨܸܒܼ̈ܘܵܬܵܐ ܕܙܘܼܘܵܓܼܵܐ ܘܛܘܼܠܵܩܵܐ</span><br>
                                    <span>· ܙܸܕܩܹ̈ܐ ܕܝܲܬܘܼܡܹ̈ܐ</span><br>
                                    <span>· ܬܲܢܒܹ̈ܐ ܕܥܲܠ ܩܛܵܠܵܐ ܘܲܓܢܵܒܼܵܐ ܘܲܥܬܵܬܵܐ ܘܲܒܬܵܠܵܐ</span><br>
                                    <span>· ܟܠܵܝܵܐ ܒܦܵܬܵܐ ܕܠܸܥܒܹ̈ܐ ܘܲܡܛܲܐܘܿܠܹܐ ܒܝܘܼܩܖܹ̈ܐ ܘܟܲܝܠܹ̈ܐ</span><br>
                                    <span>· ܐܝܼܬ ܗ݇ܘܵܐ ܠܹܗ ܓܲܪܵܐ ܪܹܫܵܝܵܐ ܓܵܘ ܡܛܵܘܪܘܿܢܹܐ ܘܡܲܫܪܘܿܝܹܐ ܣܝܵܣܵܐ ܐܸܩܢܘܿܡܝܵܝܵܐ ܡܲܢܬܝܼܵܢܵܐ ܓܵܘ ܐܲܬܪܵܐ ܕܫܘܿܡܲܪ</span><br>
                                    <span>· ܣܢܸܕܠܹܗ ܥܲܠ ܪܹܫܘܼܬܵܐ ܕܦܘܼܪܥܵܢܵܐ ܡ̣ܢ ܫܵܘܦܵܐ ܕܬܲܢܒܵܐ ܕܦܝܼܫܠܹܗ ܡܘܼܦܠܸܚܵܐ ܒܝܲܕ ܚܲܡܘܼܪܵܒܝܼ</span><br>
                                    <span>ܐܘܿܪܢܲܡܘܿ ܦܝܼܫܠܹܗ ܡܟܘܼܢܝܵܐ ܒ((ܡܲܪܝܸܙܵܢܵܐ ܕܟܹܐܢܘܼܬܵܐ ܓܵܘ ܫܘܿܡܲܪ ܘܐܲܟܲܕ))</span><br>
                                    <br>

                                    <span class="bold">ܩܵܢܘܿܢܵܐ ܕܠܸܒܸܬ ܥܲܫܬܵܪ:</span><br>
                                    <span>· ܝܼܠܹܗ ܗܵܘ ܩܵܢܘܿܢܵܐ ܕܲܬܪܹܝܢ ܡ̣ܢ ܓܹܒ ܥܲܬܝܼܩܘܼܬܵܐ</span><br>
                                    <span>· ܦܝܼܫܠܹܗ ܡܘܼܬܒܼܵܐ ܒܝܲܕ ܡܲܠܟܵܐ ܠܸܒܸܬ ܥܲܫܬܵܪ، ܗܵܘ ܡܲܠܟܵܐ ܚܡܝܼܫܵܝܵܐ ܓܵܘ ܝܘܼܒܵܠܵܐ ܡܲܠܟܵܝܵܐ ܕܐܝܼܣܸܢ</span><br>
                                    <span>· ܕܥܵܪܵܐ ܝܠܹܗ ܠܐܲܠܦܵܐ ܬܪܲܝܵܢܵܐ ܩܵܕ݇ܡ ܡܵܘܠܵܕܵܐ (1930-1920 ܩ. ܡ)</span><br>
                                    <span>· ܝܼܗ݇ܘܵܐ ܩܵܕ݇ܡ ܩܵܢܘܿܢܵܐ ܕܚܲܡܘܼܪܵܒܝܼ ܒܙܵܘܕܵܐ ܡ̣ܢ ܚܲܕ݇ ܕܵܪܵܐ ܘܦܸܠܓܵܐ</span><br>
                                    <span>· ܦܝܼܫܠܹܗ ܟܬܝܼܒܼܵܐ ܒܠܸܫܵܢܵܐ ܫܘܿܡܝܼܪܵܝܵܐ ܘܦܝܼܫܠܹܗ ܡܘܼܫ݇ܟ̰ܚܵܐ ܓܵܘ ܫܲܒܼܥܵܐ ܠܘܼܚܹ̈ܐ</span><br>
                                    <span>· ܚܵܒܼܹܫ ܥܘܼܬܵܕܵܐ ܕܕܵܡܹܐ ܠܥܘܼܬܵܕܵܐ ܕܐܘܿܪܢܲܡܘܿ ܘ 37 ܡܠܘܿܐܹ̈ܐ ܩܵܢܘܿܢܵܝܹ̈ܐ ܘܚܘܼܬܵܡܵܐ</span><br>
                                    <br>

                                    <span class="bold">ܐܵܢܝ݇ ܡܠܘܿܐܹ̈ܐ ܒܘܼܫ ܐܵܢܲܢܩܵܝܹ̈ܐ:</span><br>
                                    <span>· ܙܸܕܩܹ̈ܐ ܕܒܲܪܢܵܫܵܐ ܘܟܹܐܢܘܼܬܵܐ ܩܵܐ ܦܲܩܝܼܖܹ̈ܐ</span><br>
                                    <span>· ܡܚܲܡܲܝܬܵܐ ܕܥܲܒܼܕܹ̈ܐ ܘܡܲܟܠܲܝܬܵܐ ܕܲܡܢܲܟܼܲܝܬܲܝܗܝ</span><br>
                                    <span>· ܢܛܵܪܵܐ ܙܸܕܩܹ̈ܐ ܕܫܲܒܼܪܘܼܬܵܐ</span><br>
                                    <span>· ܠܵܐ ܩܒܵܠܬܵܐ ܒܲܕܒܼܵܩܬܵܐ ܕܐܲܝܢܝܼ ܦܲܪܨܘܿܦܵܐ ܕܗܵܘܹܐ ܕܠܵܐ ܡܲܙܒܲܛܬܵܐ ܕܣܘܼܪܚܵܢܹܗ، ܠܗܵܕܟܼܵܐ ܐܵܗܵܐ ܩܵܢܘܿܢܵܐ ܟܹܐ ܚܵܫܹܒܼ ܠܲܡܪܘܼܡܝܵܐ ܙܲܟܵܝܵܐ ܗܲܠ ܕܦܵܝܫܵܐ ܡܘܼܙܒܸܛܬܵܐ ܕܝܵܢܬܵܐ ܕܥܲܠܹܗ</span><br>
                                    <span>· ܦܝܼܫܠܹܗ ܡܘܼܕܟܼܸܪܵܐ ܓܵܘ ܚܘܼܬܵܡܹܗ: ܠܸܒܸܬ ܥܲܫܬܵܪ ܒܪܘܿܢܵܐ ܕܐܲܠܵܗܵܐ ܐܲܢܠܝܼܠ ܡܒܘܼܛܸܠܠܝܼ ܠܲܣܢܵܝܬܵܐ ܘܲܥܢܵܦܵܐ ܘܲܦܠܸܚܠܝܼ ܥܲܠ ܡܲܓܠܲܝܬܵܐ ܕܟܹܐܢܘܼܬܵܐ ܘܙܲܕܝܼܩܘܼܬܵܐ ܘܡܲܝܬܘܿܝܹܐ ܛܵܒܼܬܵܐ ܩܵܐ ܫܘܿܡܝܼܖ̈ܵܝܹܐ ܘܐܲܟܲܕܵܝܹ̈ܐ</span><br>
                                    <br>

                                    <span class="bold">ܩܵܢܘܿܢܵܐ ܕܡܲܠܟܘܼܬܵܐ ܕܐܸܫܢܘܼܢܵܐ:</span><br>
                                    <span>· ܝܼܠܹܗ ܗܵܘ ܩܵܢܘܿܢܵܐ ܬܠܝܼܬܵܝܵܐ ܡ̣ܢ ܓܹܒ ܥܲܬܝܼܩܘܼܬܵܐ</span><br>
                                    <span>· ܝܼܠܹܗ ܕܡܲܠܟܘܼܬܵܐ ܕܐܸܫܢܘܼܢܵܐ ܗܵܝ ܕܝܼܠܵܗ̇ ܚܕܵܐ ܡ̣ܢ ܕܵܘܸܠ̈ܝܵܬܵܐ ܒܵܒܼܹܝܠܵܝܹ̈ܐ ܐܵܢܲܢܩܵܝܹ̈ܐ ܓܵܘ ܡܫܲܪܲܝܬܵܐ ܕܙܲܒܼܢܵܐ ܒܵܒܼܹܝܠܵܝܵܐ</span><br>
                                    <span>· ܦܝܼܫܠܹܗ ܟܬܝܼܒܼܵܐ ܒܣܸܪܛܵܐ ܨܸܨܵܝܵܐ ܘܲܒܠܸܫܵܢܵܐ ܐܲܟܲܕܵܝܵܐ</span><br>
                                    <span>· ܚܵܒܼܹܫ ܥܘܼܬܵܕܵܐ ܘ 60 ܡܠܘܿܐܹ̈ܐ ܩܵܢܘܿܢܵܝܹ̈ܐ</span><br>
                                    <span>· ܕܵܥܹܪ ܠܡܸܬܚܵܐ ܕܒܲܝܢ (1900-1800 ܩ.ܡ) ܘܝܼܠܹܗ ܩܵܕ݇ܡ ܩܵܢܘܿܢܵܐ ܕܚܲܡܘܼܪܵܒܝܼ ܒܙܵܘܕܵܐ ܡ̣ܢ ܚܲܕ݇ ܕܵܪܵܐ</span><br>
                                    <br>

                                    <span>ܦܠܝܼܓܼܵܐ ܝܠܹܗ ܠܲܟܢܘܼܫ̈ܝܵܬܵܐ ܕܟܠ ܚܕܵܐ ܡܸܢܲܝܗܝ ܟܹܐ ܡܗܲܡܙܸܡܵܐ ܒܘܼܕ ܚܕܵܐ ܨܒܼܘܼܬܵܐ:</span><br>
                                    <span>· ܐܲܝܟܲܢ̈ܘܵܬܵܐ ܦܲܖ̈ܨܘܿܦܵܝܹܐ</span><br>
                                    <span>· ܙܸܕܩܹ̈ܐ ܕܒܲܝܬܘܼܬܵܐ ܘܒܲܪ ܙܵܘܓܵܐ ܘܒܲܪ݇ܬ ܙܵܘܓܵܐ</span><br>
                                    <span>· ܗܵܝ ܡܲܕܟܼܲܪܬܵܐ ܩܲܕ݇ܡܵܝܬܵܐ ܒܘܼܕ ܦܠܵܓܼܬܵܐ ܕܲܟܢܘܼܫܝܵܐ ܠܫܵܘܝ̈ܘܵܬܵܐ</span><br>
                                    <span>· ܡܗܘܼܡܙܸܡܠܹܗ ܒܘܼܕ ܨܸܒܼܘܵܬ̈ܵܐ ܐܸܩܢܘܿܡܝܵܝܹ̈ܐ ܐܲܝܟܼ ܡܬܲܚܲܡܬܵܐ ܕܛܝܼܡܹ̈ܐ ܕܬܹܐܓܼܘܼܖ̈ܝܵܬܵܐ ܐܸܣܵܝܹ̈ܐ ܘܡܲܪܝܲܙܬܵܐ ܕܲܙܒܼܵܢܵܐ ܘܲܡܙܲܒܘܿܢܹܐ ܘܡܘܼܠܟܵܢܵܐ</span><br>
                                    <span>· ܟܠܵܝܵܐ ܒܦܵـܬܵܐ ܕܲܓܢܵܒܼܵܐ</span><br>
                                    <span>· ܡܣܲܬܘܿܬܹܐ ܪܹܫܘܼܬܵܐ ܕܦܘܼܪܥܵܢܵܐ ܡ̣ܢ ܢܸܟܼܝܵܢܵܐ</span><br>
                                    <span>· ܝܼܠܹܗ ܚܲܠܲܩܬܵܐ ܐܵܣܪܵܢܬܵܐ ܒܲܝܢ ܩܵܢܘܿܢܹ̈ܐ ܫܘܿܡܝܼܖ̈ܵܝܹܐ (ܐܘܿܪܢܲܡܘܿ ܘܠܸܒܸܬ ܥܲܫܬܵܪ) ܘܩܵܢܘܿܢܵܐ ܕܚܲܡܘܼܪܵܒܝܼ</span><br>
                                    <br>

                                    <span class="bold">ܩܵܢܘܿܢܵܐ ܕܚܲܡܘܼܪܵܒܝܼ:</span><br>
                                    <span>ܚܫܝܼܒܼܵܐ ܝܠܹܗ ܗܵܘ ܒܘܼܫ ܓܡܝܼܪܵܐ ܒܲܝܢ ܩܵܢܘܿܢܹ̈ܐ ܥܲܬܝܼܩܹ̈ܐ ܕܝܼܗ݇ܘܵܘ ܩܵܕ݇ܡ ܡܸܢܹܗ، ܐܝܼܢܵܐ ܗܘܝܼܬܵܐ ܝܠܵܗ̇ ܥܲܠܹܗ ܡܲܥܒܕܵܢܘܼܬܵܐ ܡܸܢܲܝܗ، ܘܐܵܦ ܚܫܝܼܒܼܵܐ ܝܠܹܗ ܐܲܝܟܼ ܚܕܵܐ ܦܵܬܵܐ ܒܲܗܪܵܢܬܵܐ ܒܲܝܢ ܦܵܬ̈ܘܵܬܵܐ ܕܬܲܫܥܝܼܬܵܐ ܕܒܲܪܢܵܫܘܼܬܵܐ.</span><br>
                                    <span>ܡ̣ܢ ܐܘܿܪܢܲܡܘܿ ܠܚܲܡܘܼܪܵܒܝܼ، ܩܵܢܘܿܢܹ̈ܐ ܠܵܐ ܝܗ݇ܘܵܘ ܐܲܚܟ̰ܝܼ ܨܚܵܚܹ̈ܐ، ܐܝܼܢܵܐ ܝܼܗ݇ܘܵܘ ܐܵܢܝ݇ ܦܵܣܘܿܥ̈ܝܵܬܵܐ ܩܲܕ݇ܡܵܝܹ̈ܐ ܨܘܿܒ ܥܵܠܡܵܐ ܕܲܩܪܵܝܵܐ ܝܠܹܗ ܟܹܐܢܘܼܬܵܐ.</span><br>

                                </p>
