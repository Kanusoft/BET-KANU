                <div class="">
                    <div class="row g-4 justify-content-between Articles">

                        <!-- Western -->
                        <div class="col-md-6 col-sm-12 ">
                            <div class="well h-100  text-center" style="direction: rtl" id="western">
                                <h3 class="padding-bottom-10" style="direction:ltr">Western Syriac</h3>
                                <p class="Surayt text-right">
                                    <span class="bold">
                                        ܩܳܢܽܘܢ̈ܶܐ ܕܣ݄ܡ ܠ݄ܗ̱ܢ ܗ̄ܺܝ ܡܕܺܝܢܳܝܽܘܬ̥ܳܐ
                                    </span><br>
                                    <span class="bold">ܥܽܘܬܳܕܳܐ:</span><br>
                                    <span>ܡܨܰܘ݄ܪ ܥܳܠܡܳܐ ܕܠܳܐ ܩܳܢܽܘܢ̈ܶܐ ܘܢܳܡܽܘܣ̈ܶܐ ܟܬ̥ܺܝܒ̥̈ܶܐ، ܐܰܝܟܳܐ ܕܢܳܫܳܐ ܠܳܐ ܟܳܐܕ݄ܥ ܡ݄ܢ ܙܶܕ̈ܩܶܐ ܟܺܝܬ ܠܶܗ ܘܡ݄ܢ ܙܶܕ̈ܩܶܐ ܟܺܝܬ ܐܰܥܠܶܗ</span><br>
                                    <span>ܡܶܩ݄ܕ̱ܡ ܙܶܕ ܡܶܢ̱ ܬܠܳܬ̥ܰܐܠܦܳܐ ܐ݄ܫܢ̈ܶܐ ܡܫܰܪܰܠّܶܗ ܗ̄ܰܢ ܢܶܣܝܳܢ̈ܶܐ ܩܰܕ̱ܡܳܝ̈ܶܐ ܠܽܗ̄ܘ ܛܽܘܟܳܣܳܐ ܕܰܚّܰܝ̈ܶܐ ܘܽܗ̄ܘ ܬܽܘܚܳܡܳܐ ܕܺܗ̄ܝ ܟܺܐܢܽܘܬ̥ܳܐ ܘܕܽܗ̄ܘ ܛܠܽܘܡܝܳܐ.</span><br>
                                    <br>

                                    <span class="bold">ܬܽܘܪܳܨܳܐ ܡܰܟܬ̥ܰܒܙܰܒܢܳܝܳܐ ܕܰܩّܳܢܘܢ̈ܶܐ ܥܰܬܺܝܩ̈ܶܐ</span><br>
                                    <span>ܗ̄ܽܘ ܩܳܢܽܘܢܳܐ ܕܚܰܡܽܘܪܰܒܺܝ ܚܫܺܝܒ̥ܳܐ ܝܳܐ ܗ̄ܽܘ ܩܳܢܽܘܢܳܐ ܩܰܕ̱ܡܳܝܳܐ ܒܽܗ̄ܘ ܥܳܠܡܳܐ.</span><br>
                                    <span>ܘܦܰܝ݄ܫ ܚܫܺܝܒ̥ܳܐ ܗܰܘܟ̥ܰܐ ܗܳܠ ܠܺܗ̄ܝ ܫܟܰܚܬܳܐ ܕܰܩّܳܢܘܢ̈ܶܐ ܕܟܝܬܢܶܝ ܥܰܬ݄ܩ ܐܰܝܟ̥܇</span><br>
                                    <br>

                                    <span>ܐ. ܩܳܢܽܘܢܳܐ ܕܐܽܘܪܢܰܡܽܘ (2100–2050 ܩ.ܡ)</span><br>
                                    <span>ܒ. ܩܳܢܽܘܢܳܐ ܕܠܺܝܒܬ݂ ܥܰܫܬܰܪ (1930–1920 ܩ.ܡ)</span><br>
                                    <span>ܓ. ܩܳܢܽܘܢܳܐ ܕܐܶܫܢܽܘܢܰܐ (1900 -1800 ܩ.ܡ)</span><br>
                                    <br>

                                    <span>ܗ̄ܽܘ ܩܳܢܽܘܢܳܐ ܕܚܰܡܽܘܪܰܒܺܝ (1750 – 1792 ܩ.ܡ) ܠܰܝ̱ܬ ܗ̄ܘܰܐ ܟܽܘܠܶܗ ܚܰܕ̱ܬ̥ܳܐ ܒܽܗ̄ܘ ܙܰܒܢܰܘܳܐ ܐܶܠܳܐ:</span><br>
                                    <span>ܡ݄ܕ ܠܶܗ ܡܠܽܘ̈ܐܶܐ ܡܰܢ̱ ܩّܳܢܽܘ̈ܢܶܐ ܕܡܶܩ݄ܕ̱ܡ</span><br>
                                    <span>ܛܪܶܐ ܠܶܗ ܡܠܽܘ̈ܐܶܐ ܐܝܟ̥ ܕܟܝܬܢܶܝ</span><br>
                                    <span>ܡܫܰܚܠܰܦ  ܠܶܗ ܘܡܰܘܙܰܕ ܠܶܗ ܡܠܽܘ̈ܐܶܐ ܕܐܙّ݄ܢ ܗ̄ܘܰܘ ܥܰܡ ܗ̄ܽܘ ܙܰܒܢܰܝܕܶܗ</span><br>
                                    <br>

                                    <span class="bold">ܗ̄ܽܘ ܩܳܢܽܘܢܳܐ ܕܐܽܘܪܢܰܡܽܘ ܥܰܬ݄ܩ ܢܳܡܽܘܣܳܐ ܟܬ̥ܺܝܒ̥ܳܐ ܘܺܝܕ݂ܺܝܥܳܐ:</span><br>
                                    <span>ܟܳܕܳܥ݄ܪ ܠܽܗ̄ܘ ܕܳܪܳܐ ܕܰܚܰܕ̱ ܘܥܶܣܪܺܝܢ̱ ܡܶܩ݄ܕ̱ܡ ܡܽܗ̄ܘ ܡܰܘܠܳܕܳܐ (2100- 2050 ܩ.ܡ)</span><br>
                                    <span>ܟܬ̥ܺܝܒ̥ ܘܡܛܰܟ݄ܣ ܡܽܗ̄ܘ ܡܰܠܟܳܐ ܫܽܘܡܪܳܝܳܐ ܐܽܘܪܢܰܡܽܘ ܗ̄ܽܘ ܡܫܰܬܐܣܳܢܳܐ ܕܗ̄ܺܝ ܫܰܪܒܬ̥ܳܐ ܕܐܽܘܪ ܕܰܬܠ݄ܬ̥</span><br>
                                    <span>ܐ̱ܡܺܝܪ ܕܟܺܝܬ ܐܶܒܶܗ 57 ܡܠܽܘ̈ܐܶܐ ܩܳܢܽܘ̈ܢܳܝܶܐ ܘܡܰܛܺܝ ܠܰܢ 31 ܡܶܢّܶܗ.</span><br>
                                    <span>ܟܬ̥ܺܝܒ̥ ܒܺܗ̄ܝ ܟܬ̥ܰܒ̥ܬܳܐ ܕܰܨܶܨ̈ܶܐ (ܕܰܒ݄ܣܡܳܪ̈ܶܐ) ܘܒܽܗ̄ܘ ܠܶܫܳܢܳܐ ܫܽܘܡܪܳܝܳܐ.</span><br>
                                    <span>ܗ̄ܽܘ ܠܽܘܚܳܐ ܕܽܗ̄ܘ ܛܺܝܢܳܐ ܗ̄ܽܘ ܩܰܕ̱ܡܳܝܳܐ ܕܟܺܝܬ ܐܶܒܶܗ ܦܰܠܩܳܐ ܡܽܗ̄ܘ ܢܳܡܽܘܣܰܝܕܶܗ ܚܙܶܐ ܒܺܗ̄ܝ ܫܰܢ̱ܬܳܐ ܕ1952</span><br>
                                    <br>

                                    <span class="bold">ܗ̄ܰܢ ܢܺܝܫ̈ܶܐ ܕܽܗ̄ܘ ܩܳܢܽܘܢܳܐ ܐܟ̥ ܕܟܬ̥ܺܝܒ̥ܺܝ ܒܽܗ̄ܘ ܥܽܘܬܳܕܰܝܕܶܗ ܗ݄ܢّܶܝ܇</span><br>
                                    <span>ܕ݄ܡܥܰܫܢܺܝ ܗ̄ܺܝ ܟܺܐܢܽܘܬ̥ܳܐ ܘܺܗ̄ܝ ܚܺܐܪܽܘܬ̥ܳܐ</span><br>
                                    <span>ܕ݄ܡܒܰܛܠܺܝ ܗ̄ܽܘ ܚܪܳܒ̥ܳܐ</span><br>
                                    <span>ܕ݄ܡܒܰܛܠܺܝ ܗ̄ܽܘ ܣܢܳܝܳܐ ܘܽܗ̄ܘ ܛܠܽܘܡܝܳܐ</span><br>
                                    <br>

                                    <span class="bold">ܗ̄ܰܢ ܐܶܣ̈ܶܐ ܐܽܘܠܨܳܝ̈ܶܐ</span><br>
                                    <span>ܗ̄ܽܘ ܩܳܢܽܘܢܳܐ ܟܺܝܬ ܐܶܒܶܗ ܐܶܣ̈ܶܐ ܪ̈ܺܝܫܳܝܶܐ ܕܟܳܕܳܡ݄ܢ ܠܰܗ̄ܢܺܝ ܕܺܝܕ̥ܺܝܥܺܝ ܒ݄ܐܫܡܶܗ ܕܰܙّܶܕܩ̈ܶܐ ܢܳܫܳܝ̈ܶܐ.</span><br>
                                    <span>ܚܶܪܡܳܐ ܠܽܗ̄ܘ ܬܶܟܝܒ̥ܳܐ ܕܽܗ̄ܘ ܓܘܫܡܳܐ ܕܽܗ̄ܘ ܒܰܪܢܳܫܳܐ</span><br>
                                    <span>ܫܰܘܝܽܘܝܬ̥ܳܐ ܒܰܝܢ ܕܰܗ̄ܢ ܢܳܫ̈ܶܐ</span><br>
                                    <span>ܢܛܳܪܳܐ ܕܰܙّܶܕܩ̈ܶܐ ܕܰܡܚܺܝ̈ܠܶܐ</span><br>
                                    <span>ܗ̄ܰܬّܽܘܖ̈ܳܨܶܐ ܕܡܰܚܬܺܝ ܠܶܗ ܗ̄ܽܘ ܩܳܢܽܘܢܰܢܳܐ</span><br>
                                    <span>ܨܶܒܘ̈ܳܬ̥ܳܐ ܕܽܗ̄ܘ ܙܽܘܘܳܓ̥ܳܐ ܘܕܽܗ̄ܘ ܛܘܠܳܩܳܐ</span><br>
                                    <span>ܙܶܕ̈ܩܶܐ ܕܰܝܰܬܽܘܡ̈ܶܐ</span><br>
                                    <span>ܡܚܰܫܒ̥ܳܢܘܬ̥ܳܐ ܥܰܠ ܗ̄ܽܘ ܩܰܛܠܳܐ ܘܗ̄ܽܘ ܓܢܳܒ̥ܳܐ ܘܗ̄ܺܝ ܢܟ̥ܺܝܠܘܬ̥ܳܐ ܘܗ̄ܽܘ ܒܙܳܙܳܐ</span><br>
                                    <span>ܟܠܰܝܬܳܐ ܒܦܳܬܶܗ ܕܽܗ̄ܘ ܙܺܐܦܳܐ ܕܰܟܰܝ̈ܠܶܐ</span><br>
                                    <span>ܟ݄ܬ ܗ̄ܘܰܝ ܠܶܗ ܕܰܘܪܳܐ ܐܽܘܠܨܳܝܳܐ ܒܽܗ̄ܘ ܫܽܘܘܫܳܛܳܐ ܘܫܽܘܬܳܐܣܳܐ ܕܦܽܘܠܺܝܛܺܝܩܺܝ ܐܶܩܳܢܽܘܡܝܳܐ ܚܦܺܝܛܳܐ ܒܽܗ̄ܘ ܕܳܪܳܐ ܕܰܫّܽܘܡܪ̈ܳܝܶܐ</span><br>
                                    <span>ܡܰܗ̄ܠܰܟ̥ ܠܶܗ ܥܰܠ ܗ̄ܽܘ ܐܶܣܳܐ ܕܺܗ̄ܝ ܡܚܰܠܦܽܘܬܐ ܡܶܢ̱ ܚܠܳܦ ܕܽܗ̄ܘ ܚܫܳܒ̥ܳܐ ܕܡܰܗ̄ܠܰܟ̥ ܠܶܗ ܐܰܥܠܶܗ ܚܰܡܘܪܰܒܺܝ</span><br>
                                    <br>

                                    <span>ܐܽܘܪܢܰܡܽܘ ܝܕ̥ܺܝܥ ܐܟ̥ ܕܽܗ̄ܘ ܡܛܰܟܣܳܢܳܐ ܕܺܗ̄ܝ ܟܺܐܢܽܘܬ̥ܳܐ ܒܫܽܘܡܰܪ ܘܐܰܟܰܕ</span><br>
                                    <br>

                                    <span class="bold">ܩܳܢܽܘܢܳܐ ܕܠܺܝܒܬ ܥܰܫܬܰܪ</span><br>
                                    <span>ܗ̄ܽܘ ܩܳܢܽܘܢܳܐ ܕܰܬܪܶܝ ܒܰܝܢ ܕܰܩّܳܢܘܢ̈ܶܐ ܥܰܬܝ̈ܩܶܐ</span><br>
                                    <span>ܣܺܝܡ ܡܶܢ̱ ܡܰܠܟܳܐ ܠܺܝܒܬ ܥܰܫܬܰܪ ܗ̄ܽܘ ܡܰܠܟܳܐ ܕܰܚܰܡܫܳܐ ܕܺܗ̄ܝ ܫܰܪܒܬ̥ܳܐ ܕܺܐܝܣܺܝܢ</span><br>
                                    <span>ܟܳܕܳܥ݄ܪ ܠܽܗ̄ܘ ܕܳܪܳܐ ܕܰܬܪܰܐܠܦܳܐ ܡܶܩ݄ܕ̱ܡ ܡܽܗ̄ܘ ܡܰܘܠܳܕܳܐ (1930–1920ܩ.ܡ)</span><br>
                                    <span>ܡܬܰܚܬ ܡܶܩ݄ܕ̱ܡ ܡܽܗ̄ܘ ܩܳܢܽܘܢܳܐ ܕܚܰܡܽܘܪܰܒܺܝ ܒܙ݄ܕ ܡܶܢ̱ ܕܳܪܳܐ ܘܦܰܠܓܶܗ</span><br>
                                    <span>ܟܬ̥ܺܝܒ̥ ܒܽܗ̄ܘ ܠܶܫܳܢܳܐ ܫܽܘܡܪܳܝܳܐ ܘ݄ܚܙܶܐ ܥܰܠ ܫܰܒ̥ܥܳܐ ܦܰܠܩ̈ܶܐ</span><br>
                                    <span>ܟܺܝܬ ܐܶܒܶܗ ܥܽܘܬܳܕܳܐ ܕܟܳܕܳܡܶܐ ܠܰܗ̄ܘܳܐ ܕܽܐܘܪܢܰܡܽܘ، ܫܰܒ̥ܥܳܐ ܘܬܠܶܬ̥ܺܝ ܡܠܽܘ̈ܐܶܐ ܩܳܢܽܘܢܳܝ̈ܶܐ ܘܚܽܘܬ̥ܳܡܳܐ</span><br>
                                    <br>

                                    <span class="bold">ܗ̄ܰܢ ܢܽܘܩܙ̈ܶܐ ܐܽܘܠܨܳܝ̈ܶܐ ܕܽܗ̄ܘ ܩܳܢܽܘܢܳܐ</span><br>
                                    <span>ܗ̄ܰܙّܶܕܩ̈ܶܐ ܢܳܫܳܝ̈ܶܐ ܘܺܗ̄ܝ ܟܺܐܢܽܘܬ̥ܳܐ ܠܰܡܶܣܟܺܢ̈ܶܐ</span><br>
                                    <span>ܢܛܳܪܳܐ ܕܰܥّܰܒܕ̈ܶܐ ܘܕܠܳܐ ܡܺܝܬܰܟܺܝܒ̥ܝ</span><br>
                                    <span>ܢܛܳܪܳܐ ܕܰܙܶܕܩ̈ܶܐ ܕܰܛܠܳܝ̈ܶܐ</span><br>
                                    <span>ܕܠܳܐ ܡܺܝܬܰܟܠܶܐ ܢܳܫܳܐ ܐܶܢ ܕܠܳܐ ܡܝܫܰܪܰܪ ܗ̄ܽܘ ܚܰܘܒܰܝܕܶܗ، ܗ̄ܽܘ ܩܳܢܽܘܢܰܢܳܐ ܟܳܚܳܫܰܒ̥ ܠܶܗ ܒܪܺܝܪܳܐ (ܒܰܪܺܝܳܐ) ܗܳܠ ܕܡܺܝܫܰܪܰܪ ܗ̄ܽܘ ܚܰܘܒܰܝܕܶܗ</span><br>
                                    <span>ܗ̄ܽܘ ܚܽܘܬ̥ܳܡܳܐ ܕܽܗ̄ܘ ܩܳܢܽܘܢܳܐ ܟܳܐܡ݄ܪ: ܠܝܒܬ ܥܰܫܬܰܪ ܐܰܒܪܶܗ ܕܰܐܠܳܗܳܐ ܐܶܢܠܺܝܠ  ܣܢܶܐ ܠܺܝ  ܠܺܗ̄ܝ ܣܰܢܝܽܘܬܐ ܘܠܽܗ̄ܘ ܥܢܽܘܦܝܳܐ، ܦܠ݄ܚ ܠܺܝ ܕܡܰܪܟܰܒ̥ ܐ̱ܢܳܐ ܟܺܐܢܽܘܬ̥ܳܐ ܘ̣̣ܫܪܳܪܳܐ ܘܣ݄ܡ ܠܺܝ ܛܳܒ̥ܽܘܬ̥ܳܐ ܠܰܐܦ ܗ̄ܰܫܽܘܡܪ̈ܳܝܶܐ ܘܰܐܟܰܕ̈ܳܝܶܐ</span><br>
                                    <br>

                                    <span class="bold">ܩܳܢܽܘܢܳܐ ܕܐܶܫܢܘܢܰܐ</span><br>
                                    <span>ܗ̄ܽܘ ܩܳܢܽܘܢܳܐ ܕܰܬܠܳܬ̥ܳܐ ܒܰܝܢ ܕܰܩّܳܢܘܢ̈ܶܐ ܥܰܬܝ̈ܩܶܐ</span><br>
                                    <span>ܟܳܕܳܥܪ ܠܺܗ̄ܝ ܡܰܠܟܽܘܬ̥ܳܐ ܕܐܶܫܢܘܢܰܐ ܚܕܳܐ ܡܰܢ̱ ܡّܰܠܟܘ̈ܳܬ̥ܳܐ ܐܽܘܠܨܳܝ̈ܶܐ ܒܽܗ̄ܘ ܫܽܘܪܳܝܳܐ ܕܽܗ̄ܘ ܕܳܪܳܐ ܒܳܒܠܳܝܳܐ</span><br>
                                    <span>ܟܬ̥ܺܝܒ̥ ܒܺܗ̄ܝ ܟܬ̥ܰܒ̥ܬܳܐ ܕܰܨّܶܨ̈ܶܐ (ܕܰܒܶܣܡܳܪ̈ܶܐ) ܘܒܽܗ̄ܘ ܠܶܫܳܢܳܐ ܐܰܟܰܕܳܝܳܐ</span><br>
                                    <span>ܟܺܝܬ ܐܶܒܶܗ ܥܽܘܬܳܕܳܐ ܘܐ݄ܫܬܺܝ ܡܠܽܘ̈ܐܶܐ ܩܳܢܽܘܢܳܝ̈ܶܐ</span><br>
                                    <span>ܟܳܕܳܥ݄ܪ ܠܽܗ̄ܘ ܙܰܒܢܳܐ ܒܰܝܢ (1900-1800 ܩ.ܡ)  ܘܡܬܰܚ̣̣ܬ ܡܶܩ݄ܕ̱ܡ ܡܽܗ̄ܘ ܩܳܢܽܘܢܳܐ ܕܚܰܡܽܘܪܰܒܺܝ ܒܙ݄ܕ ܡܶܢ̱ ܕܳܪܳܐ.</span><br>
                                    <br>

                                    <span>ܗ̄ܽܘ ܩܳܢܽܘܢܰܢܳܐ ܦܠܺܝܓ̥ ܠܦܰܠܩ̈ܶܐ ܒܓܽܘܕ̈ܶܐ ܘܟܽܘܠ ܚܰܕ ܠܨܒܽܘܬ̥ܳܐ ܕܺܝܠܳܢܳܝܬܳܐ ܐܰܝܟ̥܇</span><br>
                                    <span>ܐܰܝܟܰܢܳܝܽܘܬ̥ܳܐ ܩܢܽܘܡܳܝܬܳܐ</span><br>
                                    <span>ܙܶܕܩ̈ܶܐ ܕܰܝܰܩܪ̈ܳܬ̥ܳܐ ܘܕܽܗ̄ܘ ܓܰܒ̥ܪܳܐ ܘܕܺܗ̄ܝ ܐܰܢ̱ܬ̥ܬܳܐ</span><br>
                                    <span>ܗ̄ܺܝ ܢܰܩܠܰܐ ܩܰܕ̱ܡܰܝܬܳܐ ܕܦܠܺܝܓ̥ ܗ̄ܽܘ ܟܶܢܫܳܐ ܠܣܶܕܪ̈ܶܐ ܦܪܺܝܫ̈ܶܐ</span><br>
                                    <span>ܚܙܶܐ ܠܶܗ ܫܖ̈ܳܝܶܐ ܠܰܩّܰܛܪ̈ܶܐ ܐܶܩܳܢܽܘܡܝܳܝ̈ܶܐ</span><br>
                                    <span>ܗ̄ܰܛܺܝܡ̈ܶܐ ܕܰܣّܶܦܳܩ̈ܶܐ ܐܽܘܠܨܳܝ̈ܶܐ</span><br>
                                    <span>ܡܕܰܒܪܳܢܽܘܬ̥ܳܐ ܠܽܗ̄ܘ ܙܒ̥ܳܢܳܐ ܘܠܽܗ̄ܘ ܙܶܒܳܢܳܐ ܘܺܗ̄ܝ ܡܳܪܽܘܬ̥ܳܐ</span><br>
                                    <span>ܫܪܳܝܳܐ ܠܽܗ̄ܘ ܩܰܛܪܳܐ ܕܽܗ̄ܘ ܓܢܳܒ̥ܳܐ</span><br>
                                    <span>ܐܶܣܳܐ ܕܺܗ̄ܝ ܡܚܰܠܦܽܘܬܐ ܥܰܠ ܗ̄ܽܘ ܚܪܳܒ̥ܳܐ</span><br>
                                    <span>ܗܰܘܺܝ ܐܶܣܳܪܳܐ ܒܰܝܢ ܕܰܗ̄ܢ ܢܳܡܽܘܣ̈ܶܐ ܫܽܘܡܪ̈ܳܝܶܐ (ܐܽܘܪܢܰܡܘ ܘܠܺܝܒܬ ܥܫܬܰܪ) ܘܰܗ̄ܢ ܢܳܡܽܘ̈ܣܶܐ ܒܳܒܠܳܝ̈ܶܐ (ܚܰܡܽܘܪܰܒܺܝ)</span><br>
                                    <br>

                                    <span class="bold">ܗ̄ܽܘ ܩܳܢܽܘܢܳܐ ܕܚܰܡܽܘܪܰܒܺܝ</span><br>
                                    <span>ܡ݄ܕ ܠܶܗ ܪ̈ܶܢܝܶܐ ܡܰܢ̱ ܩّܳܢܽܘ̈ܢܶܐ ܕܡܶܩ̣̣ܕ̱ܡ ܘܡܶܢܝܳܢܳܐ ܡܰܢ̱ ܦܳܣܽܘ̈ܩܰܬܶܗ ܐܶܠܳܐ ܟܳܡ݄ܚܫܽܒ̥ ܗ̄ܽܘ ܩܳܢܽܘܢܳܐ ܟܰܡܺܝܠܳܐ ܒܰܝܢ ܕܰܩّܳܢܘܢ̈ܶܐ ܥܰܬܺܝ̈ܩܶܐ ܕܡܶܩ̣̣ܕ̱ܡ ܡܶܢܶܗ ܡܰܗ̄ܘܟ̥ܰܐ ܟܡ݄ܚܙܶܐ ܐ̱ܝܟ ܕܕܰܦܳܐ ܡܰܒܗܪܳܢܳܐ ܒܰܕّܰܦ̈ܶܐ ܕܽܗ̄ܘ ܡܰܟܬ̥ܰܒܙܰܒܢܳܐ</span><br>
                                    <br>

                                    <span>ܡܶܢ̱ ܐܽܘܪܢܰܡܘ ܠܚܰܡܽܘܪܰܒܺܝ ܗ̄ܰܩܳܢܽܘ̈ܢܶܐ ܠܰܬ ܗ̄ܘܰܝ ܢܶܐ ܦܳܣܽܘ̈ܩܶܐ ܒܰܠܚܽܘܕ ܐܶܠܳܐ ܦܣܰܥܬܳܐ ܩܰܕ̱ܡܰܝܬܳܐ ܠܥܳܠܡܳܐ ܟܳܡܰܘܕ̣̣ܥ ܗ̄ܺܝ ܟܺܐܢܽܘܬ̥ܳܐ</span><br>

                                </p>



