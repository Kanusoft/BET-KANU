                        <!-- Eastern -->
                        <div class=" col-md-6 col-sm-12">
                            <div class="well h-100 text-center" style="direction: rtl" id="eastern">
                                <h3 class="padding-bottom-10" style="direction:ltr">Eastern Syriac</h3>

                                <span class="Surit bold text-center">
                                    ܡܲܒܥܵܢܘܼܬܵܐ ܕܲܟܬܵܒܼܬܵܐ: ܩܵܘܡܵܐ ܕܲܡܫܘܼܚܠܸܦܠܹܗ ܠܬܲܫܥܝܼܬܵܐ ܕܒܲܪܢܵܫܵܐ
                                </span><br><br>

                                <p class="Surit text-right">

                                    <span>ܡܨܲܠܡܸܢ ܥܵܠܡܵܐ ܕܠܲܝܬ̇ ܓܵܘܹܗ ܟܬܵܒܼܬܵܐ، ܘܠܵܐ ܐܵܬ̈ܘܵܬܵܐ، ܘܠܵܐ ܣܸܓܼܠܹ̈ܐ ܕܲܡܚܲܡܝܼ ܠܥܘܼܗܕܵܢܵܐ ܒܲܪܢܵܫܵܝܵܐ. ܥܵܠܡܵܐ ܣܢܝܼܕܵܐ ܥܲܠ ܩܵܠܵܐ ܒܲܠܚܘܿܕ، ܟܲܕ ܒܲܪ݇ܬ ܩܵܠܵܐ ܦܵܝܫܵܐ ܝܠܝܼܕܬܵܐ ܘܡܵܝܬܵܐ ܗܵܪ ܒܗܵܝ ܥܸܕܵܢܵܐ.</span><br>
                                    <span>ܓܵܘ ܗܵܕܟܼܵܐ ܥܵܠܡܵܐ، ܡܲܫ݇ܟ̰ܲܚܬܵܐ ܕܲܟܬܵܒܼܬܵܐ ܝܼܗ݇ܘܵܐ ܩܵܘܡܵܐ ܝܘܼܠܦܵܢܵܝܵܐ ܘܪܸܢܝܵܝܵܐ ܕܲܡܫܘܼܚܠܸܦܹܗ ܠܡܹܐܙܠܵܐ ܕܲܡܕܝܼܢܵܝܘܼܬܵܐ ܒܲܪܢܵܫܵܝܬܵܐ ܠܥܵܠܲܡ، ܟܲܕ ܡܫܘܼܢܹܐ ܠܹܗ ܠܒܲܪܢܵܫܘܼܬܵܐ ܡ̣ܢ ܡܬܲܢܲܝܬܵܐ ܣܸܦܘܵܬܵܢܵܝܬܵܐ ܠܲܡܐܲܫܛܲܪܬܵܐ ܕܝܼܕܲܥܬܵܐ، ܘܲܡܚܲܡܲܝܬܵܐ ܕܝܘܼܠܦܵܢܹ̈ܐ، ܘܡܲܪܝܲܙܬܵܐ ܕܲܟܢܘܼܫܝܵܐ ܘܬܲܓܵܪܘܼܬܵܐ.</span><br>
                                    <br>

                                    <span class="bold">ܡܲܒܥܵܢܘܼܬܵܐ ܕܲܟܬܵܒܼܬܵܐ:</span><br>
                                    <span>ܫܘܿܡܝܼܖ̈ܵܝܹܐ ܥܒܼܸܕܠܲܝܗܝ ܡܲܒܥܵܢܘܼܬܵܐ ܕܲܟܬܵܒܼܬܵܐ ܨܸܨܵܝܬܵܐ ܒܩܘܼܪܒܵܐ ܕܫܸܢܹ̈ܐ ܕ (3500-3200 ܩ.ܡ) ܓܵܘ ܡܕܝܼܢܵܬ̈ܵܐ ܕܟܝܼܫ ܘܐܘܿܪܘܿܟ، ܕܗܵܘܝܵܐ ܐܵܗܵܐ ܟܬܵܒܼܬܵܐ ܗܵܘ ܛܲܟܼܣܵܐ ܩܲܕ݇ܡܵܝܵܐ ܝܕܝܼܥܵܐ ܒܬܲܫܥܝܼܬܵܐ، ܘܲܥܒܼܸܪܵܗ̇ ܐܵܗܵܐ ܟܬܵܒܼܬܵܐ ܒܲܬܠܵܬܵܐ ܡܲܫܩܠܹ̈ܐ ܐܸܣܵܝܹ̈ܐ:</span><br>
                                    <br>

                                    <span class="bold">ܡܲܫܩܠܵܐ ܨܘܼܪܬܵܢܵܝܵܐ:</span><br>
                                    <span>ܣܢܸܕܠܹܗ ܐܵܗܵܐ ܡܲܫܩܠܵܐ ܥܲܠ ܪܫܵܡܬܵܐ ܕܡܸܢܕܝܵܢܹ̈ܐ ܒܲܚܕܵܐ ܦܸܨܠܵܐ ܩܘܼܪܒܵܐ ܡܸܢܲܝܗܝ ܥܲܡ ܡܲܙܝܲܕܬܵܐ ܕܖܸ̈ܡܙܹܐ ܡܸܢܝܵܢܵܝܹ̈ܐ ܠܲܪܡܵܙܵܐ ܥܲܠ ܟܡܵܝܘܼܬܵܐ.</span><br>

                                    <span class="bold">ܡܲܫܩܠܵܐ ܪܸܡܙܵܢܵܝܵܐ:</span><br>
                                    <span>ܪܚܸܩܠܹܗ ܡ̣ܢ ܪܫܵܡܬܵܐ ܚܲܕ݇ ܪܹܫܵܝܬܵܐ، ܘܲܗܘܹܐ ܠܹܗ ܐܲܝܟܼ ܖܸ̈ܡܙܹܐ ܒܘܼܫ ܓܖ̈ܝܼܕܵܝܹܐ، ܐܲܝܟܼ ܡܲܦܠܲܚܬܵܐ ܕܟܵܘܟܼܒܼܵܐ ܠܲܪܡܵܙܵܐ ܥܲܠ ܐܲܠܵܗܵܐ ܐܵܘ ܫܡܲܝܵܐ.</span><br>

                                    <span class="bold">ܡܲܫܩܠܵܐ ܗܸܓܼܝܵܢܵܝܵܐ ܩܵܠܵܝܵܐ:</span><br>
                                    <span>ܡܛܘܼܘܪܸܢܵܗ̇ ܟܬܵܒܼܬܵܐ ܠܗܸܓܼܝܵܢܹ̈ܐ، ܘܐܵܗܵܐ ܡܲܫܩܠܵܐ ܦܝܼܫܠܹܗ ܥܒܼܝܼܕܵܐ ܕܝܼܠܵܢܵܐܝܼܬ ܒܝܲܕ ܐܲܟܲܕܵܝܹ̈ܐ ܒܩܘܼܪܒܵܐ ܕܲܫܲܢ݇ܬܵܐ ܕ 2350 ܩ.ܡ، ܟܲܕ ܖܸ̈ܡܙܹܐ ܒܘܼܫ ܦܝܼܫܠܲܝܗܝ ܡܘܼܦܫܸܛܹ̈ܐ، ܘܟܠ ܚܲܕ݇ ܪܸܡܙܵܐ ܩܲܡ ܗܵܘܹܐ ܠܹܗ ܛܝܼܡܵܐ ܩܵܠܵܝܵܐ ܡܬܘܼܚܡܵܐ.</span><br>

                                    <span>ܘܥܲܡ ܡܛܵܘܪܵܢܘܼܬܵܐ ܕܲܡܕܝܼܢܵܝ̈ܘܵܬܵܐ، ܪܘܸܚܠܲܝܗܝ ܡܲܦܠܲܚ̈ܝܵܬܵܐ ܕܲܟܬܵܒܼܬܵܐ ܨܸܨܵܝܬܵܐ ܕܚܵܒܼܫܵܐ ܪܵܒܵܐ ܓܝܼܓܼܠܹ̈ܐ، ܐܲܝܟܼ ܢܸܩܫܹ̈ܐ ܡܲܠܟܵܝܹ̈ܐ، ܡܫܲܕܲܪܬܵܐ ܕܐܸܓܖ̈ܵܬܵܐ، ܐܸܫܛܵܖܹ̈ܐ ܐܸܩܢܘܿܡܝܵܝܹ̈ܐ، ܐܵܣܝܘܼܬܵܐ، ܣܵܦܪܘܼܬܵܐ، ܙܪܵܥܬܵܐ، ܩܵܢܘܿܢܹ̈ܐ، ܘܣܘܿܓܼ̈ܝܵܬܵܐ ܬܵܘܕܝܼܬܵܢܵܝܹ̈ܐ.</span><br>
                                    <br>

                                    <span class="bold">ܬܹܒܼܹܝܠܵܝܘܼܬܵܐ ܕܲܟܬܵܒܼܬܵܐ ܨܸܨܵܝܬܵܐ</span><br>
                                    <span>ܦܪܸܣܠܵܗ̇ ܟܬܵܒܼܬܵܐ ܨܸܨܵܝܬܵܐ ܥܲܡ ܪܘܵܚܬܵܐ ܕܐܸܡܦܪܵܛܘܿܖ̈ܘܵܬܵܐ ܕܐܲܟܲܕܵܝܹ̈ܐ ܘܐ݇ܚܲܪܬܵܐ ܕܐܵܬܘܿܖ̈ܵܝܹܐ ܘܲܕܒܵܒܼܹܝܠܵܝܹ̈ܐ، ܕܚܵܒܼܫܵܐ ܦܸܢ̈ܝܵܬܵܐ ܖ̈ܘܝܼܚܹܐ ܡ̣ܢ ܥܝܼܪܵܩ ܘܐܝܼܪܵܢ ܘܬܘܼܪܟܝܵܐ ܘܣܘܼܪܝܵܐ، ܘܲܗܘܹܐ ܠܵܗ̇ ܐܲܝܟܼ ܠܸܫܵܢܵܐ ܡܫܵܘܬܦܵܐ ܠܲܫܩܵܠ ܝܗܵܒܼܵܐ ܓܵܘ ܥܵܠܡܵܐ ܥܲܬܝܼܩܵܐ، ܘܦܝܼܫܠܹܗ ܐܵܗܵܐ ܠܸܫܵܢܵܐ ܐܲܝܟܼ ܗܵܘ ܠܸܫܵܢܵܐ ܬܹܒܼܹܝܠܵܝܵܐ ܩܲܕ݇ܡܵܝܵܐ، ܘܦܝܼܫܠܵܗ̇ ܗܵܕܟܼܵܐ ܗܲܠ ܡܲܒܥܵܢܘܼܬܵܐ ܕܲܟܬܵܒܼܬܵܐ ܐܘܿܓܵܪܝܼܬܵܝܬܵܐ ܒܕܵܪܵܐ ܕ 14 ܩ.ܡ.</span><br>
                                    <br>

                                    <span class="bold">ܬܲܩܢܝܼܩܵܝܘܼܬܵܐ ܕܲܟܬܵܒܼܬܵܐ ܨܸܨܵܝܬܵܐ</span><br>
                                    <span>ܟܹܐ ܦܵܝܫܵܐ ܗ݇ܘܵܐ ܢܩܝܼܫܬܵܐ ܥܲܠ ܠܘܼܚܹ̈ܐ ܛܝܼܢܵܝܹ̈ܐ ܒܡܲܦܠܲܚܬܵܐ ܕܩܲܠܵܡܵܐ ܕܐܝܼܬ ܠܹܗ ܪܹܫܵܐ ܡܬܲܠܬܵܐ ܕܲܡܬܲܪܸܨ ܖܸ̈ܡܙܹܐ ܕܕܵܡܝܼ ܠܨܸܨܹ̈ܐ، ܘܐ݇ܚܲܪܬܵܐ ܟܹܐ ܦܵܝܫܝܼ ܡܘܼܒܖܸ̈ܙܹܐ ܐܲܢܹܐ ܠܘܼܚܹ̈ܐ ܐܵܘ ܡܘܼܩܕܹ̈ܐ ܕܦܵܝܫܝܼ ܨܸܘܝܹ̈ܐ ܘܲܢܛܝܼܖܹ̈ܐ، ܘܝܼܗ݇ܘܵܐ ܡܚܘܼܝܨܸܪܬܵܐ ܒܲܠܚܘܿܕ ܠܟܲܬܵܒܼܹ̈ܐ ܕܦܝܼܫܠܲܝܗܝ ܚܫܝܼܒܼܹ̈ܐ ܡܵܖ̈ܲܝ ܝܼܕܲܥܬܵܐ ܩܲܕܝܼܫܬܵܐ، ܘܦܝܼܫܠܵܗ̇ ܐ݇ܣܝܼܪܬܵܐ ܟܬܵܒܼܬܵܐ ܒܐܲܠܵܗܬܵܐ ܕܝܼܠܵܢܵܝܬܵܐ، ܗܵܝ ܕܝܼܠܵܗ̇ ܐܲܠܵܗܬܵܐ ܢܝܼܣܵܒܵܐ ܘܟܹܐ ܦܵܐܹܫ ܪܡܝܼܙܵܐ ܐܸܠܵܗ̇ ܒܫܸܒܠܬܵܐ ܕܩܲܡܚܵܐ، ܘܐܵܗܵܐ ܡܲܚܙܘܿܝܹܐ ܝܠܹܗ ܪܵܡܘܼܬܵܐ ܕܫܵܘܦܵܗ̇.</span><br>
                                    <br>

                                    <span class="bold">ܒܚܘܼܬܵܡܵܐ:</span><br>
                                    <span>ܟܬܵܒܼܬܵܐ ܦܝܼܫܬܵܐ ܝܗ݇ܘܵܐ ܚܫܝܼܒܼܬܵܐ ܚܲܕ݇ ܬܚܘܼܡܵܐ ܦܵܪܫܵܢܵܐ ܒܲܝܢ ܙܲܒܼܢܹ̈ܐ ܕܩܵܕ݇ܡ ܬܲܫܥܝܼܬܵܐ ܘܙܲܒܼܢܹ̈ܐ ܬܲܫܥܝܼܬܵܢܵܝܹ̈ܐ، ܟܲܕ ܡܚܘܼܡܹܐ ܠܵܗ̇ ܠܝܵܪܬܘܼܬܵܐ ܕܲܡܕܝܼܢܵܝ̈ܘܵܬܵܐ ܠܐܲܠܦܵܝܹ̈ܐ ܕܫܸܢܹ̈ܐ، ܐܲܝܟܼ ܡܕܝܼܢܵܝ̈ܘܵܬܵܐ ܕܒܹܝܬ ܢܲܗܖ̈ܝܼܢ ܘܫܵܡ ܘܐܝܼܪܵܢ ܘܡܸܨܪܝܼܢ ܘܓܵܙܲܪܬܵܐ ܕܲܟܪܝܼܬ ܒܝܘܿܢܵܢ، ܠܗܵܕܟܼܵܐ ܚܫܝܼܒܼܬܵܐ ܝܠܵܗ̇ ܚܲܕ݇ ܡ̣ܢ ܕܐܵܢܝܼ ܫܘܼܡܠܵܝܹ̈ܐ ܒܘܼܫ ܖ̈ܲܒܹܐ ܕܒܲܪܢܵܫܵܐ، ܟܲܕ ܡܨܹܐ ܠܵܗ̇ ܕܲܡܚܲܡܝܵܐ ܠܝܼܕܲܥܬܵܐ ܘܲܡܫܲܢܝܵܐ ܠܵܗ̇ ܩܵܐ ܝܘܼܒܵܠܹ̈ܐ، ܘܲܫܩܸܠܠܵܗ̇ ܣܲܗܡܵܐ ܓܵܘ ܒܢܵܝܵܐ ܡܕܝܼܢܵܝܘܼܬܵܐ ܒܲܪܢܵܫܵܝܬܵܐ ܘܲܡܛܵܘܪܲܢܬܵܗ̇.</span><br>

                                </p>

