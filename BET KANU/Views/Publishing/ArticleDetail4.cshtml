                        <!-- Western -->
                        <div class="col-md-6 col-sm-12 ">
                            <div class="well h-100  text-center" style="direction: rtl" id="western">
                                <h3 class="padding-bottom-10" style="direction:ltr">Western Syriac</h3>

                                <span class="Surayt bold text-center">
                                    ܡܰܒܥܳܢܽܘܬ̥ܳܐ ܕܺܗ̄ܝ ܟܬ̥ܰܒ̥ܬܳܐ: ܩܰܘܡܳܐ ܕ݄ܡܫܰܚܠܰܦ ܠܶܗ ܗ̄ܽܘ ܡܰܟܬ̥ܰܒܙܰܒܢܳܐ ܕܽܗ̄ܘ ܒܰܪܢܳܫܳܐ
                                </span>

                                <br>
                                <br>

                                <p class="Surayt text-right">

                                    <span>ܡܝܨܰܘ݄ܪ ܥܳܠܡܳܐ ܕܠܳܐ ܟܬ̥ܰܒ̥ܬܳܐ ܘܠܳܐ ܐܳܬ̥ܘ̈ܳܬ̥ܳܐ ܘܠܳܐ ܣܶܓܳܠܳܐ ܕܢ݄ܛܪܺܝ ܗ̄ܽܘ ܕܽܘܟ̥ܪܳܢܳܐ ܕܽܗ̄ܘ ܒܰܪܢܳܫܳܐ. ܥܳܠܡܳܐ ܕܟ݄ܬܝܳܐ ܣܢܺܝܕܳܐ ܥܰܠ ܗ̄ܽܘ ܩܳܠܳܐ ܠܚܽܘܕܶܗ، ܐܶܒܶܗ ܗ̄ܺܝ ܡܶܠܬ̥ܳܐ ܟܳܡܺܝܬܰܘܠܕܳܐ ܘܟܳܡܰܝܬ̥ܳܐ ܒܥܰܝܢܺܝ ܙܰܒܢܳܐ.</span><br>
                                    <span>ܒܗܰܘܟ̥ܰܐ ܥܳܠܡܳܐ، ܗ̄ܺܝ ܫܟܰܚܬܳܐ ܕܺܗ̄ܝ ܟܬ݂̥ܰܒ̥ܬܳܐ ܗܰܘܝܳܐ ܩܰܘܡܳܐ ܒܽܗ̄ܘ ܝܽܘܠܦܳܢܳܐ ܘܒܽܗ̄ܘ ܪܶܢܝܳܐ ܘܡܫܰܚܠܰܦ ܠܶܗ ܟܽܠܳܢܳܐܺܝܬ̥ ܗ̄ܽܘ ܗܰܠܟ̥ܳܐ ܕܺܗ̄ܝ ܡܕܺܝܢܳܝܽܘܬ̥ܳܐ ܕܽܗ̄ܘ ܒܰܪܢܳܫܳܐ.</span><br>
                                    <span>ܘܗܰܘܟ̥ܰܐ ܩܰܕ݄ܪ ܗ̄ܽܘ ܒܰܪܢܳܫܳܐ ܕܢܳܛ݄ܪ ܗ̄ܺܝ ܝܕܰܥܬܳܐ ܘܽܗ̄ܘ ܝܘܠܦܳܢܐ ܘܽܗ̄ܘ ܛܘܟܳܣܐ ܕܰܚܰܝ̈ܰܝܕ̥ܶܗ ܘܕܺܗ̄ܝ ܬܰܓܳܪܘܬ̥ܳܐ ܒܺܗ̄ܝ ܟܬ̥ܰܒ̥ܬܳܐ ܘܠܳܐ ܡܶܢ̱ ܦܶܡܳܐ ܠܦܶܡܳܐ.</span><br>
                                    <br>

                                    <span class="bold">ܡܰܒܥܳܢܽܘܬ̥ܳܐ ܕܺܗ̄ܝ ܟܬ̥ܰܒ̥ܬܳܐ:</span><br>
                                    <span>ܗ̄ܰܫܽܘܡܪ̈ܳܝܶܐ ܣ݄ܡّܶܗ ܗ̄ܺܝ ܟܬ̥ܰܒ̥ܬܳܐ ܨܶܨܳܝܬܳܐ ܚܶܕܳܪ ܕܗ̄ܺܝ ܫܰܢ̱ܬܳܐ ܕ (3500-3200 ܩ.ܡ) ܒܰܡܕܺܝ̈ܢܳܬ̥ܳܐ ܕܟܺܝܫ ܘܐܽܘܪܽܘܟ، ܗܰܢܳܐ ܗ̄ܽܘ ܛܶܟܣܳܐ ܕܺܗ̄ܝ ܟܬ̥ܰܒ̥ܬܳܐ ܗ̄ܽܘ ܩܰܕ̱ܡܳܝܳܐ ܕܺܝܕܺܝܥ ܒܽܗ̄ܘ ܡܰܟܬ̥ܰܒܙܰܒܢܳܐ، ܘܫܰܦ݄ܝܥܳܐ ܗ̄ܺܝ ܟܬ̥ܰܒ̥ܬܰܬ̥ܶܐ ܒ݄ܬܠܳܬ̥ܳܐ ܡܰܫܩܠ̈ܶܐ ܪܺܝܫܳܝ̈ܶܐ:</span><br>
                                    <br>

                                    <span class="bold">ܡܰܫܩܠܳܐ ܨܽܘܪܬܳܢܳܝܳܐ:</span><br>
                                    <span>ܗܰܘܺܝ ܐܶܒܶܗ ܪܫܳܡܳܐ ܕܟܳܕܳܡܶܐ ܠܰܡܶܕܳܢ̈ܶܐ ܘܡ݄ܙܕܺܝ ܗ̄ܘܰܘ ܪ̈ܶܡܙܶܐ ܡܶܢܝܳܢܳܝ̈ܶܐ ܥܰܠ ܗ̄ܺܝ ܟܡܳܝܽܘܬ̥ܳܐ.</span><br>
                                    <br>

                                    <span class="bold">ܡܰܫܩܠܳܐ ܪܶܡܙܳܢܳܝܳܐ:</span><br>
                                    <span>ܪܰܚ݄ܩ ܒ݄ܚܕܳܐ ܢܰܩܠܰܐ ܡܽܗ̄ܘ ܪܫܳܡܳܐ، ܘܰܪ̈ܶܡܙܶܐ ܗܰܘ݄ܢ ܙ݄ܕ ܓܕܺܝܡ̈ܶܐ، ܡܰܬ̥ܠܳܐ ܥܰܠ ܗ̄ܽܘ ܡܶܕܰܢܳܐ ܗ̄ܽܘ ܟܽܘܟܒ̥ܳܐ ܪܶܡܙܳܐ ܗ̄ܘܰܐ ܠܐܰܠܳܗܳܐ ܐܰܘ ܠܺܗ̄ܝ ܫܡܰܝܳܐ.</span><br>
                                    <br>

                                    <span class="bold">ܡܰܫܩܠܳܐ ܗܶܓܝܳܢܳܝܳܐ ܩܳܠܳܝܳܐ:</span><br>
                                    <span>ܡܛܰܘܪܳܐ ܗ̄ܺܝ ܟܬ̥ܰܒ̥ܬܳܐ ܠܽܗ̄ܘ ܗܶܓܝܳܢܳܐ ܘܽܗ̄ܘ ܡܰܫܩܠܰܢܳܐ ܣܺܝܡ ܕܺܝܠܳܢܳܐܝܬ̥ ܡܰܢ̱ ܐܰܟܰܕ̈ܳܝܶܐ ܚܶܕܳܪ ܕܺܗ̄ܝ ܫܰܢ̱ܬܳܐ ܕ 2350 ܩ.ܡ، ܗ̄ܺܝ ܢܰܩܠܰܐ ܕܰܪ̈ܶܡܙܶܐ ܗܰܘ݄ܢ ܦܫܺܝ̈ܛܶܐ ܙ݄ܕ ܘܟܽܘܠ ܪܶܡܙܳܐ ܟ݄ܬ ܗ̄ܘܰܝ ܠܶܗ ܛܺܝܡܳܐ ܩܳܠܳܢܳܝܳܐ ܡܬܰܚܡܳܐ.</span><br>
                                    <br>

                                    <span>ܘܥܰܡ ܗ̄ܺܝ ܡܛܰܘܪܳܢܽܘܬ̥ܳܐ ܕܰܡܕܺܝܢܳܝܘ̈ܳܬ̥ܳܐ ܦܪܺܝܣܳܐ ܗ̄ܺܝ ܟܬ̥ܰܒ̥ܬܳܐ ܕܰܒ݄ܣܡܳܪ̈ܶܐ ܘܦܰܝ݄ܫ ܟܳܡ݄ܟܬ̥ܳܒ̥ܳܐ ܠܰܢܶܩܫ̈ܶܐ ܡܰܠܟܳܝ̈ܶܐ، ܫܶܕܳܪܳܐ ܕܰܗ̄ܢ ܐܶܓܪ̈ܳܬ̥ܳܐ، ܘܰܪ̈ܩܶܐ ܐܶܩܳܢܽܘܡܝܳܝ̈ܶܐ، ܐܳܣܝܽܘܬ̥ܳܐ، ܣܳܦܪܳܝܽܘܬ̥̥ܳܐ، ܙܪܳܥܳܐ، ܩܳܢܽܘܢ̈ܶܐ ܘܣܽܘܓ̥ܝ̈ܳܬ̥ܳܐ ܬܰܘܕܺܝܬ̥ܳܢܳܝ̈ܶܐ.</span><br>
                                    <br>

                                    <span class="bold">ܗ̄ܺܝ ܬܺܒܶܝܠܳܝܽܘܬ̥ܳܐ ܕܺܗ̄ܝ ܟܬ̥ܰܒ̥ܬܳܐ ܕܰܒܣܡܳܪ̈ܶܐ:</span><br>
                                    <span>ܦܪܺܝܣܳܐ ܗ̄ܺܝ ܟܬ̥ܰܒ̥ܬܳܐ ܕܰܒܣܡܳܪ̈ܶܐ ܥܰܡ ܗ̄ܽܘ ܝܪܳܒ̥ܳܐ ܕܺܗ̄ܝ ܡܰܠܟܽܘܬ̥ܳܐ ܕܰܗ̄ܢ ܐܰܟܰܕ̈ܳܝܶܐ ܘܒ݄ܬ̥݄ܪ ܕܰܗ̄ܢ ܐܳܬ̥ܽܘܪ̈ܳܝܶܐ ܘܕܰܒܳܒܠܳܝ̈ܶܐ، ܘܡܰܛܝܳܐ ܗ̄ܘܰܐ ܠܦܶܢܝܳܬ̥̈ܳܐ ܪ̈ܘܺܝܚܶܐ ܡܽܗ̄ܘ ܥܺܝܪܰܩ ܘܐܺܝܪܰܢ ܘܬܽܘܪܟܺܝܰܐ ܘܣܽܘܪܺܝܰܐ، ܘܗܰܘܝܳܐ ܗ̄ܘܰܐ ܠܶܫܳܢܳܐ ܡܫܰܘܬܦܳܐ ܠܽܗ̄ܘ ܡܰܗܒ̥ܳܐ ܘܫܩܳܠܳܐ ܒܽܗ̄ܘ ܥܳܠܡܳܐ ܥܰܬܺܝܩܳܐ.</span><br>
                                    <span>ܘܗܰܘܝܳܐ ܗ̄ܘܰܐ ܣܬܶܝ ܗ̄ܽܘ ܠܶܫܳܢܳܐ ܬܺܒܶܝܠܳܝܳܐ ܩܰܕ̱ܡܳܝܳܐ. ܘܺܗ̄ܝ ܟܬ̥ܰܒ̥ܬܳܐ ܦܰܝܺܝܫܳܐ ܗܰܘܟ̥ܰܐ ܗܳܠ ܠܺܗ̄ܝ ܫܟܰܚܬܳܐ ܕܺܗ̄ܝ ܐܳܠܰܦܒܶܝܬ̥ ܕܐܽܘܓܰܪܶܝܬ ܒܽܗ̄ܘ ܕܳܪܳܐ ܕ14 ܩ.ܡ.</span><br>
                                    <br>

                                    <span class="bold">ܗ̄ܺܝ ܬܶܩܢܺܝܩܳܝܽܘܬ̥ܳܐ ܕܺܗ̄ܝ ܟܬ̥ܰܒ̥ܬܳܐ ܨܶܨܳܝܬܳܐ:</span><br>
                                    <span>ܡܢܩܳܫܳܐ ܗ̄ܘܰܐ ܥܰܠ ܠܽܘܚ̈ܶܐ ܕܽܗ̄ܘ ܛܺܝܢܳܐ ܘ݄ܒܩܰܢܝܳܐ ܕܟ݄ܬ ܠܶܗ ܪܺܝܫܳܐ ܡܬ̥ܰܠܬ̥ܳܐ ܕܣܳܝ݄ܡ ܗ̄ܘܰܐ ܪ̈ܶܡܙܶܐ ܕܕܳܡ݄ܢ ܗ̄ܘܰܘ ܠܨܶܨ̈ܶܐ، ܡܰܢ݄ܫܦܺܝ ܗ̄ܘܰܘ ܐܰܘ ܡܰܘܩܕܺܝ ܗ̄ܘܰܘ ܗ̄ܰܠܽܘܚ̈ܶܐ ܕܦܰܝܫܺܝ ܢܛܺܝܪ̈ܶܐ، ܘܺܗ̄ܝ ܟܬ̥ܰܒ̥ܬܳܐ ܒܰܠܚܽܘܕ ܒܺܐܝܕ̈ܶܐ ܕܰܟܰܬ̥ܳܒ̥̈ܶܐ ܗ̄ܘܰܐ ܥܰܠ ܕܡ݄ܚܫܳܒ̥ܺܝ ܗ̄ܘܰܘ ܡܳܪ̈ܶܐ ܕܺܗ̄ܝ ܝܺܕܰܥܬܳܐ ܩܰܕܺܝܫܬܳܐ، ܘܡܰܐܣ݄ܪܬܳܐ ܗ̄ܘܰܐ ܗ̄ܺܝ ܟܬ̥ܰܒ̥ܬܳܐ ܒܰܐܠܳܗܬܳܐ ܕܺܝܠܳܢܳܝܬܳܐ ܢܺܝܣܰܒܰܐ ܕܟ݄ܬ ܗ̄ܘܰܐ ܡܨܰܘܰܪܬܳܐ ܒܫܶܒܠܳܐ ܕܩܰܡܚܳܐ، ܗ̄ܽܘ ܡܶܕܰܢܳܐ ܡܰܚܘܶܐ ܗ̄ܘܰܐ ܗ̄ܺܝ ܪܳܡܽܘܬ̥ܰܝܕܰܗ.</span><br>
                                    <br>

                                    <span class="bold">ܚܽܘܬ̥ܳܡܳܐ:</span><br>
                                    <span>ܗ̄ܺܝ ܟܬ̥ܰܒ̥ܬܳܐ ܚܫܺܝܒ̥ܬܳܐ ܗ̄ܘܰܐ ܐ̱ܟ̥ ܕܬܚܽܘܡܳܐ ܕܦܳܪܰܫ ܗ̄ܘܰܐ ܒܰܝܢ ܕܰܕܳܪ̈ܶܐ ܕܡܶܩ݄ܕ̱ܡ ܡܽܗ̄ܘ ܡܰܟܬ̥ܰܒܙܰܒܢܳܐ ܘܰܕܳܪ̈ܶܐ ܡܰܟܬ̥ܰܒܙܰܒܢܳܝ̈ܶܐ، ܥܰܠ ܕ݄ܢܛ݄ܪ ܠܰܗ ܗ̄ܺܝ ܝܳܪܬܽܘܬ̥ܳܐ ܕܰܡܕܺܝܢܳܝܘ̈ܳܬ̥ܳܐ ܠܰܐܠܦܰܝ̈ܳܐ ܕܐ݄ܫܢ̈ܶܐ، ܐ̱ܟ̥ ܕܰܡܕܺܝܢܳܝܘ̈ܳܬ̥ܳܐ ܕܒܶܝܬܢܰܗܪܺܝܢ ܘܫܰܡ ܘܺܐܝܪܰܢ ܘܡܶܨܪܶܝܢ ܘܺܗ̄ܝ ܓܳܙܰܪܬܳܐ ܕܟܪܺܝܬ ܒܝܰܘܢܳܢ، ܥܰܠ ܗܰܘܟ̥ܳܐ ܚܫܺܝܒ̥ܬܳܐ ܝܳܐ ܣܬܶܝ ܡܰܢ̱ ܥܒ̥ܳܕ̈ܶܐ ܪ̈ܰܒܶܐ ܕܽܗ̄ܘ ܒܰܪܢܳܫܳܐ، ܥܰܠ ܕܗܰܘܺܝ ܠܰܗ ܣܰܗܡܳܐ ܒܽܗ̄ܘ ܒܢܳܝܳܐ ܘܒܽܗ̄ܘ ܛܽܘܘܳܪܳܐ ܕܺܗ̄ܝ ܡܕܺܝܢܳܝܽܘܬ̥ܳܐ ܕܽܗ̄ܘ ܒܰܪܢܳܫܳܐ.</span><br>

                                </p>


