                        <!-- Eastern -->
                        <div class=" col-md-6 col-sm-12">
                            <div class="well h-100 text-center" style="direction: rtl" id="eastern">
                                <h3 class="padding-bottom-10" style="direction:ltr">Eastern Syriac</h3>

                                <span class="Surit bold text-center">
                                    ܝܘܼܠܦܵܢ ܡܬܲܠܬܹ̈ܐ ܓܹܒ ܒܵܒܼܹܠܵܝܹ̈ܐ
                                </span><br><br>

                                <p class="Surit text-right">

                                    <span>ܙܵܘܕܵܐ ܡ̣ܢ ܐܲܪܒܥܵܐ ܐܲܠܦܹ̈ܐ ܫܸܢܹ̈ܐ، ܒܵܒܼܹܠܵܝܹ̈ܐ ܟܹܐ ܢܵܩܫܝܼ ܗ݇ܘܵܘ ܣܘܼܖ̈ܓܵܕܹܐ ܕܲܩܝܼܩܹ̈ܐ ܥܲܠ ܠܘܼܚܹ̈ܐ ܛܝܼܢܵܝܹ̈ܐ، ܘܲܡܚܲܫܒܸܢܝܼ ܝܗ݇ܘܵܘ ܐܲܣܘܼܖܹ̈ܐ ܕܲܡܬܲܠܬܹ̈ܐ ܓܵܘ ܚܕܵܐ ܥܸܕܵܢܵܐ ܕܣܲܗܡܵܐ ܙܵܘܕܵܐ ܡ̣ܢ ܡܕܝܼܢܵܝ̈ܘܵܬܵܐ ܗܵܠܵܐ ܠܵܐ ܝܗ݇ܘܵܘ ܡܛܘܼܘܖܸ̈ܢܹܐ ܝܘܼܠܦܵܢ ܡܲܢܵܝܘܼܬܵܐ.</span><br>

                                    <span>ܘܠܵܐ ܝܗ݇ܘܵܘ ܐܲܢܹܐ ܢܸܩܫܹ̈ܐ ܐܲܚܟ̰ܝܼ ܖ̈ܲܩܡܹܐ ܢܩܝܼܫܹ̈ܐ ܥܲܠ ܛܝܼܢܵܐ، ܐܝܼܢܵܐ ܝܼܗ݇ܘܵܘ ܚܕܵܐ ܡܫܲܪܲܝܬܵܐ ܠܝܵܪܬܘܼܬܵܐ ܝܘܼܠܦܵܢܵܝܬܵܐ ܕܲܡܥܘܼܒܕܸܢܵܗ̇ ܐ݇ܚܲܪܬܵܐ ܥܲܠ ܬܲܫܥܝܼܬܵܐ ܕܝܼܕܲܥܬܵܐ ܐ݇ܢܵܫܵܝܬܵܐ.</span><br>
                                    <br>

                                    <span>ܘܐܵܦܸܢ ܕܲܚܫܲܚܬܵܐ ܕܝܘܼܠܦܵܢ ܡܬܲܠܬܹ̈ܐ ܠܵܐ ܝܗ݇ܘܵܐ ܝܕܝܼܥܬܵܐ ܒܲܚܫܵܠܬܵܗ̇ ܕܵܪܵܝܬܵܐ ܒܗܵܘ ܙܲܒܼܢܵܐ، ܐܝܼܢܵܐ ܕܖ̈ܵܫܝܵܬܵܐ ܕܵܖ̈ܵܝܹܐ ܡܲܚܙܘܿܝܹܐ ܝܠܲܝܗܝ ܕܒܵܒܼܹܠܵܝܹ̈ܐ ܡܘܼܬܸܒܼܠܲܝܗܝ ܐܸܣܹ̈ܐ ܒܟܼܝܼܖܹ̈ܐ ܠܐܵܗܵܐ ܝܘܼܠܦܵܢܵܐ ܩܵܕ݇ܡ ܡܕܝܼܢܵܝܘܼܬܵܐ ܝܵܘܢܵܝܬܵܐ ܘܲܡܕܝܼܢܵܝܘܼܬܵܐ ܐܸܣܠܵܡܵܝܬܵܐ ܒܕܵܖܹ̈ܐ.</span><br>
                                    <br>

                                    <span class="bold">ܠܘܼܚܵܐ ܕܲܦܠܸܡܦܬܘܿܢ 322</span><br>

                                    <span>ܐܵܗܵܐ ܠܘܼܚܵܐ ܛܝܼܢܵܝܵܐ ܕܝܼܠܹܗ ܝܕܝܼܥܵܐ ܒܫܸܡܵܐ ܕܲܦܠܸܡܦܬܘܿܢ 322، ܚܫܝܼܒܼܵܐ ܝܠܹܗ ܚܕܵܐ ܡ̣ܢ ܕܐܵܢܝ݇ ܡܲܫ݇ܟ̰ܲܚ̈ܝܵܬܵܐ ܡܲܢܵܝܘܼܬܵܢܵܝܹ̈ܐ ܒܘܼܫ ܐܵܢܲܢܩܵܝܹ̈ܐ ܓܵܘ ܥܵܠܡܵܐ ܥܲܬܝܼܩܵܐ.</span><br>

                                    <span>ܕܥܵܪܵܐ ܝܠܵܗ̇ ܬܲܫܥܝܼܬܹܗ ܠܩܘܼܪܒܵܐ ܕ 1800 ܩ.ܡ، ܘܲܚܒܼܵܫܵܐ ܝܠܹܗ ܣܘܼܖ̈ܓܵܕܹܐ ܡܸܢܝܵܢܵܝܹ̈ܐ ܕܲܩܝܼܩܹ̈ܐ ܕܡܲܚܙܝܼ ܐܲܣܘܼܖܹ̈ܐ ܕܝܼܠܵܢܵܝܹ̈ܐ ܒܲܡܬܲܠܬܵܐ ܬܪܝܼܨܵܐ:</span><br>

                                    <span>ܘܐܲܢܹܐ ܐܲܣܘܼܖܹ̈ܐ ܝܕܝܼܥܹ̈ܐ ܝܠܲܝܗܝ ܐܸܕܝܘܿܡ ܒܫܸܡܵܐ ܕܬܹܐܘܿܪܝܼܵܐ ܕܦ̮ܝܼܬܼܵܓܘܿܪܣ.</span><br>

                                    <span>ܘܐܵܗܵܐ ܠܘܼܚܵܐ ܡܘܼܚܙܹܐ ܠܹܗ ܕܒܵܒܼܹܠܵܝܹ̈ܐ ܝܕܸܥܠܲܝܗܝ ܐܲܢܹܐ ܐܲܣܘܼܖܹ̈ܐ ܡܲܢܵܝܘܼܬܵܢܵܝܹ̈ܐ ܩܵܕ݇ܡ ܦ̮ܝܼܬܼܵܓܘܿܪܣ ܒܕܵܖܹ̈ܐ ܝܲܖ̈ܝܼܟܼܹܐ، ܘܡܘܼܦܠܸܚܠܲܝܗܝ ܐܸܠܹܗ ܝܘܼܠܦܵܢܵܐܝܼܬ ܓܵܘ ܡܲܚܵܪܘܼܬܵܐ ܘܚܘܼܫܒܵܢܹ̈ܐ.</span><br>
                                    <br>

                                    <span class="bold">ܝܘܼܠܦܵܢ ܡܬܲܠܬܹ̈ܐ ܒܵܒܼܹܠܵܝܹ̈ܐ</span><br>

                                    <span>ܒܵܒܼܹܠܵܝܹ̈ܐ ܣܢܸܕܠܲܝܗܝ ܥܲܠ ܦܸܚܡܵܝ̈ܘܵܬܵܐ ܕܒܲܝܢ ܐܸܠܥܹ̈ܐ ܕܲܡܬܲܠܬܵܐ ܬܖ̈ܝܼܨܹܐ، ܘܝܵܘܢܵܝܹ̈ܐ ܡܛܘܼܘܪܸܢܲܝܗܝ ܐ݇ܚܲܪܬܵܐ ܝܘܼܠܦܵܢ ܡܬܲܠܬܹ̈ܐ ܒܸܢܝܵܐ ܥܲܠ ܙܵܘ̈ܝܵܬܵܐ ܘܚܘܼܕܖܹ̈ܐ.</span><br>
                                    <br>

                                    <span>ܘܐܵܗܵܐ ܡܦܲܪܡܲܝܬܵܐ ܡܲܢܵܝܘܼܬܵܢܵܝܬܵܐ ܒܵܒܼܹܠܵܝܬܵܐ ܡܥܘܼܕܸܪܵܗ̇ ܓܵܘ:</span><br>
                                    <span>ܟܝܵܠܵܐ ܐܲܪ̈ܥܵܬܵܐ</span><br>
                                    <span>ܒܢܵܝܵܐ ܒܵܬܲܝ̈ ܣܓܼܵܕܵܐ ܘܙܲܩܘܼܖܹ̈ܐ</span><br>
                                    <span>ܡܚܲܫܒܲܢܬܵܐ ܕܲܨܠܵܝܵܬ̈ܵܐ ܘܐ݇ܣܵܠ݇ܩ̈ܝܵܬܵܐ</span><br>
                                    <span>ܥܒܼܵܕܵܐ ܚܘܼܫܒܵܢܹ̈ܐ ܕܝܘܼܠܦܵܢ ܟܵܘܟܼܒܼܹ̈ܐ</span><br>
                                    <br>

                                    <span class="bold">ܡܲܢܵܝܘܼܬܵܐ ܘܝܘܼܠܦܵܢ ܟܵܘܟܼܒܼܹ̈ܐ ܓܹܒ ܒܵܒܼܹܠܵܝܹ̈ܐ</span><br>

                                    <span>ܡܲܢܵܝܘܼܬܵܐ ܒܵܒܼܹܠܵܝܬܵܐ ܦܝܼܫܠܵܗ̇ ܐ݇ܣܝܼܪܬܵܐ ܒܝܘܼܠܦܵܢ ܟܵܘܟܼܒܼܹ̈ܐ ܘܡܲܚܵܪܘܼܬܵܐ ܚܕܵܐ ܐ݇ܣܵܪܬܵܐ ܚܲܝܠܵܢܬܵܐ، ܘܐܵܦ ܛܲܟܼܣܵܐ ܐܸܫܬܝܼܢܵܝܵܐ ܒܵܒܼܹܠܵܝܵܐ ܡܥܘܼܕܸܪܹܗ ܓܵܘ ܥܒܼܵܕܵܐ ܚܘܼܫܒܵܢܹ̈ܐ ܕܲܩܝܼܩܹ̈ܐ ܕܦܝܼܫܠܲܝܗܝ ܡܘܼܦܠܸܚܹ̈ܐ ܓܵܘ ܟܝܵܠܵܐ ܙܵܘ̈ܝܵܬܵܐ ܘܙܵܘܥܵܐ ܕܓܘܼܫܡܹ̈ܐ ܫܡܲܝܵܢܹ̈ܐ.</span><br>
                                    <br>

                                    <span>ܘܡܘܼܦܠܸܚܠܲܝܗܝ ܒܵܒܼܹܠܵܝܹ̈ܐ ܡܲܢܵܝܘܼܬܵܐ ܓܵܘ:</span><br>
                                    <span>ܥܒܼܵܕܬܵܐ ܕܣܘܼܖ̈ܓܵܕܹܐ ܕܝܘܼܠܦܵܢ ܟܵܘܟܼܒܼܹ̈ܐ</span><br>
                                    <span>ܡܬܲܚܘܿܡܹܐ ܝܲܬܒܹ̈ܐ ܕܛܲܥܝܹ̈ܐ</span><br>
                                    <span>ܡܣܲܟܘܿܡܹܐ ܒܸܢܝܵܢܹ̈ܐ ܡܲܚܵܖ̈ܵܝܹܐ ܓܒܼܘܿܖܹ̈ܐ</span><br>
                                    <span>ܦܠܵܓܼܵܐ ܐܲܖ̈ܥܵܬܵܐ ܘܲܒܢܵܝܵܐ ܩܲܢܝܹ̈ܐ ܕܡܲܝܵܐ</span><br>
                                    <br>

                                    <span class="bold">ܚܘܼܬܵܡܵܐ</span><br>

                                    <span>ܠܵܐ ܝܠܲܝܗܝ ܡܫܘܼܬܐܸܣܹ̈ܐ ܒܵܒܼܹܠܵܝܹ̈ܐ ܝܘܼܠܦܵܢ ܡܬܲܠܬܹ̈ܐ ܒܦܸܨܠܵܐ ܕܝܼܠܹܗ ܗܵܕܝܼܵܐ ܝܕܝܼܥܵܐ، ܐܝܼܢܵܐ ܡܘܼܬܸܒܼܠܲܝܗܝ ܠܸܒܼܢܹ̈ܐ ܩܲܕ݇ܡܵܝܹ̈ܐ ܐܸܠܹܗ، ܒܐܘܼܪܚܵܐ ܕܲܡܛܵܘܪܲܢܬܲܝܗܝ ܠܡܲܢܵܝܘܼܬܵܐ ܘܝܘܼܠܦܵܢ ܟܵܘܟܼܒܼܹ̈ܐ ܘܣܘܼܖ̈ܓܵܕܹܐ ܡܸܢܝܵܢܵܝܹ̈ܐ ܕܲܩܝܼܩܹ̈ܐ، ܘܐܲܢܹܐ ܝܘܼܠܦܵܢܹ̈ܐ ܡܫܘܼܢܹܐ ܠܲܝܗܝ ܐ݇ܚܲܪܬܵܐ ܠܲܡܕܝܼܢܵܝܘܼܬܵܐ ܝܵܘܢܵܝܬܵܐ ܘܲܡܕܝܼܢܵܝܘܼܬܵܐ ܐܸܣܠܵܡܵܝܬܵܐ، ܘܐ݇ܚܲܪܬܵܐ ܠܝܘܿܪܘܿܦ ܚܲܕܬܵܐ.</span><br>

                                    <span>ܘܗܲܠ ܗܵܕܝܼܵܐ ܫܵܘܦܵܐ ܕܐܵܗܵܐ ܝܵܪܬܘܼܬܵܐ ܝܘܼܠܦܵܢܵܝܬܵܐ ܒܵܒܼܹܠܵܝܬܵܐ ܚܝܵܝܵܐ ܝܠܹܗ ܐܸܕܝܘܿܡ ܝܵܘܡܵܐ، ܡ̣ܢ ܦܠܵܓܼܬܵܐ ܕܥܸܕܵܢܵܐ ܘܙܵܘ̈ܝܵܬܵܐ ܥܲܠ ܐܸܣܹ̈ܐ ܕܡܲܢܵܝܘܼܬܵܐ ܕܵܪܵܝܬܵܐ.</span><br>

                                </p>

