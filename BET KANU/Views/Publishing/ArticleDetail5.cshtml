                <div class="">
                    <div class="row g-4 justify-content-between Articles">

                        <!-- Western -->
                        <div class="col-md-6 col-sm-12 ">
                            <div class="well h-100  text-center" style="direction: rtl" id="western">
                                <h3 class="padding-bottom-10" style="direction:ltr">Western Syriac</h3>

                                <span class="Surayt bold text-center">
                                    ܛܶܟܣܳܐ ܕܽܗ̄ܘ ܡܶܢܝܳܢܳܐ ܐ݄ܫܬܺܝܢܳܝܳܐ ܕܰܒܳܒܠܳܝ̈ܶܐ
                                </span>

                                <br>
                                <br>

                                <p class="Surayt text-right">

                                    <span class="bold">ܡܕܺܝܢܳܝܽܘܬ̥ܳܐ ܕܒܰܢܝܳܐ ܥܰܠ ܗ̄ܰܡܶܢܝܳܢ̈ܶܐ</span><br>

                                    <span>ܡܶܢ̱ ܙܰܒ̥ܢܳܐ ܝܰܪܺܝܟ̥ܳܐ ܡܶܩ݄ܕ̱ܡ ܕܢ݄ܦܩܺܝ ܗ̄ܰܡܳܐܢ̈ܶܐ ܕܽܗ̄ܘ ܚܫܳܒ̥ܳܐ ܘܰܛܶܟܣ̈ܶܐ ܡܶܢܝܳܢܳܝ̈ܶܐ، ܡܛܰܘܰܪ ܠ݄ܗ̱ܢ ܗ̄ܰܡܕܺܝܢܳܝܘ̈ܳܬ̥ܳܐ ܕܒܶܝܬܢܰܗܪ̈ܺܝܢ – ܘܕܺܝܠܳܢܳܐܝܬ̥ ܗ̄ܰܒܳܒܠܳܝ̈ܶܐ – ܚܰܕ̱ ܡܰܢ̱ ܛܶܟܣ̈ܶܐ ܥܰܫܺܝ̈ܢܶܐ ܕܽܗ̄ܘ ܡܶܢܝܳܢܳܐ ܒܽܗ̄ܘ ܡܰܟܬ̥ܰܒܙܰܒܢܳܐ܇ ܐܰܘܟܺܝܬ ܗ̄ܽܘ ܛܶܟܣܳܐ ܕܽܗ̄ܘ ܡܶܢܝܳܢܳܐ ܐ݄ܫܬܺܝܢܳܝܳܐ (ܐܶܣܳܐ ܕܰ 60).</span><br>

                                    <span>ܗ̄ܽܘ ܛܶܟܣܰܢܳܐ ܕܒܰܢܺܝ ܡܶܩ݄ܕ̱ܡ ܙ݄ܕ ܡܶܢ̱ ܐܰܪܒܥܰܐܠܦܳܐ ܐ݄ܫܢ̈ܶܐ، ܕܝܰܪܽܒ̥ ܡܶܢ̱ ܡܰܫܠܡܳܢܘ̈ܳܬ̥ܳܐ ܥܰܬܺܝܩ̈ܶܐ ܕܰܫܽܘܡܪ̈ܳܝܶܐ ܘܡܛܰܘ݄ܪ ܒ݄ܬ̥݄ܪ ܡܰܢ̱ ܣّܳܦܪ̈ܶܐ ܒܳܒܠܳܝ̈ܶܐ ܠܐܽܘܪܚܳܐ ܦܫܺܝܛܳܐ ܠܽܗ̄ܘ ܚܫܳܚܳܐ ܕܰܡܶܢܝܳܢ̈ܶܐ.</span><br>
                                    <br>

                                    <span>ܒܗܶܦܟ̥ܳܐ ܕܽܗ̄ܘ ܛܶܟܣܳܐ ܥܰܣܪܳܢܳܝܳܐ (ܐܶܣܳܐ ܕܰ 10) ܕܟܳܡܚܰܫܚܺܝܢܰܐ ܐܰܕܝܰܘܡܰܐ، ܗ̄ܰܒܳܒܠܳܝ̈ܶܐ ܟܳܗ̄ܒܳܢ݄ܢ ܗ̄ܘܰܘ̱ ܒ݄ܡܢܰܘ̈ܳܬ̥ܳܐ ܕܐ݄ܫܬܺܝ. ܗ̄ܽܘ ܡܶܕܰܢܳܐ ܠܰܝ̱ܬ ܗ̄ܘܰܐ ܦܽܘܣܩܳܢܳܐ ܢܽܘܟ̥ܪܳܝܳܐ – ܥܰܠ ܕܐ݄ܫܬܺܝ ܡܶܢܝܳܢܳܐ ܕܒ݄ܦܫܺܝܛܽܘܬ̥ܳܐ ܟܳܡ݄ܦܠ݄ܓ̥ ܠܓ̥ܰܠܰܒܶܐ ܡܶܢܝܳܢ̈ܶܐ (2, 3, 4, 5, 6…) ، ܘ݄ܛܪܶܐ ܠܶܗ ܕܗܳܘ݄ܢ ܗ̄ܰܚܫܳܒ̥̈ܶܐ ܦܫܺܝ̈ܛܶܐ ܘܬܪ̈ܺܝܨܶܐ ܙ݄ܕ.</span><br>
                                    <br>

                                    <span class="bold">ܐܰܝܕܰܪܒܳܐ ܥܳܒ̥ܰܕ ܗ̄ܘܰܐ ܗ̄ܽܘ ܛܶܟܣܳܐ؟</span><br>
                                    <span>ܗ̄ܰܒܳܒܠܳܝ̈ܶܐ ܟܳܡܚܰܫܚܺܝ ܗ̄ܘܰܘ̱ ܟܽܘܢܳܫܳܐ ܕܪ̈ܶܡܙܶܐ ܡܶܢ̱ ܚܠܳܦ ܟܽܘܢܳܫܳܐ ܟܰܡܺܝܠܳܐ ܐܰܘ ܓܡܺܝܪܳܐ ܕܰܡܶܢܝܳܢ̈ܶܐ ܐܟ̥ ܕܟ݄ܬ ܠܰܢ ܐܰܕܝܰܘܡܰܐ.</span><br>

                                    <span>· ܗ̄ܽܘ ܨܶܨܳܐ ܥܰܡܽܘܕܳܝܳܐ ܡܡܰܬ̥ܰܠ ܗ̄ܘܰܐ 1</span><br>
                                    <span>· ܗ̄ܽܘ ܨܶܨܳܐ ܕܺܗ̄ܝ ܩܽܘܪܢܺܝܬ̥ܳܐ ܡܡܰܬ̥ܰܠ ܗ̄ܘܰܐ 10</span><br>

                                    <span>ܘܒܽܗ̄ܘ ܡܙܳܓ̥ܳܐ ܕܰܪ̈ܶܡܙܰܢܺܝ ܩ݄ܕܪܺܝ ܗ̄ܘܰܘ̱ ܕܟ݄ܬ̥ܒ̥ܺܝ ܗ̄ܘܰܘ̱ ܡܶܢܝܳܢ̈ܶܐ ܡܶܢ̱ 1 ܗ݄ܠ 59.</span><br>
                                    <br>

                                    <span>ܐܟ̥ ܕܡܰܬ̥ܠܳܐ܇</span><br>
                                    <span>· 23 = ܬܪܶܝ ܥܰܣܪ̈ܳܘܰܬ + ܬܠܳܬ̥ܳܐ ܚܰܕ̱</span><br>
                                    <span>· 47 = ܐܰܪܒܥܳܐ ܥܰܣܪ̈ܳܘܰܬ + ܫܰܒܥܳܐ ܚܰܕ̱</span><br>

                                    <span>ܘܺܗ̄ܝ ܢܰܩܠܰܐ ܕܡܳܛ݄ܢ ܗ̄ܘܰܘ̱ ܠܽܗ̄ܘ ܡܶܢܝܳܢܳܐ ܕܐ݄ܫܬܺܝ، ܡܶܢ̱ ܚܠܳܦ ܕܣܰܝܡܺܝ ܗ̄ܘܰܘ̱ ܪܶܡܙܳܐ ܚܰܕ̱ܬ̥ܳܐ، ܡܚܰܫܚܺܝ ܗ̄ܘܰܘ̱ ܛܺܝܡܳܐ ܕܺܗ̄ܝ ܕܽܘܟܬ̥ܳܐ – ܐܟ̥ ܕܐܰܝܕܰܪܒܳܐ ܐܰܚܢܰܐ ܟܳܪ݄ܡܫܺܝܢܰܐ ܐܰܕܝܰܘܡܰܐ ܡܰܢ ܥܰܣܪ̈ܳܘܰܬ ܠܰܡܳܐܐܘ̈ܰܬ.</span><br>

                                    <span>ܗ̄ܺܝ ܕܽܘܟܬ̥ܳܐ ܕܒ݄ܬ̥݄ܪ ܡܡܰܬ̥ܠܳܐ ܗ̄ܘܰܐ 60 → (60¹)</span><br>
                                    <span>ܘ݄ܕܒ݄ܬ̥݄ܪ 60 × 60 → 60²</span><br>
                                    <span>ܘ݄ܕܒ݄ܬ̥݄ܪ 60 × 60 × 60 → 60³</span><br>

                                    <span>ܘܗܰܬ̥ܶܐ ܛܪܶܐ ܠܰܗ ܕܗܳܘܶܐ ܗ̄ܽܘ ܛܶܟܣܰܢܳܐ ܡܛܰܘܪܳܐ ܘܪܰܟܝܟ̥ܳܐ.</span><br>

                                    <span>ܗ̄ܰܒܳܒܠܳܝ̈ܶܐ ܠܰܝ̱ܬ ܗ̄ܘܰܝ ܠ݄ܗ̱ܢ ܪܶܡܙܳܐ ܠܽܗ̄ܘ 0 ܐܟ̥ ܕܟ݄ܐܕܥܺܝܢܰܐ ܠܶܗ ܐܰܕܝܰܘܡܰܐ.</span><br>

                                    <span>ܒ݄ܬ̥݄ܪ ܡܛܰܘܰܪ ܠ݄ܗ̄ܢ ܪܶܡܙܳܐ ܕܺܝܠܳܢܳܝܳܐ ܕܡܰܚܘ݄ܢ ܕܽܘܟܬ̥ܳܐ ܟ̥ܠܺܝܬ̥ܳܐ ܒܓܰܘܶܗ ܕܽܗ̄ܘ ܡܶܢܝܳܢܳܐ – ܐܟ̥ ܕܢܽܘܩܙܳܐ ܕܕܽܘܟܬ̥ܳܐ ܡܶܢ̱ ܚܠܳܦ ܡܶܢܝܳܢܳܐ. ܥܰܠ ܗܰܬ̥ܶܐ 0 ܠܰܝ̱ܬ ܗ̄ܘܰܘ̱ ܡܫܰܘܫܛܳܐ ܒܕܽܘܡܝܳܐ ܚܫܳܒ̥ܳܢܳܝܳܐ ܐܟ̥ ܕܟ݄ܐܕܥܺܝܢܰܐ ܠܶܗ ܐܰܕܝܰܘܡܰܐ.</span><br>
                                    <br>

                                    <span class="bold">ܩܰܝ ܗ̄ܽܘ ܐܶܣܳܐ 60؟</span><br>
                                    <span>ܗ̄ܽܘ ܦܽܘܣܩܳܢܳܐ ܕ60 ܩܠܺܝܕܳܐ ܗ̄ܘܰܐ ܠܽܗ̄ܘ ܟܽܘܫܳܪܳܐ ܕܽܗ̄ܘ ܛܶܟܣܳܐ. ܥܰܠ ܕ60 ܟܺܝܒܶܗ ܕܡ݄ܦܠ݄ܓ̥ ܒܫܰܘܝܽܘܬ̥ܳܐ ܡܶܢ̱ ܓ̥ܰܠܰܒܶܐ ܡܶܢܝܳܢ̈ܶܐ،</span><br>

                                    <span>(2, 3, 4, 5, 6, 10, 12, 15, 20, 30)</span><br>

                                    <span>ܗ̄ܽܘ ܚܫܳܚܳܐ ܕܰܬܒ̥ܳܪ̈ܶܐ ܗܰܘܺܝ ܦܫܺܝܛܳܐ ܙ݄ܕ ܡܽܗ̄ܘ ܐܶܣܳܐ ܕܰ 10.</span><br>

                                    <span>ܡܰܗ̄ܘܟ̥ܰܐ ܗܳܠ ܐܳܥܕܳܐ ܟܺܝܬ ܦܰܠܩ̈ܶܐ ܕܽܗ̄ܘ ܛܶܟܣܳܐ ܒܳܒܠܳܝܳܐ ܫܟܺܝܚ̈ܶܐ ܐܰܕܝܰܘܡܰܐ.</span><br>

                                    <span>60 ܪ̈ܦܳܦܶܐ ܒܺܗ̄ܝ ܩܰܛ݄ܝܢܬܳܐ</span><br>
                                    <span>60 ܩܰܛܺܝܢ̈ܳܬ̥ܳܐ ܒܺܗ̄ܝ ܫܳܥܬ̥ܳܐ</span><br>
                                    <span>360 ܕܰܪ̈ܓ̥ܶܐ ܒܺܗ̄ܝ ܕܽܘܪܬܳܐ</span><br>

                                    <span>ܟܽܘܠ ܢܰܩܠܰܐ ܕܚܰܝܪܺܝܢܰܐ ܥܰܠ ܗ̄ܺܝ ܫܳܥܬ̥ܳܐ، ܡܟܰܝܠܺܝܢܰܐ ܙܳܘܺܝܬ̥ܳܐ ܐܰܘ ܕܽܘܟܬ̥ܳܐ ܥܰܠ ܗ̄ܺܝ ܐܰܪܥܳܐ ܥܰܡ ܗ̄ܽܘ ܝܽܘܪܟ̥ܳܐ، ܟܳܡܚܰܫܚܺܝܢܰܐ ܛܶܟܣܳܐ ܕܟ݄ܬ ܠܶܗ ܫܶܪܫܳܐ ܒܒܶܝܬܢܰܗܪܺܝܢ ܡܶܢ̱ ܐܰܠܦܰܝܳܐ ܕ݄ܐܫܢ̈ܶܐ.</span><br>
                                    <br>

                                    <span class="bold">ܝܳܪܬܽܘܬ̥ܳܐ ܕܽܗ̄ܘ ܛܶܟܣܳܐ ܒܳܒܠܳܝܳܐ</span><br>

                                    <span>ܗ̄ܽܘ ܛܶܟܣܳܐ ܐ݄ܫܬܺܝܢܳܝܳܐ ܠܰܝ̱ܬ ܗ̄ܘܰܐ ܒܰܠܚܽܘܕ ܠܽܗ̄ܘ ܒܢܳܝܳܐ – ܐܶܠܳܐ ܗܰܘܺܝ ܗ̄ܘܰܐ ܫܶܬܶܐܣܬܳܐ ܠܚܰܩܠ̈ܶܐ ܐܽܘܠܨܳܝ̈ܶܐ ܐܰܟ̥܇</span><br>

                                    <span>ܝܽܘܠܦܳܢܳܐ ܕܰܟܽܘܟܒ̥̈ܶܐ، ܠܺܗ̄ܝ ܚܙܰܝܬܳܐ ܕܽܗ̄ܘ ܪܡܳܫܳܐ ܕܰܟܽܘܟܒ̥̈ܶܐ ܘܰܟܰܘܟܒ̈ܶܐ</span><br>
                                    <span>ܡܰܚܳܪܽܘܬܳܐ، ܠܽܗ̄ܘ ܟܰܝܠܳܐ ܕܰܐܶܣܟܺܝܡ̈ܶܐ ܘܰܩ݄ܪ̈ܢܰܘܳܬ̥ܶܐ</span><br>
                                    <span>ܙܰܒܢܳܐ، ܠܽܗ̄ܘ ܦܪܳܫܳܐ ܕܽܗ̄ܘ ܝܰܘܡܳܐ</span><br>

                                    <span>ܗ̄ܰܣّܳܦܪ̈ܶܐ ܒܳܒܠܳܝ̈ܶܐ ܡܚܰܫܚܺܝ ܗ̄ܘܰܘ̱ ܗ̄ܽܘ ܐܶܣܳܐ ܕܰ 60 ܕܣܰܝܡܺܝ ܗ̄ܘܰܘ̱ ܚܫܳܒ̥̈ܶܐ ܕܰܙܥܽܘܪ̈ܝܳܬ̥ܳܐ، ܕܗܰܘܺܝ ܡܰܥܒܕܳܢܽܘܬ̥ܳܐ ܒ݄ܬ̥݄ܪ ܥܰܠ ܗ̄ܽܘ ܝܽܘܠܦܳܢܳܐ ܕܰܝܰܘ̈ܢܳܝܶܐ ܘܕܰܡܰܫ݄ܠܡܳܢ̈ܶܐ</span><br>

                                    <span>ܘܰܐܕܝܰܘܡܰܐ ܣܬܶܝ، ܒ݄ܬ̥ܪ ܙ݄ܕ ܡܶܢ̱ ܐܰܪܒܥܰܐܠܦܳܐ ܐ݄ܫܢ̈ܶܐ، ܗ̄ܽܘ ܛܶܟܣܰܢܳܐ ܟܳܡܰܚܘܶܐ ܠܰܢ ܐܰܝܕܰܪܒܳܐ ܟܳܡ݄ܣܬܰܟܠܺܝܢܰܐ ܗ̄ܘ ܙܰܒܢܳܐ ܘܺܗ̄ܝ ܪܘܰܚܬܳܐ</span><br>
                                    <br>

                                    <span class="bold">ܚܽܘܬܳܡܳܐ</span><br>

                                    <span>ܗ̄ܽܘ ܛܶܟܣܳܐ ܐ݄ܫܬܺܝܢܳܝܳܐ ܒܳܒܠܳܝܳܐ ܠܰܝ̱ܬ ܝܳܐ ܒܰܠܚܽܘܕ ܫܒܺܝܠܳܐ ܕ݄ܒܢܳܝܳܐ ܥܰܬܺܝܩܳܐ – ܐܶܠܳܐ ܡܰܚܫܰܒܬܳܐ ܕܽܗ̄ܘ ܗܰܘܢܳܐ ܘܕܽܗ̄ܘ ܝܽܘܠܦܳܢܳܐ ܒܰܪܢܳܫܳܝܳܐ.</span><br>

                                    <span>ܘܐܟ̥ ܕܫܽܘܬܳܐܣܳܐ ܕܒܶܝܬ ܟܰܢܳܘ، ܟܳܡܫܰܠܛܺܝܢܰܐ ܗ̄ܽܘ ܒܰܗܪܳܐ ܥܰܠ ܢܰܨܺܝܚܘ̈ܳܬ̥ܳܐ (ܫܽܘܡܠܳܝ̈ܶܐ) ܐܟ̥ ܕܰܗ̄ܢܺܝ، ܕܡܰܡܛܺܝܢܰܐ ܠܒܳܠܰܝܢܰܐ ܕܺܗ̄ܝ ܦܢܺܝܬ̥ܰܝܕܰܢ ܠܰܝ̱ܬ ܗ̄ܘܰܐ ܒܰܠܚܽܘܕ ܢܽܘܩܰܙܬܳܐ ܕܺܗ̄ܝ ܡܰܪܕܽܘܬ̥ܳܐ ܘܕܽܗ̄ܘ ܠܶܫܳܢܳܐ، ܐܶܠܳܐ ܕܽܘܟܬ̥ܳܐ ܕܽܗ̄ܘ ܚܽܘܕܳܬ̥ܳܐ ܝܽܘܠܦܳܢܳܝܳܐ ܕܟܳܚܳܝܶܐ ܗܳܠ ܐܳܥܕܳܐ ܒܰܚܰܝܰܝܕ̈ܰܢ ܗ̄ܰܝܰܘܡܳܝ̈ܶܐ.</span><br>

