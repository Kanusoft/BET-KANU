                        <!-- Eastern -->
                        <div class=" col-md-6 col-sm-12">
                            <div class="well h-100 text-center" style="direction: rtl" id="eastern">
                                <h3 class="padding-bottom-10" style="direction:ltr">Eastern Syriac</h3>

                                <span class="Surit bold text-center">
                                    ܛܲܟܼܣܵܐ ܐܸܫܬܝܼܢܵܝܵܐ ܠܓܹܒ ܒܵܒܼܹ
                                </span><br><br>

                                <p class="Surit text-right">
                                    <span class="bold">ܚܕܵܐ ܡܕܝܼܢܵܝܘܼܬܵܐ ܒܢܝܼܬܵܐ ܥܲܠ ܖ̈ܲܩܡܹܐ</span><br>

                                    <span>ܩܵܕ݇ܡ ܥܸܕܵܢܵܐ ܝܲܪܝܼܟܼܬܵܐ ܡ̣ܢ ܦܠܵܛܬܵܐ ܕܬܘܼܩܵܢܹ̈ܐ ܕܲܡܚܲܫܒܘܿܢܹܐ ܘܛܲܟܼܣܹ̈ܐ ܖ̈ܲܩܡܵܝܹܐ،ܡܛܘܼܪܸܢܲܝܗܝ ܡܕܝܼܢܵܝ̈ܘܵܬܵܐ ܕܒܹܝܬ ܢܲܗܖ̈ܝܼܢ -ܦܪܝܼܫܵܐܝܼܬ ܒܵܒܼܹܠܵܝܹ̈ܐ- ܚܲܕ݇ ܡ̣ܢ ܕܐܵܢܝ݇ ܛܲܟܼܣܹ̈ܐ ܖܸ̈ܩܡܵܝܹܐ ܒܘܼܫ ܚܲܝܠܵܢܹ̈ܐ ܓܵܘ ܬܲܫܥܝܼܬܵܐ: ܛܲܟܼܣܵܐ ܐܸܫܬܝܼܢܵܝܵܐ (ܐܸܣܵܐ ܝܼܠܹܗ 60).</span><br>

                                    <span>ܐܵܗܵܐ ܛܲܟܼܣܵܐ، ܕܦܝܼܫܠܹܗ ܒܸܢܝܵܐ ܩܵܕ݇ܡ ܙܵܘܕܵܐ ܡ̣ܢ 4000 ܐܲܠܦܹ̈ܐ ܫܸܢܹ̈ܐ، ܡܓܘܼܪܘܸܣܠܹܗ ܡ̣ܢ ܥܝܵܕܹ̈ܐ ܫܘܿܡܝܼܖ̈ܵܝܹܐ ܒܘܼܫ ܥܲܬܝܼܩܹ̈ܐ، ܘܐ݇ܚܲܪܬܵܐ ܦܝܼܫܠܹܗ ܡܛܘܼܘܪܸܢܵܐ ܓܹܒ ܒܵܒܼܹܠܵܝܹ̈ܐ ܕܗܵܘܹܐ ܚܕܵܐ ܐܘܼܪܚܵܐ ܦܫܝܼܛܵܐ ܥܵܒܼܘܿܕܬܵܐ ܠܲܫܩܵܠ ܝܗܵܒܼܵܐ ܥܲܡ ܖ̈ܲܩܡܹܐ.</span><br>

                                    <span>ܘܲܒܗܸܦܟܵܐ ܕܛܲܟܼܣܵܐ ܥܸܣܪܵܢܵܝܵܐ (ܐܸܣܵܐ ܝܼܠܹܗ 10) ܕܝܼܠܹܗ ܡܘܼܦܠܸܚܵܐ ܗܵܕܝܼܵܐ، ܣܢܸܕܠܲܝܗܝ ܒܵܒܼܹܠܵܝܹ̈ܐ ܥܲܠ ܡܢܵܝܵܐ ܒܲܚܕܵܝ̈ܘܵܬܵܐ ܡ̣ܢ 60. ܘܐܵܗܵܐ ܡܓܲܒܲܝܬܵܐ ܠܵܐ ܝܗ݇ܘܵܐ ܐܲܝܟܼ ܕܐܵܬܝܵܐ، ܟܲܕ ܪܲܩܡܵܐ ܕ 60 ܒܐܵܬܹܐ ܠܲܦܠܵܓܼܵܐ ܒܲܦܫܝܼܛܘܼܬܵܐ ܥܲܠ ܪܵܒܵܐ ܡܸܢܝܵܢܹ̈ܐ (2، 3، 4، 5، 6...)، ܘܐܵܗܵܐ ܡܸܢܕܝܼ ܡܘܼܥܒܼܸܕܠܹܗ ܕܲܡܚܲܫܒܲܢܬܵܐ ܗܵܘܝܵܐ ܒܘܼܫ ܦܫܝܼܛܬܵܐ ܘܒܘܼܫ ܕܲܩܝܼܩܬܵܐ.</span><br>
                                    <br>

                                    <span class="bold">ܕܐܵܟܼܝܼ ܟܹܐ ܦܵܠܹܚ ܗ݇ܘܵܐ ܐܵܗܵܐ ܛܲܟܼܣܵܐ؟</span><br>
                                    <span>ܡܘܼܦܠܸܚܠܲܝܗܝ ܒܵܒܼܹܠܵܝܹ̈ܐ ܠܲܚܕܵܐ ܟܢܘܼܫܬܵܐ ܡ̣ܢ ܖܸ̈ܡܙܹܐ ܡ̣ܢ ܫܵܘܦܵܐ ܕܲܚܕܵܐ ܟܢܘܼܫܬܵܐ ܓܡܝܼܪܬܵܐ ܡ̣ܢ ܖ̈ܲܩܡܹܐ ܐܲܝܟܼ ܕܥܵܒܼܕܲܚ ܗܵܕܝܼܵܐ.</span><br>

                                    <span>·ܨܸܨܵܐ ܥܲܡܘܼܕܵܝܵܐ ܡܲܡܬܸܠ ܗ݇ܘܵܐ ܠܪܲܩܡܵܐ 1</span><br>
                                    <span>· ܨܸܨܵܐ ܙܵܘܝܼܬܵܢܵܝܵܐ ܡܲܡܬܸܠ ܗ݇ܘܵܐ ܠܪܲܩܡܵܐ 10</span><br>

                                    <span>ܘܲܒܐܘܼܪܚܵܐ ܕܲܡܚܲܝܘܿܕܹܐ ܐܲܢܹܐ ܖܸ̈ܡܙܹܐ، ܡܨܹܐ ܠܲܝܗܝ ܕܟܵܬܒܼܝܼ ܠܡܸܢܝܵܢܹ̈ܐ ܡ̣ܢ 1 ܗܲܠ 59.</span><br>
                                    <br>

                                    <span>ܩܵܐ ܛܘܼܦ̮ܣܵܐ:</span><br>
                                    <span>· 23 = ܬܪܹܝܢ ܨܸܨܹ̈ܐ ܩܵܐ ܥܸܣܖ̈ܵܝܹܐ + ܬܠܵܬܵܐ ܩܵܐ ܚܕܵܢܵܝܹ̈ܐ</span><br>
                                    <span>·47 = ܐܲܪܒܥܵܐ ܥܸܣܖ̈ܵܝܹܐ + ܫܲܒܼܥܵܐ ܚܕܵܢܵܝܹ̈ܐ</span><br>
                                    <br>

                                    <span>ܐܝܼܡܲܢ ܕܡܵܛܝܼ ܗ݇ܘܵܘ ܠܡܸܢܝܵܢܵܐ ܕ 60، ܡ̣ܢ ܫܵܘܦܵܐ ܕܲܥܒܼܵܕܵܐ ܪܸܡܙܵܐ ܚܲܕ݇ܬܵܐ، ܟܹܐ ܡܲܦܠܸܚܝܼ ܗ݇ܘܵܘ ܛܝܼܡܵܐ ܕܕܘܼܟܬܵܐ، ܗܵܪ ܐܲܟܼܘܵܬܲܢ ܐܸܕܝܘܿܡ ܝܵܘܡܵܐ ܐܝܼܡܲܢ ܕܲܡܫܲܢܹܝܚ ܡ̣ܢ ܥܸܣܖ̈ܵܝܹܐ ܠܐܸܡܵܝܹ̈ܐ.</span><br>

                                    <span>ܕܘܼܟܬܵܐ ܐܵܬܝܵܢܬܵܐ ܡܲܡܬܸܠܵܐ ܗ݇ܘܵܐ 60 → (60¹)</span><br>
                                    <span>ܐ݇ܚܲܪܬܵܐ 60 × 60 → 60²</span><br>
                                    <span>ܐ݇ܚܲܪܬܵܐ 60 × 60 × 60 → 60³</span><br>

                                    <span>ܘܐܵܗܵܐ ܡܸܢܕܝܼ ܡܘܼܥܒܼܸܕܠܹܗ ܕܛܲܟܼܣܲܝܗܝ ܗܵܘܹܐ ܡܸܬܩܲܕܡܵܢܵܐ ܘܲܦܫܝܼܛܵܐ ܒܲܚܕܵ ܐܘܼܪܚܵܐ ܓܵܪܫܵܢܬܵܐ.</span><br>

                                    <span>ܠܵܐ ܩܲܡ ܗܵܘܹܐ ܠܲܝܗܝ ܒܵܒܼܹܠܵܝܹ̈ܐ ܚܲܕ݇ ܪܸܡܙܵܐ ܩܵܐ ܨܝܼܦܲܪ ܒܗܵܘ ܣܘܼܟܵܠܵܐ ܕܵܪܝܵܐ،</span><br>

                                    <span>ܐܝܼܢܵܐ ܐ݇ܚܲܪܬܵܐ ܡܛܘܼܘܪܸܢܲܝܗܝ ܚܲܕ݇ ܪܸܡܙܵܐ ܕܝܼܠܵܢܵܝܵܐ ܠܲܪܡܵܙܵܐ ܥܲܠ ܕܘܼܟܬܵܐ ܣܦܝܼܩܬܵܐ ܓܵܘ ܡܸܢܝܵܢܵܐ، ܐܵܘܟܹܝܬ ܛܝܼܡܵܐ ܕܘܼܟܬܵܢܵܝܵܐ ܘܠܵܐ ܡܸܢܝܵܢܵܐ ܫܲܠܝܼܛ ܒܝܵܬܵܐ، ܠܗܵܕܟܼܵܐ ܨܝܼܦܲܪ ܠܵܐ ܝܗ݇ܘܵܐ ܚܲܕ݇ ܐܸܣܵܐ ܡܲܢܵܝܘܼܬܵܢܵܝܵܐ ܓܡܝܼܪܵܐ ܐܲܝܟܼ ܕܝܵܕܥܲܚ ܠܹܗ ܐܸܕܝܘܿܡ ܝܵܘܡܵܐ.</span><br>
                                    <br>

                                    <span class="bold">ܩܵܐ ܡܘܿܕܝܼ ܐܸܣܵܐ ܝܼܠܹܗ 60؟</span><br>
                                    <span>ܡܓܲܒܲܝܬܵܐ ܕܪܲܩܡܵܐ 60 ܝܼܗ݇ܘܵܐ ܐ݇ܪܵܙܵܐ ܕܡܲܢܬܲܝܬܵܐ ܕܐܵܗܵܐ ܛܲܟܼܣܵܐ.</span><br>

                                    <span>ܟܲܕ ܒܥܸܠܬܵܐ ܕܡܸܬܡܲܨܝܵܢܘܼܬܵܐ ܕܲܦܠܵܓܼܬܹܗ ܥܲܠ ܪܵܒܵܐ ܡܸܢܝܵܢܹ̈ܐ (2، 3، 4، 5، 6، 10، 12، 15، 20، 30)، ܗܘܹܐ ܫܩܵܠ ܝܗܵܒܼܵܐ ܥܲܡ ܬܸܒܼܖܹ̈ܐ ܒܘܼܫ ܦܫܝܼܛܵܐ ܒܦܘܼܚܵܡܵܐ ܥܲܡ ܛܲܟܼܣܵܐ ܥܸܣܪܵܝܵܐ.</span><br>

                                    <span>ܘܥܲܠ ܐܵܗܵܐ ܥܸܠܬܵܐ، ܗܲܠ ܗܵܕܝܼܵܐ ܡܲܦܠܘܿܚܹܐ ܝܘܲܚ ܚܲܕ݇ܟܡܵܐ ܣܲܗܡܹ̈ܐ ܡ̣ܢ ܐܵܗܵܐ ܛܲܟܼܣܵܐ ܗܲܠ ܐܸܕܝܘܿܡ ܝܵܘܡܵܐ</span><br>
                                    <br>

                                    <span>· 60 ܖ̈ܦܵܦܹܐ ܓܵܘ ܩܲܛܝܼܢܬܵܐ</span><br>
                                    <span>· 60 ܩܲܛܝܼܢ̈ܝܵܬܵܐ ܓܵܘ ܫܵܥܬܵܐ</span><br>
                                    <span>· 360 ܕܲܖ̈ܓܼܹܐ ܓܵܘ ܚܘܼܕܪܵܐ</span><br>

                                    <span>ܓܵܘ ܟܠ ܓܵܗܵܐ ܕܚܵܝܪܝܼܬܘܿܢ ܐܸܒܵܗ̇ ܒܫܵܥܬܵܐ ܐܵܘ ܟܵܝܠܝܼܬܘܿܢ ܚܕܵܐ ܙܵܘܝܼܬܵܐ، ܐܵܘ ܐܵܦܸܢ ܕܲܡܬܲܚܸܡܝܼܬܘܿܢ ܚܲܕ݇ ܝܲܬܒܼܵܐ ܥܲܠ ܐܲܪܥܵܐ ܒܡܲܦܠܲܚܬܵܐ ܕܣܸܖ̈ܛܹܐ ܕܝܘܼܪܟܼܵܐ ܘܦܸܬܝܘܼܬܵܐ، ܒܲܫܪܵܪܵܐ ܡܲܦܠܘܿܚܹܐ ܝܬܘܿܢ ܠܚܲܕ݇ ܛܲܟܼܣܵܐ ܒܸܪܝܵܐ ܓܵܘ ܒܹܝܬ ܢܲܗܖ̈ܝܼܢ ܩܵܕ݇ܡ ܐܲܠܦܵܝܹ̈ܐ ܕܫܸܢܹ̈ܐ.</span><br>
                                    <br>

                                    <span class="bold">ܝܵܪܬܘܼܬܵܐ ܕܛܲܟܼܣܵܐ ܒܵܒܼܹܠܵܝܵܐ</span><br>

                                    <span>ܛܲܟܼܣܵܐ ܐܸܫܬܝܼܢܵܝܵܐ ܠܵܐ ܝܗ݇ܘܵܐ ܐܲܚܟ̰ܝܼ ܚܕܵܐ ܐܘܼܪܚܵܐ ܠܲܡܢܵܝܵܐ، ܐܝܼܢܵܐ ܦܝܼܫܵܐ ܝܠܹܗ ܐܸܣܵܐ ܠܝܘܼܠܦܵܢܹ̈ܐ ܐܵܢܲܢܩܵܝܹ̈ܐ ܐܲܝܟܼ:</span><br>

                                    <span>ܝܘܼܠܦܵܢ ܟܵܘܟܼܒܼܹ̈ܐ: ܠܲܡܬܲܒܘܿܥܹܐ ܙܵܘܥܵܐ ܕܟܵܘܟܼܝܹ̈ܐ ܘܛܲܥܝܹ̈ܐ</span><br>
                                    <span>ܡܲܚܵܪܘܼܬܵܐ: ܠܲܟܝܵܠܵܐ ܐܸܣܟܹܡܹ̈ܐ ܘܙܵܘ̈ܝܵܬܵܐ</span><br>
                                    <span>ܟܝܵܠܵܐ ܙܲܒܼܢܵܐ: ܠܡܲܪܝܘܿܙܹܐ ܝܵܘܡܵܐ</span><br>

                                    <span>ܘܡܘܼܦܠܸܚܠܲܝܗܝ ܝܵܕܘܿܥܹ̈ܐ ܒܵܒܼܹܠܵܝܹ̈ܐ ܠܐܵܗܵܐ ܛܲܟܼܣܵܐ ܠܲܥܒܼܵܕܬܵܐ ܡܵܘܕܥܵܢ̈ܘܵܬܵܐ ܘܚܘܼܫܒܵܢܹ̈ܐ ܕܲܩܝܼܩܹ̈ܐ، ܘܲܟܬܵܒܼܬܵܐ ܨܸܨܵܝܬܵܐ ܡܗܘܼܝܸܪܵܗ̇ ܓܵܘ ܡܣܲܓܲܠܬܵܐ ܕܐܵܗܵܐ ܛܘܼܘܵܪܵܐ ܥܲܠ ܠܘܼܚܹ̈ܐ ܕܛܝܼܢܵܐ، ܘܐܵܗܵܐ ܡܸܢܕܝܼ ܡܘܼܥܒܼܸܕܠܹܗ ܡܫܲܢܲܝܬܵܐ ܕܝܼܕܲܥܬܵܐ ܩܵܐ ܝܘܼܒܵܠܹ̈ܐ ܐܵܬܝܵܢܹ̈ܐ، ܘܲܡܥܘܼܒܕܸܢܹܗ ܐ݇ܚܲܪܬܵܐ ܥܲܠ ܝܘܼܠܦܵܢܹ̈ܐ ܝܵܘܢܵܝܹ̈ܐ ܘܐܸܣܠܵܡܵܝܹ̈ܐ.</span><br>

                                    <span>ܘܗܲܠ ܐܸܕܝܘܿܡ ܝܵܘܡܵܐ، ܘܒܵܬܲܪ 3500 ܐܵܘ 4000 ܐܲܠܦܹ̈ܐ ܫܸܢܹ̈ܐ، ܦܝܵܫܵܐ ܝܠܵܗ̇ ܡܲܥܒܕܵܢܘܼܬܵܐ ܕܐܵܗܵܐ ܛܲܟܼܣܵܐ ܓܵܘ ܐܘܼܪܚܵܐ ܕܲܡܦܲܪܡܲܝܬܵܐ ܕܥܸܕܵܢܵܐ ܘܲܪܘܵܚܬܵܐ.</span><br>
                                    <br>

                                    <span class="bold">ܚܘܼܬܵܡܵܐ</span><br>

                                    <span>ܛܲܟܼܣܵܐ ܐܸܫܬܝܼܢܵܝܵܐ ܒܵܒܼܹܠܵܝܵܐ ܠܵܐ ܝܠܹܗ ܐܲܚܟ̰ܝܼ ܚܕܵܐ ܐܘܼܪܚܵܐ ܥܲܬܝܼܩܬܵܐ ܠܲܡܢܵܝܵܐ، ܐܝܼܢܵܐ ܝܼܠܹܗ ܡܲܙܒܲܛܬܵܐ ܥܲܠ ܒܵܪܘܿܝܘܼܬܵܐ ܕܒܲܪܢܵܫܵܐ ܘܣܲܟܘܼܠܬܵܢܘܼܬܹܗ.</span><br>

                                    <span>ܘܩܵܐ BET KANU، ܡܲܬܲܒܼܬܵܐ ܕܒܵܠܵܐ ܥܲܠ ܗܵܕܟܼܵܐ ܫܘܼܡܠܵܝܹ̈ܐ ܡܲܕܟܼܘܿܪܲܢ ܝܼܠܵܗ̇ ܕܲܦܢܝܼܬܲܢ ܠܵܐ ܝܗ݇ܘܵܐ ܐܲܚܟ̰ܝܼ ܩܸܢܛܪܘܿܢ ܩܵܐ ܡܲܪܕܘܼܬܵܐ ܘܠܸܫܵܢܵܐ، ܐܝܼܢܵܐ ܝܼܗ݇ܘܵܐ ܐܵܦ ܕܲܪܓܘܼܫܬܵܐ ܕܒܵܪܘܿܝܘܼܬܵܐ ܝܘܼܠܦܵܢܵܝܬܵܐ ܕܗܲܠ ܗܵܕܝܼܵܐ ܦܝܵܫܵܐ ܝܠܵܗ̇ ܓܵܘ ܚܲܝܘܼܬܲܢ ܝܵܘܡܵܝܬܵܐ.</span><br>

                                </p>

