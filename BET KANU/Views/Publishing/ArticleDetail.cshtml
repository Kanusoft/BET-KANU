@model MagazineArticle

@{
    ViewBag.Title = Model.Title;

    bool HasContent(
        string? title,
        string? introduction,
        string? bodyHtml,
        string? creditsHtml,
        string? pdfPath)
    {
        return !string.IsNullOrWhiteSpace(title)
            || !string.IsNullOrWhiteSpace(introduction)
            || !string.IsNullOrWhiteSpace(bodyHtml)
            || !string.IsNullOrWhiteSpace(creditsHtml)
            || !string.IsNullOrWhiteSpace(pdfPath);
    }

    var hasEnglish = HasContent(
        Model.EnglishTitle,
        Model.EnglishIntroduction,
        Model.EnglishBodyHtml,
        Model.EnglishCreditsHtml,
        Model.EnglishPdfPath);

    var hasWestern = HasContent(
        Model.WesternTitle,
        Model.WesternIntroduction,
        Model.WesternBodyHtml,
        Model.WesternCreditsHtml,
        Model.WesternPdfPath);

    var hasEastern = HasContent(
        Model.EasternTitle,
        Model.EasternIntroduction,
        Model.EasternBodyHtml,
        Model.EasternCreditsHtml,
        Model.EasternPdfPath);

    int activeLanguageCount = (hasEnglish ? 1 : 0) + (hasWestern ? 1 : 0) + (hasEastern ? 1 : 0);
    string colClass = activeLanguageCount switch
    {
        3 => "col-lg-4 col-md-6 col-sm-12",
        2 => "col-md-6 col-sm-12",
        _ => "col-12"
    };
}

<div id="wrapper">

    <section class="p-0">
        @{
            var desktopBanner = !string.IsNullOrWhiteSpace(Model.BannerImage)
                ? Model.BannerImage
                : Model.BannerImage350;
        }
        @if (!string.IsNullOrWhiteSpace(desktopBanner))
        {
            <div class="hero hero-game">
                <picture>
                    @if (!string.IsNullOrWhiteSpace(Model.BannerImage350))
                    {
                        <source media="(max-width: 767.98px)"
                                srcset="@Model.BannerImage350" />
                    }

                    <img src="@desktopBanner"
                         alt="@Model.Title" />
                </picture>
            </div>
        }
    </section>

    <section>
        <div class="container">
            <div class="row">

                <div class="col-lg-12">

                    <div class="post post-single">
                        <div class="post-header">
                            <div class="post-title">

                                <h2>@Model.Title</h2>

                                <ul class="post-meta">

                                    <li>
                                        <i class="fa fa-newspaper"></i>
                                        BET KANU Magazine
                                    </li>

                                    @if (Model.Magazine != null)
                                    {
                                        <li>
                                            <i class="fa fa-file-text"></i>
                                            @Model.Magazine.Title
                                        </li>
                                    }

                                    <li>
                                        <i class="fa fa-book-open"></i>
                                        Article @Model.ArticleNumber
                                    </li>

                                    @if (Model.ReleaseDate != default)
                                    {
                                        <li>
                                            <i class="fa fa-calendar-o"></i>
                                            @Model.ReleaseDate.ToString("MMMM dd, yyyy")
                                        </li>
                                    }

                                </ul>
                            </div>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(
                                                Model.ShortDescription))
                        {
                            <p>
                                @Model.ShortDescription
                            </p>
                        }

                    </div>

                    <div class="row g-4 justify-content-between Articles">

                      
                        <!-- Western Syriac -->
                        @if (hasWestern)
                        {
                            <div class="@colClass">
                                <div class="well h-100"
                                     style="direction:rtl"
                                     id="western">
                                    <h3 class="padding-bottom-10 text-center"
                                        style="direction:ltr">
                                        Western Syriac
                                    </h3>
                                    <br>
                                    @if (!string.IsNullOrWhiteSpace(Model.WesternTitle))
                                    {
                                        <div class="Surayt">
                                            @Html.Raw(Model.WesternTitle)
                                        </div>
                                    }
                                    <br>

                                    @if (!string.IsNullOrWhiteSpace(Model.WesternIntroduction))
                                    {
                                        <p style="direction:ltr">@Model.WesternIntroduction</p>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(Model.WesternBodyHtml))
                                    {
                                        <div class="Surayt">
                                            @Html.Raw(Model.WesternBodyHtml)
                                        </div>
                                    }
                                    else
                                    {
                                        <p>
                                            Western Syriac content is not currently available.
                                        </p>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(Model.WesternPdfPath))
                                    {
                                        <div class="text-center">
                                            <a class="btn btn-info mt-3"
                                               href="@Model.WesternPdfPath"
                                               target="_blank"
                                               rel="noopener">
                                                <i class="fa fa-file-pdf-o"></i>
                                                Download PDF
                                            </a>
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        <!-- Eastern Syriac -->
                        @if (hasEastern)
                        {
                            <div class="@colClass">
                                <div class="well h-100"
                                     style="direction:rtl"
                                     id="eastern">
                                    <h3 class="padding-bottom-10 text-center"
                                        style="direction:ltr">
                                        Eastern Syriac
                                    </h3>
                                    <br>
                                    @if (!string.IsNullOrWhiteSpace(Model.EasternTitle))
                                    {
                                        <div class="Surit">
                                            @Html.Raw(Model.EasternTitle)
                                        </div>
                                    }
                                    <br>

                                    @if (!string.IsNullOrWhiteSpace(Model.EasternIntroduction))
                                    {
                                        <p style="direction:ltr">@Model.EasternIntroduction</p>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(Model.EasternBodyHtml))
                                    {
                                        <div class="Surit">
                                            @Html.Raw(Model.EasternBodyHtml)
                                        </div>
                                    }
                                    else
                                    {
                                        <p>
                                            Eastern Syriac content is not currently available.
                                        </p>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(Model.EasternPdfPath))
                                    {
                                        <div class="text-center">
                                            <a class="btn btn-info mt-3"
                                               href="@Model.EasternPdfPath"
                                               target="_blank"
                                               rel="noopener">
                                                <i class="fa fa-file-pdf-o"></i>
                                                Download PDF
                                            </a>
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        <!-- English -->
                        @if (hasEnglish)
                        {
                            <div class="@colClass">
                                <div class="well h-100 text-center" id="english">
                                    <h3 class="padding-bottom-10" style="direction:ltr">
                                        English
                                    </h3>
                                    <br>
                                    @if (!string.IsNullOrWhiteSpace(Model.EnglishTitle))
                                    {
                                        <h4 class="bold text-center">
                                            @Model.EnglishTitle
                                        </h4>
                                    }
                                    <br>

                                    @if (!string.IsNullOrWhiteSpace(Model.EnglishIntroduction))
                                    {
                                        <p>@Model.EnglishIntroduction</p>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(Model.EnglishBodyHtml))
                                    {
                                        <div class="text-left" style="direction:ltr; text-align:left;">
                                            @Html.Raw(Model.EnglishBodyHtml)
                                        </div>
                                    }
                                    else
                                    {
                                        <p>
                                            English content is not currently available.
                                        </p>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(Model.EnglishPdfPath))
                                    {
                                        <a class="btn btn-info mt-3"
                                           href="@Model.EnglishPdfPath"
                                           target="_blank"
                                           rel="noopener">
                                            <i class="fa fa-file-pdf-o"></i>
                                            Download PDF
                                        </a>
                                    }
                                </div>
                            </div>
                        }

                    </div>

                </div>

            </div>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(Model.EnglishCreditsHtml) ||
        !string.IsNullOrWhiteSpace(Model.WesternCreditsHtml) ||
        !string.IsNullOrWhiteSpace(Model.EasternCreditsHtml))
    {
        int activeCreditsCount = (!string.IsNullOrWhiteSpace(Model.EnglishCreditsHtml) ? 1 : 0)
            + (!string.IsNullOrWhiteSpace(Model.WesternCreditsHtml) ? 1 : 0)
            + (!string.IsNullOrWhiteSpace(Model.EasternCreditsHtml) ? 1 : 0);

        string creditsColClass = activeCreditsCount switch
        {
            3 => "col-lg-4 col-md-6 col-sm-12",
            2 => "col-md-6 col-sm-12",
            _ => "col-12"
        };

        <section>
            <div class="container">

                <div class="row">
                    <div class="col-md-12">

                        <div class="page-header">
                            <div class="page-title"
                                 style="color:black">
                                Credits
                            </div>
                        </div>

                        <div class="row">

                     

                            @if (!string.IsNullOrWhiteSpace(Model.WesternCreditsHtml))
                            {
                                <div class="@creditsColClass">
                                    <div class="well">
                                        <p>
                                            <strong>Western</strong>
                                        </p>
                                        <div>
                                            @Html.Raw(Model.WesternCreditsHtml)
                                        </div>
                                    </div>
                                </div>
                            }

                            @if (!string.IsNullOrWhiteSpace(Model.EasternCreditsHtml))
                            {
                                <div class="@creditsColClass">
                                    <div class="well">
                                        <p>
                                            <strong>Eastern</strong>
                                        </p>
                                        <div>
                                            @Html.Raw(Model.EasternCreditsHtml)
                                        </div>
                                    </div>
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(Model.EnglishCreditsHtml))
                            {
                                <div class="@creditsColClass">
                                    <div class="well">
                                        <p>
                                            <strong>English</strong>
                                        </p>
                                        <div>
                                            @Html.Raw(Model.EnglishCreditsHtml)
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>

                        <div class="col-md-4 float-end">
                            <ul class="share">

                                <li>
                                    <a href="https://www.facebook.com/sharer.php?u=@Uri.EscapeDataString(Context.Request.Scheme + "://" + Context.Request.Host + Context.Request.Path + Context.Request.QueryString)"
                                       class="btn btn-sm btn-social-icon btn-facebook"
                                       target="_blank"
                                       rel="noopener"
                                       title="Share on Facebook">
                                        <i class="fa fa-facebook"></i>
                                    </a>
                                </li>

                                <li>
                                    <a href="https://twitter.com/share?url=@Uri.EscapeDataString(Context.Request.Scheme + "://" + Context.Request.Host + Context.Request.Path + Context.Request.QueryString)&hashtags=BETKANU"
                                       class="btn btn-sm btn-social-icon btn-twitter"
                                       target="_blank"
                                       rel="noopener"
                                       title="Share on Twitter">
                                        <i class="fa fa-twitter"></i>
                                    </a>
                                </li>

                            </ul>
                        </div>

                    </div>
                </div>

            </div>
        </section>
    }

</div>