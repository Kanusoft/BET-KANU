                <div class="">
                    <div class="row g-4 justify-content-between Articles">

                        <!-- Western -->
                        <div class="col-md-6 col-sm-12 ">
                            <div class="well h-100  text-center" style="direction: rtl" id="western">
                                <h3 class="padding-bottom-10" style="direction:ltr">Western Syriac</h3>
                                <span class="Surayt  bold text-center">
                                    ܩܰܘܡܳܐ ܕܺܗ̄ܝ ܐܬ̥ܽܘܬ̥ܳܐ: ܡܶܢ̱ ܐܽܘܓܰܪܝܬ ܠܳܐܠܰܦܒܶܝܬ ܬܺܒܶܝܠܳܝܬܳܐ

                                </span>
                                <br>
                                <br>
                                <p class="Surayt text-right">

                                    <span>ܐܶܢ ܗ̄ܽܘ ܩܰܘܡܳܐ ܪܰܩܡܳܝܳܐ ܡܰܦܫܰܛ ܠܶܗ ܗ̄ܺܝ ܝܰܕܰܥܬܳܐ ܒܽܗ̄ܘ ܙܰܒܢܰܝܕܰܢ ، ܟܺܝܒܰܢ ܕ݄ܐܡّܺܪ̱ܝܢܰܐ ܕܰܟܢܰܥܢܳܝ̈ܶܐ ܡܶܩ݄ܕ̱ܡ ܡܽܗ̄ܘ ܙܰܒܢܰܢܳܐ ܗ̄ܘܰܝܢܶܐ ܗ̄ܺܝ ܢܰܩܠܰܐ ܕܡܰܘܦܰܩّܶܗ ܗ̄ܺܝ ܐܳܠܰܦܒܶܝܬ ܠܽܗ̄ܘ ܥܳܠܡܳܐ</span><br>
                                    <span>ܡܚܰܠܰܦّܶܗ ܗ̄ܺܝ ܟܬ̥ܰܒ̥ܬܳܐ ܕܰܒّ݄ܣܡܳܪ̈ܶܐ ܡܰܢ̱ ܗܶܓܝܳܢ̈ܶܐ ܥܰܣܩ̈ܶܐ ܠܺܗ̄ܝ ܦܫܺܝܛܽܘܬ̥ܳܐ ܕܰܗ̄ܢ ܐܳܬ̥ܘ̈ܳܬ̥ܳܐ݂، ܘܗܰܘܟ̥ܰܐ ܡܫܰܪܶܐ ܠܰܗ ܗ̄ܺܝ ܡܶܠܬ̥ܳܐ ܚܺܐܪܬܳܐ ܘܡܫܰܪܶܐ ܠܶܗ ܙܰܒܢܳܐ ܚܰܕܬ̥ܳܐ ܠܺܗ̄ܝ ܡܕܺܝܢܳܝܽܘܬ̥ܳܐ ܘܠܽܗ̄ܘ ܒܰܪܢܳܫܳܐ.</span><br>
                                    <br>

                                    <span class="bold">ܐܽܘܓ̥ܰܪܺܝܬ: ܥܰܬ݄ܩ ܐܳܠܰܦܒܺܝܬ ܟܰܡܺܝܠܬܳܐ ܘ݄ܓܡܺܝܪܬܐ</span><br>
                                    <span>ܒܽܗ̄ܘ ܣܦܳܪ ܝܰܡܳܐ ܟܢܰܥܢܳܝܳܐ، ܒܽܐܘܓܰܪܝܬ (ܬܶܠܳܐ ܕܪܺܝܫ ܫܰܡܪܳܐ ܩܰܪܝܒ̥ܳܐ ܡܺܗ̄ܝ ܠܰܕܩܺܝܰܐ)، ܒܽܗ̄ܘ ܕܳܪܳܐ ܕܰܗ̄ܢ ܐܰܪܒܰܥܣܰܪ ܡܶܩ݄ܡ ܡܽܗ̄ܘ ܡܰܘܠܳܕܳܐ ܢܰܦܺܝܩܳܐ ܥܰܬ݄ܩ ܐܳܠܰܦܒܶܝܬ ܫܟܺܝܚܬܳܐ ܘܓܡܺܝܪܬܳܐ ܘܢܛܺܝܪܬܳܐ ܒܩܪܺܝܚܽܘܬ̥ܳܐ ܗܳܠ ܐܰܕܝܰܘܡܰܐ، ܡܛܰܘܪܳܐ ܡܰܢ̱ ܟܢܰܥܢܳܝ̈ܶܐ ܕܚܳܝ݄ܢ ܗ̄ܘܰܘ ܒܽܐܘܓ̥ܰܪܝܬ ܒܰܗ̄ܢ ܐܰܠܦܳܐ ܕܰܬܪܶܝ ܡܶܩ݄ܡ ܡܽܗ̄ܘ ܡܰܘܠܳܕܳܐ، ܘܡܺܝܕܳܐ ܡܺܗ̄ܝ ܟܬ̥ܰܒ̥ܬܳܐ ܐܰܟܰܕܳܝܬܳܐ ܗܶܓܝܳܢܳܝܬܳܐ.</span><br>
                                    <span>ܗ̄ܺܝ ܐܳܠܰܦܒܶܝܬ ܕܽܐܘܓܰܪܝܬ ܟܺܝܬ ܐܶܒܰܗ ܬܠܶܬ̥ܺܝ ܐܳܬ̥ܘ̈ܳܬ̥ܳܐ، ܘܟܳܡ݄ܟܬ̥ܳܒ̥ܳܐ ܡܽܗ̄ܘ ܣܶܡܳܠܳܐ ܠܽܗ̄ܘ ܝܰܡܺܝܢܳܐ، ܘܥܰܡ ܕܟ݄ܬܝܳܐ ܗ̄ܽܘ ܛܽܘܦܣܰܝܕܰܗ ܕܰܒّ݄ܣܡܳܪ̈ܶܐ ܘܟܳܡ݄ܟܬ̥ܳܒ̥ܳܐ ܗ̄ܘܰܐ ܥܰܠ ܠܽܘܚ̈ܶܐ ܕܛܺܝܢܳܐ ܒܡܳܐܢܳܐ ܚܰܪܽܘܦܳܐ، ܐܶܠܳܐ ܠܰܝ̱ܬ ܝܳܐ ܛܶܟܣܳܐ ܗܶܓܝܳܢܳܝܳܐ ܐܟ̥ ܕܺܗ̄ܝ ܟܬ̥ܰܒ̥ܬܳܐ ܐܰܟܰܕܳܝܬܳܐ ܕܰܒّ݄ܣܡܳܪ̈ܶܐ، ܐܶܠܳܐ ܛܶܟܣܳܐ ܕܳܐܠܰܦܒܶܝܬ ܕܽܗ̄ܘ ܩܳܠܳܐ ܕܟܳܡܗܰܠ݄ܟ̥ ܥܰܠ ܗ̄ܽܘ ܩܳܢܽܘܢܳܐ ܕܟܽܘܠ ܐܳܬ̥ܽܘܬ̥ܳܐ ܟ݄ܝ̱ܬ ܠܰܗ ܩܳܠܳܐ.</span><br>
                                    <span>ܘܡܰܢܩܰܨ ܠܰܗ ܗܰܘܟ̥ܰܐ ܗ̄ܽܘ ܡܶܢܝܳܢܳܐ ܕܰܪܶܡܙ̈ܶܐ ܕܺܗ̄ܝ ܟܬ̥ܰܒ̥ܬܳܐ ܡܶܢ̱ ܡܰܐܘ̈ܳܬ̥ܳܐ ܕܪ̈ܶܡܙܶܐ ܒܰܛܶܟܣ̈ܶܐ ܥܰܬܺܝܩ̈ܶܐ ܐܟ̥ ܕܽܗ̄ܘ ܐܰܟܰܕܳܝܳܐ ܘ݄ܕܗܰܘ݄ܢ ܒܰܠܚܽܘܕ ܬܠܶܬ̥ܝ ܪ̈ܶܡܙܶܐ. ܘܗܰܘܟ̥ܰܐ ܗܰܘܝܰܐ ܗ̄ܺܝ ܟܬ̥ܰܒ̥ܬܳܐ ܦܫܺܝܛܬܳܐ ܘܥܰܒ̥ܕܬܳܐ ܘܦܫܺܝܩܬܳܐ ܠܺܗ̄ܝ ܚܫܰܚܬܳܐ.</span><br>
                                    <span>ܘܺܗ̄ܝ ܐܳܠܰܦܒܶܝܬ ܗ̄ܰܬ̥ܶܐ ܡܚܰܫܚܺܝ ܠܰܗ ܗ̄ܘܰܐ ܕܟ݄ܬ̥ܒ̥ܺܝ ܗ̄ܘܰܘ ܨܚܳܚ̈ܶܐ ܕܺܝܦܠܳܘ̇ܡܰܣܳܝ̈ܶܐ، ܐܶܩܳܢܽܘܡܝܳܝ̈ܶܐ، ܣܳܦܪ̈ܳܝܶܐ، ܬܰܘܕܺܝܬ̥ܳܢܳܝ̈ܶܐ، ܬܰܓܳܪ̈ܳܝܶܐ ܘܩܳܢܽܘܢܳܝ̈ܶܐ، ܘܽܗ̄ܘ ܡܶܕܰܢܳܐ ܡܰܚܘܶܐ ܠܶܗ ܗ̄ܺܝ ܫܰܘܝܽܘܬ̥ܳܐ ܥܶܠܰܝܬܳܐ ܕܺܗ̄ܝ ܡܰܪܕܽܘܬ̥ܳܐ ܒܺܗ̄ܝ ܡܕܺܝܢ̱ܬ̥ܳܐ.</span><br>
                                    <span>ܗ̄ܺܝ ܐܳܠܰܦܒܶܝܬ ܗ̄ܰܬ̥ܶܐ ܫܟܺܝܚܳܐ ܒ݄ܬ̥݄ܪ ܡܺܗ̄ܝ ܫܟܰܚܬܳܐ ܕܺܗ̄ܝ ܕܽܘܟܬ̥ܳܐ ܕܽܐܘܓ̥ܰܪܝܬ ܒܺܗ̄ܝ ܫܰܢ̱ܬܳܐ ܕ 1928 ܕܽܗ̄ܘ ܡܰܘܠܳܕܳܐ ܒܦܶܓܥܳܐ، ܗ̄ܺܝ ܢܰܩܠܰܐ ܕܚܰܕ̱ ܐܰܟܳܪܳܐ ܡܶܢ̱ ܣܽܘܪܝܰܐ ܡܚܶܐ ܗ̄ܽܘ ܦܰܕܳܢܰܝܕܶܗ ܒܟܶܐܦ̈ܶܐ ܕܒ݄ܬ̥ܪ ܐܰܕܺܝܥܺܝ ܕܰܟܶܐܦ̈ܰܐܢܺܝ ܦܰܠܩ̈ܶܐ ܗ̄ܘܰܝܢܶܝ ܡܶܢ̱ ܩܰܒ̥ܪ̈ܶܐ ܥܰܬܺܝ̈ܩܶܐ.</span><br>
                                    <span>ܘ݄ܡܫܰܪܶܐ ܠ݄ܗ̄ܢ ܒ݄ܬ̥ܪ ܗ̄ܰܚܦܳܪ̈ܶܐ ܡܛܰܟܣ̈ܶܐ ܕܣܺܝܡܺܝ ܠܶܗ ܗ̄ܽܘ ܝܳܕܽܘܥܳܐ ܕܰܥܰܬܺܝܩ̈ܳܬ̥ܳܐ ܗ̄ܽܘ ܦܪܰܢܫܳܝܳܐ ܟܠܳܘܕ ܫܺܝܦܶܪ، ܘܰܐܕܝܰܘܡܰܐ ܟܺܝܬ ܟܡܳܐ ܠܽܘܚ̈ܶܐ ܐܽܘܓ̥ܰܪܺܝܬܳܝ̈ܶܐ ܢܛܺܝܪ̈ܶܐ ܒܰܒܶܝܬ ܥܰܬܺܝܩ̈ܳܬ̥ܳܐ ܡܳܬ̥ܳܢܳܝܳܐ ܒܕܰܪܡܣܽܘܩ</span><br>
                                    <span>ܗ̄ܺܝ ܐܳܠܰܦܒܶܝܬ ܕܐܽܘܓܰܪܝܬ ܡܫܰܚܠܰܦ ܠܰܗ ܗ̄ܺܝ ܬܰܫܥܺܝܬ̥ܳܐ ܕܺܗ̄ܝ ܟܬ̥ܰܒ̥ܬܳܐ. ܗܰܘܝܳܐ ܚܰܕ̱ ܡܰܢ̱ ܛܶܟܣ̈ܶܐ ܕܺܗ̄ܝ ܟܬ̥ܰܒܬܳܐ ܕܟ݄ܬ ܗ̄ܘܰܐ ܙ݄ܕ ܡܫܰܘܫܛܳܐ ܘܕܰܩܺܝܩܳܐ ܒܽܗ̄ܘ ܙܰܒܢܰܘܳܐ. ܗ̄ܺܝ ܐܳܠܰܦܒܶܝܬ ܗ̄ܰܬ̥ܶܐ ܗܰܘܝܳܐ ܗ̄ܘܰܐ ܒ݄ܬ̥ܪܟܶܢ̱ ܗ̄ܺܝ ܫܶܬܶܐܣܬܳܐ ܠܺܗ̄ܝ ܟܬ̥ܰܒ̥ܬܳܐ ܦܽܘܢܺܝܩܳܝܬܳܐ.</span><br>
                                    <br>

                                    <span class="bold">ܦܽܘܢܺܝ̈ܩܳܝܶܐ: ܦܪܳܣܳܐ ܕܰܗ̄ܢ ܐܳܬ̥ܘ̈ܳܬ̥ܳܐ ܒܽܗ̄ܘ ܥܳܠܡܳܐ ܥܰܬܺܝܩܳܐ</span><br>
                                    <span>ܒ݄ܬ̥݄ܪ ܡܶܢ̱ ܐܽܘܓ̥ܰܪܝܬ، ܡܫܰܘܫ݄ܛܳܐ ܗ̄ܺܝ ܐܳܠܰܦܒܶܝܬ ܟܢܰܥܢܳܝܬܳܐ ܒ݄ܥܝܳܕܳܐ ܕ݄ܟܬ̥ܰܒ̥ܬܳܐ ܦܪܺܝܫܳܐ، ܘܡܰܚܘܶܐ ܠܰܗ ܒܺܗ̄ܝ ܨܽܘܪܬܳܐ ܦܽܘܢܺܝܩܳܝܬܳܐ ܒܽܗ̄ܘ ܕܳܪܳܐ ܕܰܚܕܰܥܣܰܪ ܡܶܩ݄ܕ̱ܡ ܡܽܗ̄ܘ ܡܰܘܠܳܕܳܐ، ܘ݄ܦܪܺܝܣܳܐ ܡܰܢ̱ ܡܕܺܝܢ̈ܳܬ̥ܳܐ ܕܽܗ̄ܘ ܣܦܳܪܝܰܡܳܐ ܟܢܰܥܢܳܝܳܐ، ܕܺܝܠܳܢܳܐܺܝܬ ܔܒܶܝܠ، ܥܰܠ ܗܰܘܟ̥ܰܐ ܝܕ݄ܝܥܬܳܐ ܝܳܐ ܣܬܶܝ ܗ̄ܽܘ ܛܶܟܣܳܐ ܕ݄ܔܒܶܝܠ.</span><br>
                                    <span>ܗ̄ܺܝ ܐܳܠܰܦܒܶܝܬ ܟ݄ܬ ܠܰܗ 22 ܐܳܬ̥ܘ̈ܳܬ̥ܳܐ ܕܟ݄ܬ ܢܶܝ ܝܕܺܝܥ̈ܶܐ ܒܽܗ̄ܘ ܕܽܘܡܝܰܢܳܐ܇ (ܐܰܒܓܰܕ ܗܰܘܰܙ ܚ݄ܛܺܝ ܟܰܠܰܡܰܢ ܣܰܥܦܰܨ ܩܰܪܫܰܬ).</span><br>
                                    <span>ܟܳܡ݄ܟܬ̥ܳܒ̥ܳܐ ܗ̄ܘܰܐ ܡܽܗ̄ܘ ܝܰܡܺܝܢܳܐ ܠܽܗ̄ܘ ܣܶܡܳܠܳܐ، ܡܫܰܡܰܗܬܳܐ ܗ̄ܘܰܐ ܒܺܗ̄ܝ ܦܫܺܝܛܽܘܬ̥ܳܐ ܘܺܗ̄ܝ ܦܫܺܝܩܽܘܬ̥ܳܐ ܕܽܗ̄ܘ ܬܽܘܠܺܝܦܰܝܕܰܗ.</span><br>
                                    <span>ܡܰܗ̄ܘܟ̥ܰܐ ܗܰܘܝܳܐ ܗ̄ܘܰܐ ܓ̥ܰܠܰܒܶܐ ܠܚܺܝܡܬܳܐ ܠܰܬܰܓܳܪ̈ܶܐ ܦܽܘܢܺܝܩ̈ܳܝܶܐ ܒܰܚܙܽܘ̈ܩܝܶܐ ܒܽܗ̄ܘ ܕܰܪܒܳܐ ܕܽܗ̄ܘ ܣܦܳܪܝܰܡܳܐ ܕܽܗ̄ܘ ܝܰܡܳܐ ܡܶܨܥܳܝܳܐ.</span><br>
                                    <span>ܗ̄ܺܝ ܐܳܠܰܦܒܶܝܬ ܗ̄ܰܬ̥ܶܐ ܠܰܝ̱ܬ ܗ̄ܘܰܐ ܐܳܬ̥ܘ̈ܳܬ̥ܳܐ ܒܰܠܚܽܘܕ، ܐܶܠܳܐ ܛܶܟܣܳܐ ܡܶܢܝܳܢܳܝܳܐ ܟܰܡܺܝܠܳܐ ܘܓܡܺܝܪܳܐ. ܟ݄ܡܚܰܫܚܺܝ ܠ݄ܗ̄ܢ ܗ̄ܘܰܘ ܐܟ̥ ܕܡܶܢܝܳܢ̈ܶܐ ܒܕܰܖ̈ܒܳܢܶܐ ܡܫܰܚܠܦ̈ܶܐ܇ ܗ̄ܰܢܶܩܫ̈ܶܐ ܬܰܓܳܪ̈ܳܝܶܐ، ܟܰܝ̈ܠܶܐ، ܘܰܙّܰܒܢ̈ܶܐ، ܘܰܚّܽܘܫܒܳܢ̈ܶܐ ܕܽܗ̄ܘ ܗܰܠܟ̥ܳܐ ܕܰܟܘܟܒ̥̈ܶܐ، ܘܺܗ̄ܝ ܡܕܰܒܪܳܢܘܬ̥ܳܐ ܘܽܗ̄ܘ ܡܰܗܒ̥ܳܐ ܘܽܗ̄ܘ ܫܩܳܠܳܐ.</span><br>
                                    <span>ܘܥܰܡ ܗ̄ܽܘ ܪܘܳܚܳܐ ܕܺܗ̄ܝ ܬܰܓܳܪܽܘܬ̥ܳܐ ܡܰܛܝܳܐ ܗ̄ܘܰܐ ܗ̄ܺܝ ܐܳܠܰܦܒܶܝܬ ܦܽܘܢܺܝܩܳܝܬܳܐ ܠܰܝܰܘܢܳܝ̈ܶܐ ܒܽܗ̄ܘ ܕܳܪܳܐ ܕܰܬܡܰܢܝܳܐ ܡܶܩ݄ܕ̱ܡ ܡܽܗ̄ܘ ܡܰܘܠܳܕܳܐ، ܘܬܰܡܳܐ ܣ݄ܡ ܠ݄ܗ̄ܢ ܫܽܘܚܠܳܦܳܐ ܫܶܪܫܳܝܳܐ ܕܡܰܘܙܰܕ ܠ݄ܗ̄ܢ ܗ̄ܰܙܰܘܥ̈ܶܐ، ܘܗܰܘܟ̥ܰܐ ܢܰܦܺܝܩܳܐ ܗ̄ܺܝ ܐܳܠܰܦܒܶܝܬ ܝܰܘܢܳܝܬܳܐ.</span><br>
                                    <span>ܘܥܰܠ ܗ̄ܽܘ ܕܰܪܒܳܐ ܕܝܰܘܢܳܝ̈ܶܐ ܡܰܛܝܳܐ ܠܰܪ̈ܽܘܗ̄ܡܳܝܶܐ، ܘܡܶܢ̱ ܬܰܡܳܐ ܢܰܦܺܝܩܳܐ ܗ̄ܺܝ ܐܳܠܰܦܒܶܝܬ ܠܰܬܺܝܢܳܝܬܳܐ ܕܦܰܝܺܝܫܳܐ ܡܚܰܫܰܚܬܳܐ ܡܶܢ̱ ܣܽܘܓ̥ܳܐܐ ܕܰܠܶܫܳܢ̈ܶܐ ܕܽܐܘܪܺܝܦܺܝ ܘܰܣܛܰܪ.</span><br>
                                    <span>ܗܺܝ ܐܳܠܰܦܒܶܝܬ ܝܳܘܢܳܝܬܳܐ ܟ݄ܬ ܗ̄ܘܰܝ ܠܰܗ ܒ݄ܬ̥ܪ ܡܰܥܒܕ̥ܳܢܽܘܬ̥ܳܐ ܥܰܠ ܗ̄ܽܘ ܢܦܳܩܳܐ ܕܺܗ̄ܝ ܐܳܠܰܦܒܶܝܬ ܟܺܝܪܺܝܠܰܝܬܳܐ ܒܽܗ̄ܘ ܡܰܕ݄ܢܚܳܐ ܕܽܐܘܪܺܝܦܺܝ ܘܪܽܘܣܝܰܐ.</span><br>
                                    <br>

                                    <span>ܘܒܽܗ̄ܘ ܡܰܕ݄ܢܚܳܐ، ܗ̄ܰܢ ܐܳܪ̈ܳܡܳܝܶܐ ܡ݄ܕ ܠ݄ܗ̄ܢ ܗ̄ܽܘ ܣܶܪܛܳܐ ܦܽܘܢܺܝܩܳܝܐ ܘ݄ܡܫܰܘܫܰܛ ܠ݄ܗ̄ܢ ܡܽܗ̄ܘ ܫܽܘܪܳܝܳܐ ܕܽܗ̄ܘ ܕܳܪܳܐ ܕܰܬܡܰܢܝܳܐ ܡܶܩ݄ܡ ܡܽܗ̄ܘ ܡܰܘܠܳܕܳܐ.</span><br>
                                    <span>ܘܗܰܘܝ ܠܚܺܝܡܳܐ ܙ݄ܕ ܕܡ݄ܟܬ̥ܽܒ̥ ܒܺܗ̄ܝ ܕܝܽܘܬ̥ܳܐ ܥܰܠ ܘܰܪܩܳܐ ܕܐܰܪܒܳܢܳܐ. ܘܗܰܘܟ̥ܰܐ ܗܰܘܝܳܐ ܗ̄ܺܝ ܟܬ̥ܰܒ̥ܬܳܐ ܐܳܪܳܡܳܝܬܳܐ ܐܟ̥ ܕܟܬ̥ܰܒ̥ܬܳܐ ܡܫܰܚܠܰܦܬܳܐ ܘܩܢܽܘܡܳܝܬܳܐ.</span><br>
                                    <span>ܘܥܰܠ ܕܡܺܝܕ ܗ̄ܽܘ ܐܳܪܳܡܳܝܳܐ ܐܟ̥ ܕܠܶܫܳܢܳܐ ܕܺܗ̄ܝ ܡܕܰܒܪܳܢܽܘܬ̥ܳܐ ܒܰܡܰܡܠܰܟ̥ܘ̈ܳܬ̥ܳܐ ܪ̈ܰܒܶܐ ܐܟ̥ ܕܰܗ̄ܢ ܐܳܬ̥ܽܘܪ̈ܳܝܶܐ ܘܕܰܒܳܒܠܳܝ̈ܶܐ ܘܒ݄ܬ̥ܪ ܕܰܗ̄ܢ ܐܰܟ̥ܡܺܝܢܳܝ̈ܶܐ ، ܗܰܘܶܝ ܗ̄ܘܰܐ ܗ̄ܽܘ ܠܶܫܳܢܳܐ ܐܳܪܳܡܳܝܳܐ ܠܶܫܳܢܳܐ ܬܺܒܶܝܠܳܝܳܐ ܦܪܺܝܣܳܐ ܒ݄ܪܘܳܚܳܐ ܒܽܗ̄ܘ ܡܰܕ݄ܢܚܳܐ ܥܰܬܺܝܩܳܐ.</span><br>
                                    <span>ܗܰܘܺܝ ܗ̄ܘܰܐ ܗ̄ܽܘ ܠܶܫܳܢܳܐ ܕܰܘܰܪ̈ܩܶܐ ܪ̈ܽܘܫܡܳܝܶܐ ܘܬܺܒܶܝܠܳܝ̈ܶܐ ܘܕܺܝܦ̥ܠܳܘ̈ܡܰܣܳܝܶܐ. ܟ݄ܝܬ ܗ̄ܘܰܝ ܠܶܗ ܕܰܘܪܳܐ ܪܰܒܳܐ ܒܽܗ̄ܘ ܕܳܪܳܐ ܩܰܕ̱ܡܳܝܳܐ ܕܡܶܩ݄ܡ ܡܽܗ̄ܘ ܡܰܘܠܳܕܳܐ.</span><br>
                                    <span>ܡܰܛܺܝ ܗ̇ܘܰܐ ܗܳܠ ܡܶܨܪܶܝܢ ܘ݄ܗܳܠ ܠܗ̄ܰܦܶܢܝܳܬ̈ܳܐ ܕܽܗ̄ܘ ܗܶܢܕܽܘ. ܥܰܠ ܗܰܘܟ̥ܰܐ ܚܫܺܝܒ̥ܳܐ ܗ̄ܘܰܐ ܗ̄ܽܘ ܠܶܫܳܢܳܐ ܬܺܒܶܝܠܳܝܳܐ ܕܽܗ̄ܘ ܙܰܒܢܰܘܳܐ.</span><br>
                                    <span>ܘܗ̄ܺܝ ܐܳܠܰܦܒܶܝܬ ܐܳܪܳܡܳܝܬܳܐ ܗܰܘܝܳܐ ܗ̄ܘܰܐ ܫܶܪܫܳܐ ܠܡܶܢܝܳܢܳܐ ܡܰܢ̱ ܛܶܟܣ̈ܶܐ ܡܫܰܚܠܦ̈ܶܐ ܕܺܗ̄ܝ ܟܬ̥ܰܒ̥ܬܳܐ، ܗ̄ܽܘ ܣܽܘܪܝܳܝܳܐ ܡܬܺܝܚܽܘܬ̥ܳܐ ܟܝܳܢܳܝܬܳܐ ܗ̄ܘܰܐ ܠܽܗ̄ܘ ܐܳܪܳܡܳܝܐ، ܘ݄ܕܡܶܢܶܗ ܢܰܦܺܝܩܳܐ ܗ̄ܺܝ ܐܳܠܰܦܒܶܝܬ ܢܰܒܰܛܳܝܬܳܐ ܕܡܶܢܰܗ ܢܰܦܺܝܩܳܐ ܗ̄ܺܝ ܥܰܪܰܒܳܝܬܳܐ، ܘܽܗ̄ܘ ܥܶܒܪܳܝܳܐ ܡܪܰܒܥܳܐ ܕܒ݄ܬ̥ܪ ܡܽܗ̄ܘ ܫܶܒܝܳܐ ܒܳܒܠܳܝܳܐ.</span><br>
                                    <span>ܬܽܘܒ ܟ݄ܝܬ ܗ̄ܘܰܝ ܠܰܗ ܡܰܥܒܕܳܢܽܘܬ̥ܳܐ ܥܰܠ ܛܶܟܣ̈ܶܐ ܚܪ̈ܶܝܢܶܐ ܣܬܶܝ ܒܺܐܝܪܰܢ ܘܰܐܣܺܝܰܐ ܡܶܨܥܳܝܬܶܐ.</span><br>
                                    <br>

                                    <span class="bold">ܡܶܢ ܐܳܠܦ (ܐ) ܘܒܶܝܬ (ܒ) ܠ Alphabet</span><br>
                                    <span>ܗ̄ܺܝ ܡܶܠܬ̥ܳܐ ܕ Alphabet ܕܟܳܡ݄ܬܚܰܫܚܳܐ ܒܣܽܘܓ̥ܳܐܐ ܕܰܠܶܫܳܢ̈ܶܐ ܐܽܘܪ̈ܺܝܦܳܝܶܐ، ܢܰܦܺܝܩܳܐ ܡܶܢ̱ ܬܪܶܝ ܡܶܠ̈ܶܐ ܝܰܘܢܳܝ̈ܶܐ Alpha ܘ Beta، ܕܗ݄ܢّܶܝ ܕܡܺܝܕܺܝ ܡܰܢ ܐܳܬ̥ܘ̈ܳܬ̥ܳܐ ܫܺܝܡܳܝ̈ܶܐ ܐܳܠܰܦ (ܐ) ܘܒܶܝܬ (ܒ)، ܘܗܰܘܟ̥ܰܐ ܦܰܝܺܝܫܳܐ ܗܺܝ ܡܰܥܒܕ̥ܳܢܽܘܬ̥ܳܐ ܕܺܗ̄ܝ ܐܳܬ̥ܽܘܬ̥ܳܐ ܟܢܰܥܢܳܝܬܳܐ ܡܛܰܝܰܒܬܳܐ ܒܐ݄ܫܡܶܗ ܕܽܗ̄ܘ ܛܶܟܣܳܐ ܕܺܗ̄ܝ ܟܬ̥ܰܒ̥ܬܳܐ ܗܳܠ ܐܰܕܝܰܘܡܰܐ.</span><br>
                                    <br>

                                    <span class="bold">ܚܽܘܬܳܡܳܐ</span><br>
                                    <span>ܐܽܘܓ̥ܰܪܝܬ ܓܠ݄ܦ ܠܰܗ ܗ̄ܺܝ ܐܳܠܰܦܒܶܝܬ ܥܰܬܺܝܩܬܳܐ ܘܟܰܡܺܝܠܬܐ ܘܰܓܡܝܪܬܐ ܒܽܗ̄ܘ ܥܳܠܡܳܐ، ܘܗܰܘܝܳܐ ܡܫܰܘܫܰܛܬܳܐ ܘ݄ܣܩܺܝܠܬܳܐ ܡܰܢ̱ ܦܽܘܢܺܝܩܳܝ̈ܶܐ ܕܡܰܚ݄ܬ ܠ݄ܗ̄ܢ ܗ̄ܺܝ ܫܶܬܶܐܣܬܳܐ ܠܣܽܘܓ̥ܳܐܐ ܕܰܗ̄ܢ ܐܰܒܓܰܕܳܝ̈ܘܳܬ̥ܳܐ ܒ݄ܒܪܺܝܬ̥ܳܐ، ܗܳܠ ܕܡܰܛܝܳܐ ܠܺܗ̄ܝ ܐܳܪܳܡܳܝܬܳܐ ܕܡ݄ܛܝܳܐ ܠܰܗ ܠܺܗ̄ܝ ܬܺܒܶܝܠܳܝܽܘܬ̥ܳܐ.</span><br>

